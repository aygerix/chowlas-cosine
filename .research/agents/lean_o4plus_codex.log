      have : (0 : ℝ) ≤ p := Nat.cast_nonneg p
      linarith
    · -- `c 0 = j ≠ 0`
      have hsplit : ∑ b : ZMod p, ∑ c' : ZMod p, ∑ e : ZMod p,
          (ψ (c 1 * b + c 2 * c' + c 3 * e) * (if c 0 = 0 then (p : ℂ) else 0) -
