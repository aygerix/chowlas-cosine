+            residual_max=float(np.max(np.where(macro,-np.inf,f)))
+            rows.append(dict(name=name,n=n,X=X,G=G,k=k,H=H,M_grid=gridM,M_local=float(-opt.fun),
+                R_grid=gridM/math.sqrt(n),height_condition=gridM<=math.sqrt(n)/k**2,
