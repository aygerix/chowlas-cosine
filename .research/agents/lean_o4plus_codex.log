+  have hz3 : z ^ 3 = 1 := by linear_combination (z - 1) * hz
+  have hzsum : 1 + (z + z ^ 2) = 0 := by linear_combination hz
+  have hzpow : (z ^ 2) ^ 3 = 1 := by rw [← pow_mul, mul_comm 2 3, pow_mul, hz3]; norm_num
+  have hzpair : (1 + z) ^ 3 = -1 := by
