+    OUT.mkdir(exist_ok=True)
+    write_json(OUT/f"metadata_{args.mode}.json",metadata(args))
+    {"suite":run_suite,"search":run_search,"levels":run_levels,"verify":lambda _:verify_saved(),
+     "audit":audit_threshold}[args.mode](args)
+
