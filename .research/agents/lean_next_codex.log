import ChowlaCosine.Basic

/-!
# Mean zero and Parseval for `f_A`

For a finite `A ⊆ ℕ` with all elements positive:

* `∫_0^{2π} f_A(x) dx = 0`;
* `∫_0^{2π} f_A(x)² dx = π |A|`, i.e. the normalized mean square
  `(1/2π) ∫_0^{2π} f_A² = |A| / 2`.

Distinctness of the frequencies is automatic (`A` is a `Finset`); positivity is required
(for `A = {0}` both identities fail).
-/

open Real

namespace ChowlaCosine

theorem intervalIntegrable_cos_mul (c : ℝ) (a b : ℝ) :
    IntervalIntegrable (fun x => Real.cos (c * x)) MeasureTheory.volume a b :=
  (by fun_prop : Continuous fun x => Real.cos (c * x)).intervalIntegrable _ _

/-- `∫_0^{2π} cos (a x) dx = 0` for a positive natural `a`. -/
theorem integral_cos_nat_mul {a : ℕ} (ha : 0 < a) :
    ∫ x in (0 : ℝ)..2 * π, Real.cos ((a : ℝ) * x) = 0 := by
  have h := integral_cos_int_mul (k := (a : ℤ)) (by exact_mod_cast ha.ne')
  simpa using h

/-- `∫_0^{2π} cos (a x) cos (b x) dx = π [a = b]` for positive naturals `a, b`. -/
theorem integral_cos_mul_cos_nat {a b : ℕ} (ha : 0 < a) (hb : 0 < b) :
    ∫ x in (0 : ℝ)..2 * π, Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x) =
      if a = b then π else 0 := by
  have h := integral_cos_mul_cos (a : ℤ) (b : ℤ) 0 0
  have hab : (a : ℤ) + b ≠ 0 := by omega
  rw [if_neg hab, add_zero] at h
  by_cases h' : a = b
  · have : (a : ℤ) - b = 0 := by omega
    rw [if_pos this] at h
    rw [if_pos h']
    simpa using h
  · have : (a : ℤ) - b ≠ 0 := by omega
    rw [if_neg this] at h
    rw [if_neg h']
    simpa using h

/-- **Mean zero.** `∫_0^{2π} f_A = 0` when every element of `A` is positive. -/
theorem integral_cosSum (A : Finset ℕ) (hA : ∀ a ∈ A, 0 < a) :
    ∫ x in (0 : ℝ)..2 * π, cosSum A x = 0 := by
  unfold cosSum
  rw [intervalIntegral.integral_finsetSum (fun (a : ℕ) _ => intervalIntegrable_cos_mul _ _ _)]
  exact Finset.sum_eq_zero (fun a ha => integral_cos_nat_mul (hA a ha))

/-- **Parseval.** `∫_0^{2π} f_A² = π |A|` when every element of `A` is positive. -/
theorem integral_cosSum_sq (A : Finset ℕ) (hA : ∀ a ∈ A, 0 < a) :
    ∫ x in (0 : ℝ)..2 * π, (cosSum A x) ^ 2 = π * A.card := by
  have hsq : ∀ x, (cosSum A x) ^ 2 =
      ∑ a ∈ A, ∑ b ∈ A, Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x) := by
    intro x
    rw [cosSum, sq, Finset.sum_mul_sum]
  simp_rw [hsq]
  have hint : ∀ a b : ℕ, IntervalIntegrable
      (fun x => Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x)) MeasureTheory.volume 0 (2 * π) :=
    fun a b => (by fun_prop : Continuous fun x =>
      Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x)).intervalIntegrable _ _
  rw [intervalIntegral.integral_finsetSum (fun (a : ℕ) _ =>
    (by fun_prop : Continuous fun x => ∑ b ∈ A,
      Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x)).intervalIntegrable _ _)]
  calc ∑ a ∈ A, ∫ x in (0 : ℝ)..2 * π, ∑ b ∈ A, Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x)
      = ∑ a ∈ A, ∑ b ∈ A, (if a = b then π else 0) := by
        refine Finset.sum_congr rfl (fun a ha => ?_)
        rw [intervalIntegral.integral_finsetSum (fun b _ => hint a b)]
        exact Finset.sum_congr rfl (fun b hb => integral_cos_mul_cos_nat (hA a ha) (hA b hb))
    _ = ∑ a ∈ A, π := by
        refine Finset.sum_congr rfl (fun a ha => ?_)
        simp [ha]
    _ = π * A.card := by
        rw [Finset.sum_const, nsmul_eq_mul, mul_comm]

/-- Normalized form of Parseval: `(1/2π) ∫_0^{2π} f_A² = |A| / 2`. -/
theorem normalized_mean_sq (A : Finset ℕ) (hA : ∀ a ∈ A, 0 < a) :
    (1 / (2 * π)) * ∫ x in (0 : ℝ)..2 * π, (cosSum A x) ^ 2 = (A.card : ℝ) / 2 := by
  rw [integral_cosSum_sq A hA]
  have := Real.pi_pos.ne'
  field_simp

end ChowlaCosine
import ChowlaCosine.P31.WindowMoments

/-!
# Averaging continuous windows on the full circle

These lemmas are independent of finite spectral factorization. In particular
there is no choice of factors under the integral.
-/

open Real MeasureTheory

namespace ChowlaCosine.P31

@[fun_prop] theorem continuous_circleMean_param {f : ℝ → ℝ → ℝ}
    (hf : Continuous (Function.uncurry f)) :
    Continuous (fun y => circleMean (f y)) := by
  unfold circleMean
  exact continuous_const.mul
    (intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hf _ _)

/-- Fubini on the actual square `[0,2π]²`; no finite sampling. -/
theorem circleMean_swap {f : ℝ → ℝ → ℝ}
    (hf : Continuous (Function.uncurry f)) :
    circleMean (fun y => circleMean (fun x => f y x)) =
      circleMean (fun x => circleMean (fun y => f y x)) := by
  have hT : (0 : ℝ) ≤ 2 * π := by positivity
  have hint : Integrable (Function.uncurry f)
      ((volume.restrict (Set.Ioc (0 : ℝ) (2 * π))).prod
        (volume.restrict (Set.Ioc (0 : ℝ) (2 * π)))) := by
    rw [Measure.prod_restrict]
    apply (hf.continuousOn.integrableOn_compact
      (isCompact_Icc.prod isCompact_Icc)).mono_set
    exact Set.prod_mono Set.Ioc_subset_Icc_self Set.Ioc_subset_Icc_self
  have hswap := integral_integral_swap hint
  simp only [circleMean, intervalIntegral.integral_const_mul]
  congr 1
  simp only [intervalIntegral.integral_of_le hT]
  exact congrArg (fun z : ℝ => (2 * π)⁻¹ * z) hswap

/-- Translation invariance, with the full real variable retained. -/
theorem circleMean_periodic_sub {f : ℝ → ℝ}
    (hf : Function.Periodic f (2 * π)) (y : ℝ) :
    circleMean (fun x => f (x - y)) = circleMean f := by
  unfold circleMean
  rw [intervalIntegral.integral_comp_sub_right]
  congr 1
  convert hf.intervalIntegral_add_eq (-y) 0 using 1 <;> congr 1 <;> ring

/-- Reflection followed by translation, needed when the window centre varies. -/
theorem circleMean_periodic_sub_left {f : ℝ → ℝ}
    (hf : Function.Periodic f (2 * π)) (y : ℝ) :
    circleMean (fun x => f (y - x)) = circleMean f := by
  unfold circleMean
  rw [intervalIntegral.integral_comp_sub_left]
  congr 1
  convert hf.intervalIntegral_add_eq (y - 2 * π) 0 using 1 <;> congr 1 <;> ring

/-- The averaged squared window is the product of its two exact moments. -/
theorem circleMean_window_sq {F g : ℝ → ℝ}
    (hF : Continuous F) (hg : Continuous g)
    (hperiod : Function.Periodic F (2 * π)) :
    circleMean (fun y => circleMean (fun x => (F (x - y) * g x) ^ 2)) =
      circleMean (fun x => F x ^ 2) * circleMean (fun x => g x ^ 2) := by
  rw [circleMean_swap (by fun_prop)]
  have hp : Function.Periodic (fun x => F x ^ 2) (2 * π) := by
    intro x
    change F (x + 2 * π) ^ 2 = F x ^ 2
    rw [hperiod x]
  have hinner : ∀ x, circleMean (fun y => (F (x - y) * g x) ^ 2) =
      circleMean (fun y => F y ^ 2) * g x ^ 2 := by
    intro x
    simp only [mul_pow]
    rw [circleMean_mul_const, circleMean_periodic_sub_left hp]
  simp_rw [hinner]
  exact circleMean_const_mul _ _

/-- Averaging any pointwise square/mean inequality. The hypothesis must
subsequently be obtained from spectral factorization and analytic Nikolskii. -/
theorem averaged_window_bound {F g : ℝ → ℝ} (C : ℝ)
    (hF : Continuous F) (hg : Continuous g)
    (hperiod : Function.Periodic F (2 * π))
    (hbound : ∀ y : ℝ, circleMean (fun x => (F (x - y) * g x) ^ 2) ≤
      C * circleMean (fun x => F (x - y) * g x) ^ 2) :
    circleMean (fun x => F x ^ 2) * circleMean (fun x => g x ^ 2) ≤
      C * circleMean (fun y => circleMean (fun x => F (x - y) * g x) ^ 2) := by
  rw [← circleMean_window_sq hF hg hperiod, ← circleMean_const_mul]
  apply circleMean_mono (continuous_circleMean_param (by fun_prop))
    (by fun_prop) hbound

end ChowlaCosine.P31
