noncomputable def kappa (w a : ℕ) : ℝ := max 0 (1 - (a : ℝ) / (w + 1))

def windowFreq (w : ℕ) : Finset ℕ := Finset.Icc 1 w

theorem windowFreq_pos (w : ℕ) : ∀ a ∈ windowFreq w, 0 < a := by
  intro a ha
  simp only [windowFreq, Finset.mem_Icc] at ha
  omega

