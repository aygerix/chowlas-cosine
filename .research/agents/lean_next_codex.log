    intro a ha
    rw [circleMean_sum A (fun d x => (b a * c d) *
      (Real.cos ((a : ℝ) * x) * Real.cos ((d : ℝ) * x)))
        (by intro d hd; fun_prop)]
    have hi : ∀ d ∈ A, circleMean (fun x => (b a * c d) *
        (Real.cos ((a : ℝ) * x) * Real.cos ((d : ℝ) * x))) =
