  have e4 : (ENNReal.ofReal (Real.sqrt (Real.pi / (4 / 3 : ℝ))) ''^ (1 / (4 / 3) : ℝ)) ''^ 4 =
      ENNReal.ofReal (Real.sqrt (Real.pi / (4 / 3 : ℝ))) ''^ 3 := by
