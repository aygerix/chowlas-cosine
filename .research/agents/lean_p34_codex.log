+  simp only [trigSum, mul_assoc, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
+    zero_mul, sub_zero]
+  ring
+
+theorem circleMean_window_mean_sq (w : ℕ) (A : Finset ℕ) (b : ℕ → ℂ) (M : ℝ)
+    (hA : ∀ j ∈ A, 0 < j) :
