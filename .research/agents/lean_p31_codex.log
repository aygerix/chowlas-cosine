            chunks.append('-- SOURCE ' + name + '\\n' + source)
        text = '\\n'.join(chunks)
        if text "'!= previous:
            work.write_text(text)
            version += 1
            uri = work.as_uri()
            if previous is None:
                send('"'textDocument/didOpen', {'textDocument':{
