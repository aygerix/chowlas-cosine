+        lines.append('| '+d['name']+' | '+str(d['n'])+' | '+' | '.join(f'{d[k]:.6g}' for k in keys)+' |')
+    (ROOT/'fourway_energy_tables.md').write_text('\n'.join(lines)+'\n')
