diff --git a/.research/agents/tdense15_scratch/proof_checks.py b/.research/agents/tdense15_scratch/proof_checks.py
new file mode 100644
index 0000000000000000000000000000000000000000..a8ec2a804f8a37dcdd714711040f84566e92c466
--- /dev/null
+++ b/.research/agents/tdense15_scratch/proof_checks.py
@@ -0,0 +1,73 @@
+"""Exact algebra/parity and adversarial checks for the round-15 lemmas. VM only."""
+from pathlib import Path
+from itertools import product
+import importlib.util, json, math
+import numpy as np
+import sympy as sp
+
+ROOT=Path(__file__).resolve().parent
+q,t,L,K,Lam=sp.symbols('q t L K Lam',positive=True)
+E=(q-1)*(Lam*(K-sp.Rational(1,2))+K/2-(q+1)/4)
+assert sp.expand(E.subs({K:t+sp.Rational(1,2),Lam:L-t-sp.Rational(1,2)})-(q-1)*(t*L-t*t-q/4))==0
+ineq=sp.expand(q*t*t*(t*t-sp.Rational(1,4))-(t*t+q/4)**2)
+assert sp.expand(ineq-((q-1)*t**4-sp.Rational(3,4)*q*t*t-q*q/16))==0
+parity_sets=0
+for p in (5,13,17):
+    half=(p-1)//2
+    for flags in product((0,1),repeat=half):
+        D={a for j,z in enumerate(flags) if z for a in (j+1,p-j-1)}
+        if not D or len(D)==p-1:continue
+        reps=[sum((xi-a)%p in D for a in D) for xi in range(p)]
+        assert reps[0]==len(D)
+        assert all(reps[xi]%2==int((xi*pow(2,-1,p))%p in D) for xi in range(1,p))
+        assert max(reps[1:])-min(reps[1:])>=1
+        parity_sets+=1
+
+records=json.loads(ROOT.joinpath('stability_probe.json').read_text())['records']
+checks=[]
+for r in records:
+    if not r['is_exact_halfset'] or not r['pairs']:continue
+    p=r['q'];b=np.zeros(p);pp=r['pairs'];b[pp]=1;b[[p-a for a in pp]]=1
+    F=np.fft.fft(b).real;F[0]=0
+    k=-min(F[1:]);la=max(F[1:]);ll=k+la;tt=k-.5
+    h=F+k;h[0]=tt
+    A=h>=ll/2;A[0]=False;s=int(sum(A))
+    ee=float(sum((la-F[1:])*(F[1:]+k)))
+    W=ee+tt*tt
+    V=p*p/4+p*k*(k-1)
+    assert abs(ll*math.sqrt(s)-math.sqrt(V))<=math.sqrt(max(0,W))+1e-7*p
+    if 0<s<p-1:
+        parity_lb=ll*ll/(4*(math.sqrt(s+.5)+math.sqrt(s))**2)
+        assert W>=parity_lb-1e-6*p*p
+    else:parity_lb=None
+    rr=dict(name=r['name'],q=p,core=s,W=W,parity_lower_bound=parity_lb)
+    if la>k:
+        P=np.maximum(F,0);N=np.maximum(-F,0)
+        assert sum((P-la*A)**2)<=ee+1e-6*p*p
+        DN=k*k*(s+1)+3*k*ee/la
+        assert sum((N-k)**2)<=DN+1e-6*p*p
+        R=math.sqrt(max(0,DN)/(p*(p-1)))+1/(2*p)
+        pi=np.fft.ifft(P).real
+        actual=math.sqrt(float(np.mean((pi[1:]-(b[1:]-.5))**2)))
+        assert actual<=R+1e-8
+        coeff=np.fft.ifft(np.fft.fft(P)**2).real/p**2
+        err=max(abs(coeff[1:]-(pi[0]**2-.25)/p))
+        assert err<=(p-1)/p*(R+R*R)+1e-8
+        for eta in (.1,.5):
+            bad=sum(N[1:]<(1-eta)*k-1e-7)
+            assert bad<=s+ee/(la*eta*k)+2*ee/(k*ll)+1e-6*p
+        rr.update(negative_L2_bound=DN,flat_rms_bound=R,flat_rms_actual=actual,
+                  square_fourier_error=err)
+    checks.append(rr)
+
+spec=importlib.util.spec_from_file_location('old_barrier','.research/agents/tdense13_scratch/barrier_check.py')
+old=importlib.util.module_from_spec(spec);spec.loader.exec_module(old)
+old.ROOT=ROOT
+partial=old.barrier(201**3,3)
+out=dict(status='PROVED exact algebra and finite parity; NUMERICAL stability checks; Arb prior-fake checks',
+         exact_parity_sets=parity_sets,stability_checks=checks,
+         R13_partial_fake=partial,
+         note='201^3 is an odd composite index size for this exact construction check, not a prime half-set.')
+ROOT.joinpath('proof_checks.json').write_text(json.dumps(out,indent=2))
+print('EXACT_PARITY_SETS',parity_sets,'NUMERICAL_STABILITY_CASES',len(checks))
+print('R13_PARTIAL_FAKE',json.dumps(partial))
diff --git a/.research/agents/tdense15_scratch/stability_probe.py b/.research/agents/tdense15_scratch/stability_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..4758060105796ea83253f21e7d0d70580cd5b6c1
--- /dev/null
+++ b/.research/agents/tdense15_scratch/stability_probe.py
@@ -0,0 +1,144 @@
+"""Round 15 adversarial stability measurements; VM only, no optimizer.
+
+Integer pair lists specify the sets exactly. Floating measurements are NUMERICAL.
+Arb balls independently enclose spectra of the selected small-q sets only.
+Exhaustive floating enumeration is used only to select candidates, not as a proof.
+"""
+from pathlib import Path
+from itertools import combinations
+import json, math, re, platform
+import numpy as np
+from flint import arb, ctx
+
+ROOT=Path(__file__).resolve().parent
+ctx.prec=180
+
+def metrics(b, name, pairs=None, enclose=False, boolean=True):
+    q=len(b); alpha=float(np.mean(b)); F=np.fft.fft(b).real
+    v=F.copy();v[0]=0
+    K=float(-min(v[1:]));Lam=float(max(v[1:]));a=int(np.argmax(v[1:])+1)
+    P=np.maximum(v,0);N=np.maximum(-v,0)
+    pi=np.fft.ifft(P).real;ni=np.fft.ifft(N).real
+    S=float(sum(P));C=q*K*(K-1);L=Lam+K;t=K-.5
+    h=v+K;h[0]=t
+    conv=np.fft.ifft(np.fft.fft(h)**2).real
+    E=float(np.sum((Lam-v[1:])*(v[1:]+K)))
+    core=(h>=L/2);core[0]=False
+    r=dict(status='NUMERICAL',name=name,q=q,density=alpha,
+           is_exact_halfset=bool(boolean and b[0]==0 and 2*sum(b)==q-1),
+           K=K,Lambda=Lam,K_over_qquarter=K/q**.25,
+           LambdaK_over_q=Lam*K/q,positive_count=int(sum(P>1e-8)),
+           positive_effective_support=S*S/float(sum(P*P)),
+           positive_core_count=int(sum(core)),predicted_4K2=4*K*K,
+           negative_10pct_fraction=float(np.mean(N[1:]>=.9*K)),
+           negative_saturation=float(sum(N)/(K*(q-1))),
+           negative_zero_spike_fraction=float(ni[0]**2/sum(ni*ni)),
+           positive_flat_rms=float(np.sqrt(np.mean((pi[1:]-(b[1:]-.5))**2))),
+           positive_square_flat_rms=float(np.sqrt(np.mean((pi[1:]**2-.25)**2))),
+           second_order_peak_ratio=L*L/C if C>0 else None,
+           local_defect=1-L*L/C if C>0 else None,
+           endpoint_defect=E,endpoint_defect_over_q2=E/q**2,
+           boolean_square_error=float(np.max(np.abs((2*b-1)**2-1))),
+           pairs=pairs)
+    if r['is_exact_halfset']:
+        target=np.full(q,C);target[0]+=q*q/4
+        err=float(max(abs(conv-target))/max(1,C))
+        assert err<1e-8,(name,err)
+        assert L*L<=C*(1+1e-8)
+        assert E>=-1e-6*q*q
+        z=L*core
+        assert sum((h-z)**2)<=E+t*t+1e-7*q*q
+        assert abs(sum(h)-q*t)<1e-7*q*max(1,K)
+        r['shifted_convolution_relative_error']=err
+        r['peak_equation_residual']=(C-L*L-2*t*h[(2*a)%q])
+        r['endpoint_defect_formula_error']=E-(q-1)*(Lam*(K-.5)+K/2-(q+1)/4)
+        r['rounding_L2_bound']=E+t*t
+        r['rounding_L2_actual']=float(sum((h-z)**2))
+    if enclose:
+        vals=[]
+        for g in range(1,(q+1)//2):
+            vals.append(sum((2*(2*arb.pi()*((g*x)%q)/q).cos() for x in pairs),arb(0)))
+        imin=min(range(len(vals)),key=lambda i:float(vals[i].mid()))
+        imax=max(range(len(vals)),key=lambda i:float(vals[i].mid()))
+        r['Arb_K_ball']=str(-vals[imin]);r['Arb_Lambda_ball']=str(vals[imax]);r['Arb_bits']=ctx.prec
+        assert abs(K-float((-vals[imin]).mid()))<1e-10
+        assert abs(Lam-float(vals[imax].mid()))<1e-10
+    return r
+
+def array(q,pairs):
+    b=np.zeros(q);b[pairs]=1;b[[q-x for x in pairs]]=1
+    return b
+
+out=[]
+for q in (5,13,17,29,37):
+    h=(q-1)//2;m=(q-1)//4
+    A=2*np.cos(2*np.pi*np.outer(np.arange(1,h+1),np.arange(1,h+1))/q)
+    best=math.inf;bp=None;tested=0
+    for pp in combinations(range(1,h+1),m):
+        k=-min(A[:,np.array(pp)-1].sum(axis=1));tested+=1
+        if k<best:best=k;bp=list(pp)
+    r=metrics(array(q,bp),'small_enumeration_candidate',bp,True)
+    r['enumerated_sets']=tested;out.append(r)
+
+stored={}
+for fn in Path('examples/zp_half').glob('*.txt'):
+    for line in fn.read_text().splitlines():
+        mm=re.search(r'p=(\d+).*?P=([\d ]+)',line)
+        if not mm:continue
+        q=int(mm[1]);pp=list(map(int,mm[2].split()))
+        if q%4==1 and q in (41,53,61,73,89,97,101) and len(pp)==(q-1)//4:
+            stored[q]=pp
+for q,pp in sorted(stored.items()):out.append(metrics(array(q,pp),'E41_stored',pp,True))
+
+stored={}
+for line in Path('examples/e90/prod.txt').read_text().splitlines():
+    mm=re.search(r'q=(\d+).*?bestK=([\d.]+).*?P=([\d ]+)',line)
+    if not mm:continue
+    q=int(mm[1]);k=float(mm[2]);pp=list(map(int,mm[3].split()))
+    if q in (149,401,601,1201,1601) and q%4==1 and len(pp)==(q-1)//4:
+        if q not in stored or k<stored[q][0]:stored[q]=(k,pp)
+for q,(k,pp) in sorted(stored.items()):out.append(metrics(array(q,pp),'E90_stored_candidate',pp))
+
+for q in (257,4093,65537):
+    pp=sorted({(a*a)%q for a in range(1,q) if (a*a)%q<=q//2})
+    out.append(metrics(array(q,pp),'Paley',pp))
+
+rng=np.random.default_rng(151019)
+def repair(b):
+    q=len(b);m=(q-1)//4;pp=np.flatnonzero(b[1:(q+1)//2]>.5)+1
+    if len(pp)>m:
+        remove=rng.choice(pp,len(pp)-m,replace=False);b[remove]=0;b[q-remove]=0
+    elif len(pp)<m:
+        avail=np.flatnonzero(b[1:(q+1)//2]<.5)+1
+        add=rng.choice(avail,m-len(pp),replace=False);b[add]=1;b[q-add]=1
+    return b
+for q in (4093,65537):
+    x=np.arange(1,(q+1)//2)
+    pp=x[rng.random(len(x))<.5+.2*np.cos(2*np.pi*x/q)]
+    out.append(metrics(repair(array(q,pp.tolist())),'R13_PK_random_profile'))
+    alpha=1-1/math.sqrt(2)
+    pp=x[rng.random(len(x))<alpha+.1*np.cos(2*np.pi*x/q)]
+    base=array(q,pp.tolist());union=np.maximum(base,base[(3*np.arange(q))%q])
+    out.append(metrics(repair(union),'R14_UNION_repaired_halfset'))
+
+# Non-Boolean R12-S fake, with its exact defining scalar formulas.
+q=1000033;u=q**(1/3);h0=u-1
+T=q*(u-1);Energy=q*q+q*u*(u-2)
+Tp=T-h0;Ep=Energy-h0*h0
+m=4*math.ceil(Tp*Tp/(4*Ep));mean=Tp/m;var=Ep/m-mean*mean
+fake=np.zeros(q);fake[0]=h0
+for j in range(m//2):
+    a=j+1;fake[a]=fake[q-a]=mean+(1 if j<m//4 else -1)*math.sqrt(var)
+sign=np.fft.ifft(fake-u).real
+b=(sign+1)/2
+r=metrics(b,'R12_S_nonboolean',boolean=False)
+r['raw_scalar_mass_error']=float(sum(fake)-T)
+r['raw_scalar_energy_relative_error']=float((sum(fake*fake)-Energy)/Energy)
+out.append(r)
+
+result=dict(status='NUMERICAL',python=platform.python_version(),numpy=np.__version__,seed=151019,records=out)
+ROOT.joinpath('stability_probe.json').write_text(json.dumps(result,indent=2))
+for r in out:
+    print(r['name'],r['q'],'K',round(r['K'],6),'Lambda',round(r['Lambda'],6),
+          'Pi',r['positive_count'],'N90',round(r['negative_10pct_fraction'],4),
+          'flat',round(r['positive_flat_rms'],6),'peak_ratio',r['second_order_peak_ratio'],flush=True)
diff --git a/.research/agents/tdense15_scratch/support_counterexample.py b/.research/agents/tdense15_scratch/support_counterexample.py
new file mode 100644
index 0000000000000000000000000000000000000000..88fece7e83ba04ca1f82032efbbac5acb17841f0
--- /dev/null
+++ b/.research/agents/tdense15_scratch/support_counterexample.py
@@ -0,0 +1,36 @@
+"""VM-only exact/Arb scalar counterexample to unthresholded support stability."""
+from pathlib import Path
+from fractions import Fraction as Q
+from math import ceil
+import json
+import sympy as sp
+from flint import arb,ctx
+ctx.prec=220
+ROOT=Path(__file__).resolve().parent
+q=1000033
+assert sp.isprime(q) and q%4==1
+k=Q(32);t=k-Q(1,2);r=30000;eps=Q(1,q)
+mass=(q-1)*t-r*(k+eps)
+energy=(q-1)*(t*t+Q(q,4))-r*(k+eps)**2
+s=4*ceil(mass*mass/(4*energy))
+mean=mass/s;var=energy/s-mean*mean
+assert 0<=var<mean*mean and s%4==r%4==0 and 2*(s+r)<q-1
+def ball(x):return arb(x.numerator)/x.denominator
+hi=ball(mean)+ball(var).sqrt();lo=ball(mean)-ball(var).sqrt()
+assert (lo-ball(k+eps)).lower()>0
+Lam=hi-ball(k)
+E=(q-1)*(ball(t)*hi-ball(t*t+Q(q,4)))
+C=ball(q*k*(k-1))
+assert (C-hi*hi).lower()>0
+assert (s*ball(mean)+r*ball(k+eps)-ball((q-1)*t)).contains(0)
+assert (s*(ball(mean)**2+ball(var))+r*ball(k+eps)**2-ball((q-1)*(t*t+Q(q,4)))).contains(0)
+out=dict(status='PROVED finite scalar counterexample, exact rational formulas and Arb enclosures',
+         q=q,prime=True,K=str(k),weak_positive_modes=r,core_modes=s,total_positive_modes=r+s,
+         epsilon=str(eps),core_h_mean=str(mean),core_h_variance=str(var),
+         core_h_high=str(hi),core_h_low=str(lo),LambdaK_over_q_ball=str(Lam*ball(k)/q),
+         E_over_q2_ball=str(E/(q*q)),
+         omitted_frequency=(q-1)//2,convolution_at_omitted_frequency=0,
+         required_convolution=str(q*k*(k-1)),
+         assignment='core on +/-[1,s/2], high on first s/4 pairs; weak positive eigenvalues on next r/2 pairs; all other nonzero eigenvalues -K; h(0)=K-1/2')
+ROOT.joinpath('support_counterexample.json').write_text(json.dumps(out,indent=2))
+print(json.dumps(out,indent=2))
diff --git a/.research/agents/tdense15_scratch/verify_sigma.py b/.research/agents/tdense15_scratch/verify_sigma.py
