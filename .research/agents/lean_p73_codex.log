+  exact ChowlaCosine.FewSpike.fewSpike_core S hS φ ⟨hpd.1, hpd.2⟩ δ hδ hpeak
+
+example (S : Finset ℤ) (hS : S.Nonempty) (φ : ℤ → ℂ)
+    (hpd : (∀ (W : Finset ℤ) (c : ℤ → ℂ),
+      0 ≤ (∑ k ∈ W, ∑ l ∈ W, c k * conj (c l) * φ (k - l)).re) ∧
+      (∀ k, φ (-k) = conj (φ k)))
