+SUPPORT=json.load(open(OUT/'support_lines.json')) if (OUT/'support_lines.json').exists() else {}
+def brow(x,m):
+    return np.array([comb(m,k)*x**k*(1-x)**(m-k) for k in range(m+1)])
+def run(K=64,deg=10,shape=.2,triple=0):
