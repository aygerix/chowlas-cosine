new file mode 100644
index 0000000000000000000000000000000000000000..987c94517408c3b7ad2fa4a7ae5320965c8cd762
--- /dev/null
+++ b/.research/agents/tdense11_scratch/discover.py
@@ -0,0 +1,69 @@
+"""R11 support-coupled discovery. VM only; every optimization uses Gurobi."""
+import json, sys, math, time
+from pathlib import Path
+from fractions import Fraction as Q
+from math import comb
+import numpy as np
+import gurobipy as gp
+OUT=Path('.research/agents/tdense11_scratch')
+LINES=json.load(open('.research/agents/tdense9_scratch/long_gram_bounds.json'))
+SUPPORT=json.load(open(OUT/'support_lines.json')) if (OUT/'support_lines.json').exists() else {}
+def brow(x,m):
+    return np.array([comb(m,k)*x**k*(1-x)**(m-k) for k in range(m+1)])
+def run(K=64,deg=10,shape=.2,triple=0):
+    started=time.time(); model=gp.Model(); model.Params.Threads=4
+    model.Params.FeasibilityTol=1e-9; model.Params.OptimalityTol=1e-9
+    model.Params.Method=2; model.Params.Crossover=0
+    aa=model.addVars(K,lb=0,ub=2); bb=model.addVars(K,deg+1,lb=0,ub=10)
+    cc=model.addVars(K,deg+1,lb=0,ub=10) if triple else None
+    D=model.addVar(lb=0)
+    for j in range(K):
+        for vv in ([bb,cc] if triple else [bb]):
+            model.addConstr(vv[j,0]==0)
+            for i in range(deg):model.addConstr(vv[j,i+1]>=vv[j,i])
+    # Include every line/Gram branch crossover in the discovery grid.
+    xs=np.unique(np.r_[np.linspace(1e-7,1,600),1-np.geomspace(1e-10,.01,40),np.geomspace(1e-9,.001,20)])
+    slopes=[float(Q(r['m'])) for r in LINES]; intercepts=[float(Q(r['b'])) for r in LINES]
+    for i in range(len(slopes)):
+        for j in range(i):
+            if slopes[i]!=slopes[j]:
+                x=(intercepts[j]-intercepts[i])/(slopes[i]-slopes[j])
+                if 0<x<1:xs=np.r_[xs,x]
+    xs=np.unique(np.r_[xs,(math.sqrt(5)-1)/2,1/math.sqrt(2)])
+    splits=6 if triple else 2
+    for jj in range(splits*K):
+        j=jj//splits; tlo=jj/(splits*K)
+        k=math.ceil(splits*K/jj)-1 if jj else 10**9
+        cap=np.cos(np.pi/(k+2)) if jj else 1.
+        xx=np.unique(np.r_[xs[xs<=cap],cap])
+        extra=SUPPORT.get(str(k),[])
+        for rr in extra:
+            mm,bc=float(Q(rr['m'])),float(Q(rr['b']))
+            for m,b in zip([0]+slopes,[0]+intercepts):
+                if mm!=m:
+                    cross=(b-bc)/(mm-m)
+                    if 0<cross<cap:xx=np.r_[xx,cross]
+        for x in xx:
+            y=max([0,2*x*x-1,x-math.sqrt(max(0,1-x))]+[m*x+b for m,b in zip(slopes,intercepts)]+[float(Q(r['m']))*x+float(Q(r['b'])) for r in extra])
+            z=max(0,4*x**3-3*x)
+            bx=brow(x,deg)/x; by=brow(y,deg)/x; bz=brow(z,deg)/x
+            val=x/(2*(1+math.sqrt(max(0,1-x*x))))
+            expr=aa[j]-val-gp.quicksum(float(bx[i])*(bb[j,i]/2+(cc[j,i]/3 if triple else 0)) for i in range(deg+1))
+            child2=jj*2//splits; child3=jj*3//splits
+            if child2<K:expr+=gp.quicksum(float(by[i])*bb[child2,i] for i in range(deg+1))
+            if triple and child3<K:expr+=gp.quicksum(float(bz[i])*cc[child3,i] for i in range(deg+1))
+            model.addConstr(expr>=0)
+    # Exact (up to floats) row integrals of quadratic U, no quadrature error.
+    U=lambda x:1+shape*4*x*(1-x)
+    V=lambda x:x+2*shape*x*x-4*shape*x**3/3
+    clip=lambda x:np.clip(x,0,1)
+    ss=np.linspace(0,1,1001)
+    weights=np.array([(V(clip(ss-j/K))-V(clip(ss-(j+1)/K))+V(clip(ss+(j+1)/K))-V(clip(ss+j/K)))/U(ss) for j in range(K)]).T
+    for row in weights:model.addConstr(gp.quicksum(float(row[j])*aa[j] for j in range(K))<=2*D)
+    model.setObjective(D,gp.GRB.MINIMIZE); model.optimize(); assert model.SolCount
+    rec=dict(K=K,degree=deg,shape=shape,triple=triple,D=D.X,C=1/D.X,a=[aa[j].X for j in range(K)],beta=[[bb[j,i].X for i in range(deg+1)] for j in range(K)],seconds=time.time()-started)
+    if triple:rec['gamma']=[[cc[j,i].X for i in range(deg+1)] for j in range(K)]
+    name=f'discovery_K{K}_d{deg}_s{shape}_t{triple}'+('_support' if SUPPORT else '')+'.json'
+    OUT.joinpath(name).write_text(json.dumps(rec,indent=2))
+    print('DISCOVERY_RESULT',json.dumps({k:v for k,v in rec.items() if k not in ('a','beta','gamma')}),flush=True)
+if __name__=='__main__':run(int(sys.argv[1]),int(sys.argv[2]),float(sys.argv[3]),int(sys.argv[4]))
diff --git a/.research/agents/tdense11_scratch/final_check.py b/.research/agents/tdense11_scratch/final_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..0010300bbd697a89fa5396bb21824391e1844170
--- /dev/null
+++ b/.research/agents/tdense11_scratch/final_check.py
@@ -0,0 +1,49 @@
+"""R11 independent algebra, saved point recertification, and reproducibility manifest.
+VM only. No optimizers are called by this verifier.
+"""
+import ast,hashlib,json,math,platform
+from pathlib import Path
+from fractions import Fraction as Q
+import sympy as sp
+from flint import arb,ctx
+OUT=Path('.research/agents/tdense11_scratch')
+def main():
+    ctx.prec=220
+    for path in OUT.glob('*.py'):ast.parse(path.read_text())
+    c=json.load(open(OUT/'certificate_td.json'));v=json.load(open(OUT/'independent_verification.json'))
+    assert c['status']==v['status']=='PROVED' and Q(c['D1'])==Q(259,2000)
+    assert not c['failed'] and v['schur_cells']==192
+    assert v['sha256']['certificate_td.json']==hashlib.sha256((OUT/'certificate_td.json').read_bytes()).hexdigest()
+    p,z=sp.symbols('p z',real=True);e=p*(1-p)
+    assert sp.expand(p**3+3*p*e+e*(1-2*p)-p)==0
+    assert sp.expand(p**4+6*p*p*e+3*e*e-(3*p*p-2*p**4))==0
+    assert sp.expand(e*(1-3*e)-(p*(1-p)**4+(1-p)*p**4))==0
+    assert sp.expand(z*z*(z-1)**2-(z**4-2*z**3+z*z))==0
+    # Exact exponent inequalities for the actual-DC three-profile escape.
+    assert Q(11,30)<Q(9,20)<Q(7,15)<Q(1,2)
+    assert 1-3*Q(9,20)==Q(-7,20)
+    assert Q(1,5)+3*(Q(4,15)-Q(9,20))==Q(-7,20)
+    assert Q(4,15)-Q(9,20)<0
+    d=(1-arb.pi()/4)/2;S=arb.pi()/64;F=arb(67)/120-5*arb.pi()/32
+    energy=S*S/(d.sqrt()+(d*F).sqrt().sqrt()+F.sqrt())**2
+    assert energy>arb(3)/1000
+    probes=json.load(open(OUT/'fourth_probe.json'));checks=[]
+    for row in probes['rows']:
+        if row['family']!='random':continue
+        cpt=row['rounded'];A=[int(k) for k in (OUT/cpt['file']).read_text().split()]
+        assert len(A)==len(set(A))==cpt['n'] and min(A)>0 and max(A)==cpt['X']
+        ff=row['fft']
+        # Parse the exact rational angle from the saved certificate, not the weighted FFT angle.
+        pieces=cpt['angle'].split('*');index,grid=map(int,pieces[-1].split('/'))
+        angle=2*arb.pi()*index/grid;value=sum(((k*angle).cos() for k in A),arb(0))
+        R=Q(cpt['R_lower']);assert value<-arb(len(A)).sqrt()*arb(R.numerator)/R.denominator
+        checks.append(dict(file=cpt['file'],n=len(A),value_ball=str(value),R_lower=str(R)))
+    files=list(OUT.glob('*.py'))+list(OUT.glob('*.json'))+list(OUT.glob('*.txt'))
+    hashes={path.name:hashlib.sha256(path.read_bytes()).hexdigest() for path in sorted(files) if path.name not in ('manifest.json','final_checks.json')}
+    result=dict(status='PROVED_CHECKS',python=platform.python_version(),fourth_and_cubic_identities=True,D1='259/2000',C11='2000/259',
+       triangular=dict(d=str(d),S=str(S),F=str(F),repair_energy_lower_bound=str(energy)),binary_points=checks,
+       actual_DC_exponent_checks=True,source_and_data_sha256=hashes)
+    OUT.joinpath('final_checks.json').write_text(json.dumps(result,indent=2))
+    OUT.joinpath('manifest.json').write_text(json.dumps(dict(files=hashes,python=platform.python_version(),constraint='All mathematical computation via specified dirun VM; <=4 cores; Gurobi for optimization'),indent=2))
+    print(json.dumps({k:v for k,v in result.items() if k!='source_and_data_sha256'},indent=2),flush=True)
+if __name__=='__main__':main()
