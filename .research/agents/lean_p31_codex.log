theorem hasDerivAt_gaussian (a x : ℝ) :
    HasDerivAt (gaussian a) ((-2 * a * x) * gaussian a x) x := by
  have H := (((hasDerivAt_id x).pow 2).const_mul (-a)).exp
  convert H using 1 <;> simp only [gaussian, id_eq] <;> ring

end ChowlaCosine.Beckner

