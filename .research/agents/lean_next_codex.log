      intro d hd
      rw [circleMean_const_mul, circleMean_cos_mul_cos (hA a ha) (hA d hd)]
      split_ifs <;> ring
    rw [Finset.sum_congr rfl hi]
    simp [ha]
  rw [Finset.sum_congr rfl hs, Finset.sum_div]

