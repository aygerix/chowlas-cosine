+        G=1<<math.ceil(math.log2(128*X)); seq=np.zeros(G); seq[A]=1
+        F=np.fft.fft(seq); f=F.real; gridM=float(-f.min()); p=n/X
+        idx=int(np.argmin(f)); x0=2*np.pi*idx/G
