+        print('SUPPORT_LINES',k,'count',len(rr),'at_0.6',max(float(Q(r['m']))*.6+float(Q(r['b'])) for r in rr),flush=True)
+    OUT.joinpath('support_lines.json').write_text(json.dumps(records,indent=2))
