+        recs.append(rec)
+        print(json.dumps(dict(name=name,n=rec['n'],objective=rec['objective'],certs=rec['certs'])),flush=True)
+        (ROOT/'fourway_extras.json').write_text(json.dumps(recs,indent=2)+'\n')
+    seedrecs=json.load(open(ROOT/'fourway_seeds.json'))
