@Beckner.tendsto_integral_geometricHeatProduct : ∀ {ι : Type u_1} {E : Type u_2} [inst : Fintype ι]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℝ E] (f : ι → ℝ → ℝ) (c : ι → ℝ) (u : ι → E),
  (∀ (i : ι), MeasureTheory.Integrable (f i) MeasureTheory.volume) →
    (∀ (i : ι) (y : ℝ), 0 ≤ f i y) →
      (∀ (i : ι), 0 ≤ c i) →
        (∀ (i : ι), ‖u i‖ = 1) →
          Beckner.IsWeightedFrame c u →
            ∀ (R : ℝ),
              0 ≤ R →
                (∀ (i : ι) (y : ℝ), f i y ≠ 0 → |y| ≤ R) →
                  ∀ (b : OrthonormalBasis (Fin 2) ℝ E),
                    Filter.Tendsto
                      (fun t =>
                        ∫ (z : ℝ × ℝ),
                          Beckner.geometricHeatProduct f c u t
                            (Beckner.planePoint b z) ∂MeasureTheory.volume.prod MeasureTheory.volume)
                      Filter.atTop (nhds (∏ i, (∫ (y : ℝ), f i y) ^ c i))
@Beckner.geometric_brascamp_lieb : ∀ {ι : Type u_1} {E : Type u_2} [inst : Fintype ι] [inst_1 : NormedAddCommGroup E]
  [inst_2 : InnerProductSpace ℝ E] (f : ι → ℝ → ℝ) (c : ι → ℝ) (u : ι → E),
  (∀ (i : ι), MeasureTheory.Integrable (f i) MeasureTheory.volume) →
    (∀ (i : ι) (y : ℝ), 0 ≤ f i y) →
      (∀ (i : ι), 0 ≤ c i) →
        (∀ (i : ι), ‖u i‖ = 1) →
          Beckner.IsWeightedFrame c u →
            ∀ (b : OrthonormalBasis (Fin 2) ℝ E),
              MeasureTheory.Integrable (fun z => ∏ i, f i (inner ℝ (u i) (Beckner.planePoint b z)) ^ c i)
                  (MeasureTheory.volume.prod MeasureTheory.volume) ∧
                ∫ (z : ℝ × ℝ),
                    ∏ i,
                      f i (inner ℝ (u i) (Beckner.planePoint b z)) ^
                        c i ∂MeasureTheory.volume.prod MeasureTheory.volume ≤
                  ∏ i, (∫ (y : ℝ), f i y) ^ c i
Beckner.youngFrame_sharp_factor : ∀ (a b d : ℝ),
  0 < a →
    0 < b →
      0 < d →
        a + b + d = 1 →
          (Beckner.youngFrameMatrix a b d).det /
              ∏ i, Beckner.youngFrameScale a b d i ^ Beckner.youngFrameWeights a b d i =
            ∏ i,
              √((1 / Beckner.youngFrameWeights a b d i) ^ Beckner.youngFrameWeights a b d i /
                  (1 / Beckner.youngFrameComplement a b d i) ^ Beckner.youngFrameComplement a b d i)
