"""E66: cumulative (Sturmian) rounding of profiles p:[0,1]->[0,1]; M/sqrt(n) vs X. Tests P41 (curved profiles,
van der Corput + spike truncation) against flat-irrational / flat-rational pieces where P41's hypothesis fails.
A = {j<=X : floor(sigma+Phi(j)) > floor(sigma+Phi(j-1))}, Phi(j) = sum_{i<=j} p(i/X).
NUMERICAL (grid + Newton minimum via box_minlam.true_min; not certified).
Usage: python src/e66_cumround.py [--out examples/e66/e66.jsonl]"""
import argparse, json, math, os, sys
import numpy as np
sys.path.insert(0, "src")
from box_minlam import true_min
g = (math.sqrt(5) - 1) / 2
PROFILES = {
    "a_lin_irr": lambda t: g * (1 - t),
    "b_quad_irr": lambda t: g * (1 - t) ** 2,
    "c_quad_half": lambda t: 0.5 * (1 - t) ** 2,
    "d_flat_irr": lambda t: np.where(t <= 0.5, g, g * (1 - (2 * t - 1)) ** 2),
    "e_flat_half": lambda t: np.where(t <= 0.5, 0.5, 0.5 * (1 - (2 * t - 1)) ** 2),
    "f_osc": lambda t: 0.35 + 0.25 * np.cos(5 * np.pi * t),
    "g_lin_from1": lambda t: 1 - t,
}
def cumround(p, X, sigma):
    t = np.arange(1, X + 1) / X
    Phi = np.cumsum(p(t))
    U = np.floor(sigma + Phi); U0 = np.concatenate([[math.floor(sigma)], U[:-1]])
    return (np.nonzero(U - U0 > 0)[0] + 1).tolist()
ap = argparse.ArgumentParser(); ap.add_argument("--out", default="examples/e66/e66.jsonl")
ap.add_argument("--logX", default="10,11,12,13,14,15,16"); a = ap.parse_args()
os.makedirs(os.path.dirname(a.out), exist_ok=True)
for name, p in PROFILES.items():
    for lx in map(int, a.logX.split(",")):
        X = 1 << lx
        for sigma in (0.0, 0.37, 0.71):
            A = cumround(p, X, sigma)
            (fm, xm), _, _ = true_min(A, over=16)
            rec = dict(profile=name, X=X, sigma=sigma, n=len(A), maxA=max(A), M=-fm, R=-fm / math.sqrt(len(A)), xmin=xm)
            print(json.dumps(rec), flush=True)
            with open(a.out, "a") as fh: fh.write(json.dumps(rec) + "\n")
"""Independent finite audits, exact profile checks, tables. VM only."""
import itertools
import json
import math
from pathlib import Path
import sys

import flint
import numpy as np
from scipy.linalg import eigvalsh

sys.path.insert(0,'src')
sys.path.insert(0,'.research/agents/tdense17_scratch')
from chowla import min_estimate_fft
from probe import spline_prob

ROOT=Path('.research/agents/tdense17_scratch')


def main():
    exact=0
    for L in range(2,40):
        a,p,Q=spline_prob(L)
        g={j:L-abs(j) for j in range(-L+1,L)}
        for v,pp in zip(a,p):
            r=sum(z*g.get(j+int(v),0) for j,z in g.items())
            if v<=L:
                formula=Q-L*int(v)**2+(int(v)**3-int(v))//2
            else:
                d=2*L-int(v); formula=(d**3-d)//6
            assert r==formula
            assert 0<=r<=Q
            assert 2*(Q-r)<=2*L*int(v)**2
            exact+=1
    # Independent, elementary all-circle certificate: Arb grid + global second derivative.
    A=np.load(ROOT/'spline_L4096_s17_p5_6.npz')['A'].tolist()
    flint.ctx.prec=140
    G=1<<18
    B=80
    vals=[flint.acb(0)]*G
    for a in A: vals[a]=flint.acb(1)
    F=flint.acb.dft(vals)
    S2=sum(a*a for a in A)
    remainder=flint.arb(S2)*flint.arb(22)**2/(2*49*G*G)
    # At a global minimizer f'=0; Taylor to its nearest grid point incurs <=remainder.
    passed=all(z.real+B-remainder>0 for z in F)
    assert passed
    est=min_estimate_fft(A,oversample=32,polish=32)
    xx=flint.arb(str(est.xmin))
    point=sum((xx*a).cos() for a in A)
    certificate=dict(M_upper_integer=B, clique_size=1025,
                     rigorous_ratio_lower='1025/160 = 6.40625',
                     grid=G, precision_bits=140, sum_a2=S2,
                     remainder=str(remainder), point_value=str(point), passed=passed,
                     method='Arb DFT; nearest global minimum, f-prime=0, global sum(a^2) Taylor bound; pi<22/7')
    print(json.dumps(certificate),flush=True)
    # Cross-check exact additive counts by explicit closed walks for all nonempty A in [1,7].
    moment_cases=0
    for bits in range(1,1<<7):
        aa=[j+1 for j in range(7) if bits>>j&1]
        aset=set(aa)
        H=np.array([[int(abs(x-y) in aset) for y in aa] for x in aa],dtype=np.int64)
        t2=sum(abs(x-y) in aset for x in aa for y in aa)
        t3=sum(abs(x-y) in aset and abs(y-z) in aset and abs(z-x) in aset
               for x in aa for y in aa for z in aa)
        common={(x,z):sum(abs(x-y) in aset and abs(z-y) in aset for y in aa)
                for x in aa for z in aa}
        t4=sum(v*v for v in common.values())
        assert t2==int(np.trace(H@H))
        assert t3==int(np.trace(H@H@H))
        assert t4==int(np.trace(H@H@H@H))
        w=eigvalsh(H.astype(float))
        for tau in (0.1,1.,math.sqrt(len(aa)),10.):
            low=w[w<=tau]
            mu=float(low.mean()); var=float(low.var())
            assert -w[0]+1e-8 >= var/(tau+abs(mu))+abs(mu)
        moment_cases+=1
    # Translates of the explicit obstruction, including overlaps and a distant translate.
    uniform=[]
    for m in (24,96,192):
        aa=np.arange(m+1,3*m+1)
        for t in (0,1,m,2*m,10*m):
            W=np.union1d(aa,aa+t)
            H=((np.abs(W[:,None]-W[None,:])>m)&(np.abs(W[:,None]-W[None,:])<=3*m)).astype(float)
            w=eigvalsh(H)
            rec=dict(m=m,t=t,vertices=len(W),
                     beta1=float(np.sum(w[np.abs(w)<=math.sqrt(2*m)]**2)/(2*m)**2),
                     psd_distance_per_vertex=float(np.linalg.norm(w[w<0])/len(W)))
            uniform.append(rec)
    (ROOT/'verification.json').write_text(json.dumps(dict(exact_profile_checks=exact,
        exact_moment_sets=moment_cases, independent_certificate=certificate,
        translated_intervals=uniform, flint_version=flint.__version__),indent=2)+'\n')
    # Tables are generated on the VM; local work only inserts the returned markdown.
    zoo=json.load(open(ROOT/'zoo.json'))['records']
    lines=['## Adversarial tables','',
           'NUMERICAL unless a separate exact or interval certificate is explicitly stated. Density alpha is tr(H²)/n² (including the diagonal normalization). B1 and B2 are the spectral energies inside sqrt(n) and 2sqrt(n), divided by n². Dpsd is the Frobenius distance to the PSD cone divided by n. BD is the truncated Bhatia–Davis bound at tau=sqrt(n), divided by sqrt(n).','',
           '| family | n | R est | alpha | B1 | B2 | Dpsd | −min eig / sqrt n | star | BD |',
           '|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|']
    for d in zoo:
        keys=['R_est','alpha','beta1','beta2','psd_distance','min_over_sqrtn','star_min_over_sqrtn','bd_over_sqrtn']
        lines.append('| '+d['name']+' | '+str(d['n'])+' | '+' | '.join(f'{d[k]:.5g}' for k in keys)+' |')
    lines += ['', 'NUMERICAL moment and rank audit. T3=tr(H³)/n³, T4=tr(H⁴)/n⁴, C4res=(tr(H⁴)−lambda_max^4)/n³. The effective rank is (tr P)²/tr(P²); traceP is tr(P)/n^(3/2). Qneg is sum_negative lambda² divided by n K_est². Raw integer counts and cutoff mean/variance for every row are in zoo.json.', '',
              '| family | T3 | T4 | C4res | eff rank | traceP | Qneg |',
              '|---|---:|---:|---:|---:|---:|---:|']
    for d in zoo:
        keys=['tr3_n3','tr4_n4','residual4_n3','r_eff','traceP_n32','neg_energy_over_nK2']
        lines.append('| '+d['name']+' | '+' | '.join(f'{d[k]:.5g}' for k in keys)+' |')
    lines += ['', 'NUMERICAL clique lower bounds. Clique membership and all pair differences are checked exactly. These are heuristic lower bounds for the clique number, not maximum-clique certificates. The column +0 extends the clique by the common neighbor 0; K_est is an uncertified minimum estimate.','',
              '| family | clique in S | with 0 | K est | (with 0)/K est |',
              '|---|---:|---:|---:|---:|']
    for d in json.load(open(ROOT/'cliques.json')):
        lines.append(f"| {d['name']} | {d['omega_S_lower']} | {d['omega_global_lower']} | {d['K_est']:.7g} | {d['omega_global_over_K_est']:.7g} |")
    lines += ['', 'NUMERICAL and separately certified profile examples. All listed ratios use a known clique; global clique maxima were not computed.','',
              '| L | forced prefix | seed | n | clique | M est | clique/K est | certified ratio lower |',
              '|---|---:|---:|---:|---:|---:|---:|---:|']
    for d in json.load(open(ROOT/'probe.json')):
        if d['test']!='forced_spline': continue
        bound=d.get('certified_omega_over_K_lower')
        lines.append(f"| {d['L']} | {d['forced_prefix']} | {d['seed']} | {d['n']} | {d['omega_lower']} | {d['M_est']:.8g} | {d['omega_over_K_est']:.8g} | {bound if bound is not None else '—'} |")
    (ROOT/'tables.md').write_text('\n'.join(lines)+'\n')
    print(json.dumps(dict(exact_profile_checks=exact,exact_moment_sets=moment_cases,
                         translated_interval_cases=len(uniform),tables='tables.md')),flush=True)


if __name__=='__main__': main()
"""Independent checks of the corrected round-17 derivations. VM ONLY."""
import hashlib
import json
import math
from fractions import Fraction
from pathlib import Path
import sys

import flint
import numpy as np
from scipy.linalg import eigvalsh

sys.path.insert(0,'src')
sys.path.insert(0,'.research/agents/tdense17_scratch')
from chowla import certify_lower_bound
from fourway import metrics

ROOT=Path('.research/agents/tdense17_scratch')


def main():
    count=0
    max_bulk_slack=-1e100
    for bits in range(1,1<<9):
        A=[a for a in range(1,10) if bits>>(a-1)&1]
        aset=set(A); n=len(A); S=A+[-a for a in A]
        e=sum(b-a in aset for i,a in enumerate(A) for b in A[i+1:])
        ordered_sums=sum(a+b in aset for a in A for b in A)
        TS=sum(s-t in set(S) for s in S for t in S)
        assert ordered_sums==e and TS==6*e
        H=np.array([[int(abs(a-b) in aset) for b in A] for a in A])
        assert int(np.trace(H@H))==2*e
        w=eigvalsh(H.astype(float)); K=max(0.,-float(w[0]))
        for gamma in (.125,.5,1.,2.):
            tau=gamma*math.sqrt(n)
            beta=float(np.sum(w[np.abs(w)<=tau]**2))
            rhs=n*K*max(tau,K)
            assert beta<=rhs+1e-7
            max_bulk_slack=max(max_bulk_slack,beta-rhs)
        # Exact coefficient form of the L=2,h=1 identity, independent of theta.
        assert all(1-2*int(a%2==0)==-(-1)**a for a in A)
        count+=1
    # Exact sparse-triangle/window identity, not a quadrature experiment.
    triangle=[]
    for H in range(1,65):
        alpha=Fraction(1,7)
        X=2*H
        ps=[2*alpha*(1-Fraction(a,X)) for a in range(1,X+1)]
        ws=[1-Fraction(abs(a-H),H) for a in range(1,X+1)]
        S=sum(p*w*w for p,w in zip(ps,ws))
        mu=sum(ps); v=sum(p*(1-p)*w*w for p,w in zip(ps,ws))
        assert S==alpha*Fraction(2*H*H+1,3*H)
        assert S>=mu/3 and v>=mu/6
        if H in (1,4,16,64): triangle.append(dict(H=H,mu=str(mu),v=str(v),weighted_energy=str(S)))
    # Arb checks of the actual smoothed witness; the proof is analytic.
    flint.ctx.prec=120
    boundary=[]
    rng=np.random.default_rng(171703)
    for k in (1,2,4,16,64):
        for d in (1,3):
            A=set(range(d, d*k+1,d))
            A|=set(map(int,rng.integers(1,20*d*k+1,size=2*k)))
            Ad={a//d for a in A if a%d==0}
            D=Fraction(sum(b not in Ad for b in range(1,k+1)))
            D+=sum((1-Fraction(b,4*k) for b in Ad if k<b<4*k),Fraction())
            x=3*flint.arb.pi()/(2*k+1)
            g=sum((flint.arb(4*k-b)/(4*k)*(b*x).cos() for b in Ad if b<4*k),flint.arb(0))
            bound=flint.arb(D.numerator)/D.denominator-flint.arb(23*k)/264
            assert g<bound
            boundary.append(dict(k=k,d=d,defect=str(D),g=str(g),upper=str(bound)))
    # Re-certify the existing tight finite CLIQUE-S instance from the saved A.
    A=np.load(ROOT/'spline_L4096_s17_p5_6.npz')['A'].tolist()
    aset=set(A)
    assert all(a in aset for a in range(1,1025))
    cert=certify_lower_bound(A,oversample=16,prec=120)
    assert -cert.lower_bound<77
    finite=dict(n=len(A),X=max(A),M_upper=-cert.lower_bound,
        clique_global=1025,clique_in_S=1024,
        global_ratio_lower=1025/(-2*cert.lower_bound),
        in_S_ratio_lower=1024/(-2*cert.lower_bound),grid=cert.L,
        sha256_A=hashlib.sha256(np.array(A,dtype='<i8').tobytes()).hexdigest())
    print(json.dumps(dict(finite_clique=finite)),flush=True)
    # Exact rational ambient defects of saved smooth-profile instances.
    smooth=[]
    for L,k in ((4096,1024),(262144,32768)):
        A=np.load(ROOT/f'spline_L{L}_s17_p5_6.npz')['A']
        aset=set(A.tolist())
        assert all(a in aset for a in range(1,k+1))
        numer=sum(4*k-int(a) for a in A if k<a<4*k)
        D=Fraction(numer,4*k)
        smooth.append(dict(L=L,k=k,defect=str(D),defect_over_k=float(D/k)))
    # Finite check of the convex variance lemma: enumerate all selector vectors.
    p=np.array([.09,.23,.37,.51,.65,.79,.93])
    w=np.array([.25,.5,.75,1.,.75,.5,.25])
    vals=[]; probs=[]; G=8192
    for bits in range(1<<7):
        x=np.array([bits>>j&1 for j in range(7)])
        prob=float(np.prod(np.where(x,p,1-p)))
        c=np.zeros(G); c[np.arange(1,8)]=w*x
        vals.append(float(np.abs(np.fft.fft(c)).mean()/2)); probs.append(prob)
    vals=np.array(vals); probs=np.array(probs)
    mean=float(probs@vals); var=float(probs@((vals-mean)**2))
    v=float(np.sum(p*(1-p)*w*w)); b=v/(2*math.sqrt(6*v+1))
    assert mean>=b and var<=.25
    enum=dict(variables=7,subsets=128,G=G,mean=mean,var=var,v=v,mean_lower=b)
    # Monte Carlo assesses scale, not the proof of probability one minus O(1/n).
    mc=[]
    rng=np.random.default_rng(171704)
    for X in (1024,4096,16384):
        alpha=X**(-.25); a=np.arange(1,X+1); H=X//2
        p=2*alpha*(1-a/X); w=np.maximum(1-np.abs(a-H)/H,0)
        G=8*X; samples=[]; sizes=[]
        for _ in range(128):
            keep=rng.random(X)<p; c=np.zeros(G); c[a]=w*keep
            samples.append(float(np.abs(np.fft.fft(c)).mean()/2)); sizes.append(int(keep.sum()))
        v=float(np.sum(p*(1-p)*w*w)); mu=float(p.sum())
        mc.append(dict(X=X,alpha=alpha,mu=mu,v=v,trials=128,
            B_mean=float(np.mean(samples)),B_var=float(np.var(samples,ddof=1)),
            B_min_over_sqrtn=float(np.min(np.array(samples)/np.sqrt(sizes))),
            mean_lower=v/(2*math.sqrt(6*v+1))))
    result=dict(exact_star_cases=count,bulk_numerical_cases=4*count,
        max_bulk_slack=max_bulk_slack,triangle_exact_checks=64,triangle_examples=triangle,
        boundary_arb=boundary,finite_clique=finite,smooth_defects=smooth,
        variance_enumeration=enum,rounding_MC=mc,flint_version=flint.__version__)
    (ROOT/'fourway_verification.json').write_text(json.dumps(result,indent=2)+'\n')
    print(json.dumps(result),flush=True)


if __name__=='__main__':main()

