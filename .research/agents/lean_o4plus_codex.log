+  have hzpair' : (1 + z ^ 2) ^ 3 = -1 := by
+    linear_combination (z ^ 4 - z ^ 3 + 3 * z ^ 2 - 2 * z + 2) * hz
+  have hzpair'' : (z + z ^ 2) ^ 3 = -1 := by rw [show z + z ^ 2 = -1 by linear_combination hz]; norm_num
