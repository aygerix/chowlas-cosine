        r_b = np.where(q != 0, c_ / q, 0.0)
    for r in (r_a, r_b):
        r = np.where(np.isfinite(r), np.clip(r, -h2, h2), h2)
        cand.append(r)
    pmin = np.full(L, np.inf)
    for s in cand:
        p = g0 + g1 * s + g2 * s * s / 2 + g3 * s ** 3 / 6
