@@ -0,0 +1,44 @@
+"""Numerical localized third-moment diagnostics, VM only.
+
+FFT quadrature has enough samples for cubic exactness algebraically; floating
+arithmetic is not certified. Records both moment and window certificates.
+"""
+import json
+import math
+from pathlib import Path
+import numpy as np
+
+OUT=Path(".research/agents/tdense_scratch")
+data=json.load(open(OUT/"probe.json"))
+records=[]
+for row in data["records"]:
+    A=row["A"]
+    X=max(A)
+    a=np.zeros(X+1)
+    a[A]=1
+    def av(j):
+        return a[abs(j)] if abs(j)<=X else 0
+    qs=[1,2,3,4,8,16]
+    out=[]
+    for q in qs:
+        D=X+q
+        b=np.r_[0,[av(j)-(av(j-q)+av(j+q))/2 for j in range(1,D+1)]]
+        E=float(np.dot(b,b))
+        V=E/2
+        G=1<<math.ceil(math.log2(4*D+1))
+        cf=np.zeros(G)
+        cf[:D+1]=b
+        vals=np.fft.fft(cf).real
+        W=float(np.mean(vals**3))
+        B=W/V**1.5
+        tau=2/(math.sqrt(B*B+4)+B)
+        Mlb=(tau*math.sqrt(V)+av(q)/2)/2
+        out.append({"q":q,"V_over_n":V/len(A),"third_over_V_threehalves":B,
+                    "third_moment_M_lower_bound":Mlb,
+                    "third_moment_R_lower_bound":Mlb/math.sqrt(len(A))})
+    records.append({"name":row["name"],"n":len(A),"X":X,"moments":out})
+Path(OUT/"third_moment.json").write_text(json.dumps({"status":"NUMERICAL, uncertified",
+                                                   "records":records},indent=2))
+for row in records:
+    best=max(row["moments"],key=lambda z:z["third_moment_R_lower_bound"])
+    print(json.dumps({"name":row["name"],"n":row["n"],"best":best}),flush=True)
diff --git a/.research/agents/tdense_scratch/third_moment_exact.py b/.research/agents/tdense_scratch/third_moment_exact.py
new file mode 100644
index 0000000000000000000000000000000000000000..3329076172dc2b434b6ea60717acd43347ae3621
--- /dev/null
+++ b/.research/agents/tdense_scratch/third_moment_exact.py
@@ -0,0 +1,47 @@
+"""Exact integer triple-count audit of the localized-moment certificates.
+Only execute through src/dirun.sh -c 2. Uses VM python-flint.
+"""
+import json
+from fractions import Fraction as F
+from pathlib import Path
+from flint import nmod_poly
+
+OUT=Path(".research/agents/tdense_scratch")
+sets=json.load(open(OUT/"probe.json"))["records"]
+floating={r["name"]:r for r in json.load(open(OUT/"third_moment.json"))["records"]}
+records=[]
+prime=998244353
+for row in sets:
+    A=row["A"]
+    n=len(A)
+    X=max(A)
+    assert 4*n*n<prime
+    coeff=[0]*(2*X+1)
+    for a in A:
+        coeff[X+a]=coeff[X-a]=1
+    poly=nmod_poly(coeff,prime)
+    cube=poly*poly*poly
+    aset=set(A)
+    def av(j):
+        return int(abs(j) in aset)
+    moments=[]
+    for f in floating[row["name"]]["moments"]:
+        q=f["q"]
+        C=[int(cube[3*X+k*q]) if 3*X+k*q<len(cube) else 0 for k in range(4)]
+        V=F(sum((2*av(j)-av(j-q)-av(j+q))**2 for j in range(1,X+q+1)),8)
+        Delta=10*C[0]-15*C[1]+6*C[2]-C[3]
+        W=F(Delta,32)+F(3*av(q),2)*V+F(av(q),8)
+        assert abs(float(W/V**F(3,2))-f["third_over_V_threehalves"])<1e-7
+        assert abs(float(V/n)-f["V_over_n"])<1e-12
+        criteria=(V>=F(n,10) and (W<=0 or W*W<=4*V**3))
+        moments.append({"q":q,"V":str(V),"W":str(W),"c_0_q_2q_3q":C,
+                        "sixth_difference_numerator":Delta,
+                        "V_ge_n_over_10_and_W_le_2V_threehalves":criteria})
+    assert any(m["V_ge_n_over_10_and_W_le_2V_threehalves"] for m in moments)
+    records.append({"name":row["name"],"n":n,"X":X,"moments":moments})
+result={"status":"EXACT finite moment criteria PASS, not the universal missing lemma",
+        "modulus":prime,"why_no_wrap":"Every triple count <= (2n)^2 < modulus",
+        "records":records}
+(OUT/"third_moment_exact.json").write_text(json.dumps(result,indent=2))
+print(json.dumps({"status":result["status"],"sets_checked":len(records),
+                  "all_have_q_le_16_with_V_ge_n_over_10_and_W_le_2V_threehalves":True}),flush=True)
diff --git a/.research/agents/tdense_scratch/verify_exact.py b/.research/agents/tdense_scratch/verify_exact.py
new file mode 100644
index 0000000000000000000000000000000000000000..8d711fbf854f83c04f13cd824c5b18f0bb563a1b
--- /dev/null
+++ b/.research/agents/tdense_scratch/verify_exact.py
@@ -0,0 +1,74 @@
+"""Exact auxiliary checks for the paper proof; execute on VM only.
+
+This script checks finite instances and rational constants. The report contains
+the all-X proof; finite checks are not substituted for that proof.
+"""
+import json
+from fractions import Fraction as F
+from pathlib import Path
+
+OUT = Path(".research/agents/tdense_scratch")
+
+
+def quadratic(X, phase_num=0, phase_den=1):
+    den = 2*X*X*phase_den
+    acc = 2*X*X*phase_num
+    old = acc//den
+    a = [0]*(X+1)
+    for j in range(1,X+1):
+        acc += (X-j)**2*phase_den
+        new = acc//den
+        a[j] = new-old
+        old = new
+    return a
+
+
+def check(X, phase_num=0, phase_den=1):
+    a = quadratic(X,phase_num,phase_den)
+    n = sum(a)
+    assert all(v in (0,1) for v in a)
+    assert all(a[j]+a[j+1]<=1 for j in range(X))
+    def av(j):
+        return a[abs(j)] if abs(j)<=X else 0
+    B = [0]+[2*av(j)-av(j-2)-av(j+2) for j in range(1,X+3)]
+    E = F(sum(b*b for b in B[1:]),4)
+    w = X//100
+    W = F(2*(w+1),3)+F(1,3*(w+1))
+    S = F(sum(B[j]**2*(w+1-j)**2 for j in range(1,w+1)),4*(w+1)**2)
+    C = F(811,1000)*(X+2+w+1)+F(71,300)
+    lb2 = (W*E-C*S)/(2*(C-W))
+    assert E>=F(X,16)-3
+    # The bound with constant 7 is derived for phase 0; allow 2 for phase !=0.
+    assert S<=F(X,5000)+9
+    if phase_num==0:
+        assert a[2]==0
+        assert S<=F(X,5000)+7
+        assert C<=F(7*X,8)
+        coarse = F(29*X,210000)-F(1229,350)
+        assert lb2>=coarse
+        if X>=100000:
+            assert coarse>=F(X,10000)
+    return {"X":X,"phase":[phase_num,phase_den],"n":n,
+            "E":str(E),"S":str(S),"C":str(C),"w":w,
+            "transformed_M_squared_lower_bound":str(lb2),
+            "transformed_M_squared_lower_bound_decimal":float(lb2),
+            "finite_checks":"PASS"}
+
+
+def main():
+    rows = [check(X) for X in [100,384,1536,6144,20000,100000,150000]]
+    rows += [check(6144,num,10) for num in [1,3,7,9]]
+    # Exact arithmetic in the two constant estimates used in the proof.
+    assert F(1,2400)-F(7,40000)==F(29,120000)
+    assert F(29,120000)*F(4,7)==F(29,210000)
+    assert (F(3,150)+F(49,8))*F(4,7)==F(1229,350)
+    assert F(29,210000)-F(1,10000)==F(1,26250)
+    assert F(1229,350)*26250==92175
+    result = {"status":"EXACT FINITE CHECKS; all-X proof in report",
+              "rows":rows,"constant_checks":"PASS"}
+    (OUT/"verify_exact.json").write_text(json.dumps(result,indent=2))
+    print(json.dumps(result),flush=True)
