+++ b/.research/agents/tdense8_scratch/effective_checks.py
@@ -0,0 +1,50 @@
+"""Exact constants + adversarial numerical audits of the finite Gaussian proof."""
+import json, math
+from fractions import Fraction as F
+from pathlib import Path
+import numpy as np
+OUT=Path('.research/agents/tdense8_scratch')
+
+def run():
+    K=10**6;J=10**6;delta=F(3,10**6);omega=2*delta+F(12,K)
+    # beta=10^(-6000003), c=beta/100. Avoid instantiating enormous integers.
+    beta_upper=F(1,10**12);c_upper=beta_upper/100
+    exact=dict(beta_exponent=6000003,c_exponent=6000005,K=K,J=J,
+        density_Nikolskii_margin=str(F(5,6)-(F(811,1000)*F(1004,1000)+F(811,1000)/100+F(71,300)/100)),
+        increment_bound=str(F(2,J)+42*c_upper),delta=str(delta),
+        density_lower_bound=str(F(8,15)-2*beta_upper),omega=str(omega),
+        crossing_error=str(2*delta+3*beta_upper),
+        required_energy_gap=str(F(3,100)**2-F(7,10**6)**2),
+        available_error=str(8*omega+2*beta_upper))
+    assert F(exact['density_Nikolskii_margin'])>0
+    assert F(exact['increment_bound'])<delta
+    assert F(exact['density_lower_bound'])>F(53,100)
+    assert F(exact['crossing_error'])<F(7,10**6)
+    assert F(exact['required_energy_gap'])>F(exact['available_error'])
+    # Numeric audits are not used to certify the analytic kernel lemmas.
+    kernel=[]
+    for ss in (1.,2.,5.,10.,30.):
+        R=math.ceil(14*ss);idx=np.arange(-R,R+1);kk=np.exp(-idx**2/(4*ss**2));Z=kk.sum();kk/=Z
+        xx=np.linspace(-np.pi,np.pi,3001)
+        L=np.cos(np.outer(xx,idx))@kk
+        # Absolute floating errors dominate the exponentially small exact bound for s>=2.
+        kernel.append(dict(s=ss,Z=float(Z),Z_lower=2*math.sqrt(math.pi)*ss,Z_upper=4*ss+1,
+            first_abs_moment=float(np.dot(abs(idx),kk)),moment_upper=4*ss,
+            min_L_float=float(L.min()),max_L_float=float(L.max()),
+            gaussian_difference_float=float(np.max(abs(L-np.exp(-ss**2*xx**2))))))
+    rng=np.random.default_rng(2026101908);finite=[]
+    for X in (100,300,800):
+        aa=np.zeros(2*X+1);bits=rng.random(X)<.35;bits[-1]=1
+        aa[X+1:]=bits;aa[:X]=bits[::-1]
+        for ss in (2.,10.,30.):
+            R=math.ceil(14*ss);idx=np.arange(-R,R+1);ks=np.exp(-idx**2/(4*ss**2));ks/=ks.sum()
+            q=np.convolve(aa,ks,'full');a=np.pad(aa,(R,R));r=a-q
+            E=np.convolve(r*r,ks,'full');ee=np.pad(q*(1-q),(R,R))
+            variation=max(float(np.max(abs(q-np.roll(q,j)))) for j in (1,2))
+            finite.append(dict(X=X,s=ss,energy_approx_max_error=float(np.max(abs(E-ee))),
+                               coefficient_variation=float(variation)))
+    rec=dict(status='EXACT CONSTANTS; NUMERICAL KERNEL AUDIT',exact=exact,kernel_numeric=kernel,finite_numeric=finite)
+    OUT.joinpath('effective_checks.json').write_text(json.dumps(rec,indent=2))
+    print(json.dumps(rec,indent=2),flush=True)
+
+if __name__=='__main__':run()
diff --git a/.research/agents/tdense8_scratch/potential.py b/.research/agents/tdense8_scratch/potential.py
new file mode 100644
index 0000000000000000000000000000000000000000..213219fc2ff105c66fd0d72f1d0bb5faf701222e
--- /dev/null
+++ b/.research/agents/tdense8_scratch/potential.py
@@ -0,0 +1,107 @@
+"""VM-only Gurobi discovery and exact rational verification of doubling potentials."""
+import os
+os.environ['SYMPY_GROUND_TYPES']='flint'
+import json, math, sys
+from fractions import Fraction as F
+from math import comb
+from pathlib import Path
+import numpy as np
+import gurobipy as gp
+from gurobipy import GRB
+
+OUT=Path('.research/agents/tdense8_scratch')
+
+def bernrow(x,m):
+    return np.array([comb(m,k)*x**k*(1-x)**(m-k) for k in range(m+1)])
+
+def discovery(m,gram4=False):
+    mod=gp.Model();mod.Params.OutputFlag=0;mod.Params.Threads=2
+    mod.Params.FeasibilityTol=1e-9;mod.Params.OptimalityTol=1e-9
+    rho=mod.addVar(lb=.7,ub=.86)
+    b=mod.addVars(m+1,lb=0,ub=10)
+    mod.addConstr(b[0]==0)
+    for k in range(m):mod.addConstr(b[k+1]>=b[k])
+    xx=np.unique(np.r_[np.linspace(1e-6,1,6001),1/math.sqrt(2)])
+    for x in xx:
+        y=max(0,2*x*x-1)
+        if gram4:y=max(y,x-math.sqrt(max(0,1-x)))
+        row=(bernrow(y,m)-bernrow(x,m)/2)/x
+        mod.addConstr(rho-x+gp.quicksum(float(row[k])*b[k] for k in range(m+1))>=0)
+    mod.setObjective(rho,GRB.MINIMIZE);mod.optimize()
+    rec=dict(degree=m,rho=rho.X,b=[b[k].X for k in range(m+1)],status=mod.Status,gram4=gram4)
+    print('DISCOVERY',json.dumps(rec),flush=True)
+    OUT.joinpath(f'potential_{"g4_" if gram4 else ""}d{m}_numeric.json').write_text(json.dumps(rec,indent=2))
+    return rec
+
+def add(a,b):
+    c=[F(0)]*max(len(a),len(b))
+    for i,v in enumerate(a):c[i]+=v
+    for i,v in enumerate(b):c[i]+=v
+    return c
+def mul(a,b):
+    c=[F(0)]*(len(a)+len(b)-1)
+    for i,x in enumerate(a):
+        for j,y in enumerate(b):c[i+j]+=x*y
+    return c
+def compose(a,b):
+    c=[F(0)]
+    for v in a[::-1]:c=add(mul(c,b),[v])
+    return c
+def power(a,k):
+    c=[F(1)]
+    for _ in range(k):c=mul(c,a)
+    return c
+def peval(a,x):
+    y=F(0)
+    for v in a[::-1]:y=y*x+v
+    return y
+def bern(a,lo,hi):
+    n=len(a)-1
+    q=[sum(a[j]*comb(j,k)*lo**(j-k)*(hi-lo)**k for j in range(k,n+1)) for k in range(n+1)]
+    return [sum(q[j]*F(comb(k,j),comb(n,j)) for j in range(k+1)) for k in range(n+1)]
+def certify(a,lo,hi,depth=0):
+    bb=bern(a,lo,hi)
+    if min(bb)>=0:return dict(ok=True,leaves=1,depth=depth,min_bound=str(min(bb)))
+    if peval(a,(lo+hi)/2)<0:return dict(ok=False,negative_at=str((lo+hi)/2))
+    if depth>=24:return dict(ok=False,unresolved=True)
+    mid=(lo+hi)/2;l=certify(a,lo,mid,depth+1);r=certify(a,mid,hi,depth+1)
+    return dict(ok=l['ok'] and r['ok'],leaves=l.get('leaves',0)+r.get('leaves',0),depth=max(l.get('depth',0),r.get('depth',0)))
+
+def exact(rec):
+    m=rec['degree'];den=10**9
+    bs=[F(round(v*den),den) for v in rec['b']]
+    assert bs[0]==0 and all(bs[k+1]>=bs[k] for k in range(m))
+    beta=[F(0)]*(m+1)
+    for k,v in enumerate(bs):
+        for j in range(m-k+1):beta[k+j]+=v*comb(m,k)*comb(m-k,j)*(-1)**j
+    # Rational cutoff is strictly above 1/sqrt(2). Tiny slack absorbs rounding.
+    cut=F(707107,10**6);assert 2*cut*cut>1
+    for slack in (F(1,10**5),F(1,10**4),F(1,1000)):
+        rho=F(math.ceil(rec['rho']*10**6),10**6)+slack
+        low=add([F(0),rho,F(-1)],[-v/2 for v in beta])
+        high=add(low,compose(beta,[F(-1),F(0),F(2)]))
+        assert low[0]==0
+        if rec.get('gram4'):
+            middle=add(compose(low,[F(1),F(0),F(-1)]),compose(beta,[F(1),F(-1),F(-1)]))
+            deriv=[(i+1)*beta[i+1] for i in range(len(beta)-1)]
+            checks=[certify(deriv,F(-1,1000),F(1)),certify(low[1:],F(0),F(61804,100000)),
+                    certify(middle,F(366,1000),F(61804,100000)),certify(high,F(86603,100000),F(1))]
+        else:checks=[certify(low[1:],F(0),cut),certify(high,cut,F(1))]
+        if all(c['ok'] for c in checks):break
+    result=dict(degree=m,gram4=rec.get('gram4',False),rho=str(rho),rho_float=float(rho),beta_bernstein=[str(v) for v in bs],
+                beta_power=[str(v) for v in beta],cutoff=str(cut),checks=checks,proved=all(c['ok'] for c in checks))
+    # Rational sufficient condition for a concrete T-dense reach, from P58.
+    reaches=[]
+    for rr in (F(769801,10**6),F(811,1000)):
+        Cf=(2/float(rr))*(1+math.sqrt(1-float(rho)))**2
+        C=F(math.floor(Cf*1000),1000);k=2/rr
+        margin=k-(k*rho+C)**2/(4*C)
+        reaches.append(dict(r=str(rr),C=str(C),margin=str(margin),positive=margin>0,limit_numeric=Cf))
+    result['reaches']=reaches
+    OUT.joinpath(f'potential_{"g4_" if rec.get("gram4") else ""}d{m}_exact.json').write_text(json.dumps(result,indent=2))
+    print('EXACT',json.dumps(result),flush=True)
+    return result
+
+if __name__=='__main__':
+    args=sys.argv[1:];g4='g4' in args;args=[v for v in args if v!='g4']
+    for m in map(int,args or ['1','4','8','12']):exact(discovery(m,g4))
diff --git a/.research/agents/tdense8_scratch/profile_numeric.py b/.research/agents/tdense8_scratch/profile_numeric.py
new file mode 100644
index 0000000000000000000000000000000000000000..625551ee4eec088d42fa467753500de9f58ff8d0
--- /dev/null
+++ b/.research/agents/tdense8_scratch/profile_numeric.py
@@ -0,0 +1,115 @@
+"""VM-only local Gurobi LP ascent, general DP PWL vs nonnegative autocorrelations.
+
+All reported maxima are NUMERICAL local results. No global optimality claim.
+"""
+import os,json,math,time,sys
+from pathlib import Path
+import numpy as np
+import gurobipy as gp
+from gurobipy import GRB
+OUT=Path('.research/agents/tdense8_scratch')
+
+def integrals(c):
+    v=np.r_[c,0.]
+    return .5*v[0]+v[1:].sum(),sum((v[:-1]**2+v[:-1]*v[1:]+v[1:]**2)/3)
+def autocorr(g):
+    v=np.correlate(g,g,'full')[len(g)-1:]
+    return v/v[0]
+def obj(g):
+    c=autocorr(g);a,b=integrals(c)
+    return b/a
+
+def optimize_autocorr(N,g0,steps=400):
+    # Nonnegative g, ||g||_2=1. Linearize quartic correlation energy and use
+    # a Gurobi linear objective on an l2 unit ball (convex QCP), plus line search.
+    g=g0/np.linalg.norm(g0)
+    for it in range(steps):
+        # Analytic gradient of J for the PWL autocorrelation.
+        q=np.correlate(g,g,'full')[N-1:];I1,I2=integrals(q);lam=I2/I1
+        gradq=np.zeros(N)
+        v=np.r_[q,0.]
+        gradq[:]=(4*q+np.r_[0,q[:-1]]+np.r_[q[1:],0])/3
+        gradq[0]-=2*q[0]/3
+        gradq-=lam*np.r_[.5,np.ones(N-1)]
+        # q0 is fixed under unit-norm normalization; account for its J denominator.
+        gradq[0]-=lam*I1
+        grad=2*gradq[0]*g
+        for k in range(1,N):
+            grad[:-k]+=gradq[k]*g[k:];grad[k:]+=gradq[k]*g[:-k]
+        grad/=I1
+        mod=gp.Model();mod.Params.OutputFlag=0;mod.Params.Threads=2
+        z=mod.addVars(N,lb=0)
+        mod.setObjective(gp.quicksum(float(grad[j])*(z[j]-float(g[j]))-(z[j]-float(g[j]))*(z[j]-float(g[j]))/(20*N) for j in range(N)),GRB.MAXIMIZE)
+        mod.optimize()
+        if mod.SolCount==0:break
+        target=np.array([z[j].X for j in range(N)])
+        if np.linalg.norm(target)<1e-10:break
+        best=(obj(g),g)
+        for alpha in (2.**(-j) for j in range(22)):
+            new=(1-alpha)*g+alpha*target;new/=np.linalg.norm(new)
+            cand=obj(new)
+            if cand>best[0]:best=(cand,new)
+        if best[0]<=obj(g)+1e-12:break
+        g=best[1]
+    return g,it,obj(g)
+
+def general(B,c0,steps=120):
+    th=np.linspace(0,np.pi,32*B+1)
+    C=np.cos(np.outer(th,np.arange(B)))
+    model=gp.Model();model.Params.OutputFlag=0;model.Params.Threads=2
+    model.Params.FeasibilityTol=1e-9;model.Params.OptimalityTol=1e-9
+    c=model.addMVar(B,lb=0,ub=1);model.addConstr(c[0]==1)
+    A=2*C;A[:,0]=1
+    model.addConstr(A@c>=0)
+    fine=np.linspace(0,np.pi,512*B+1)
+    Fine=np.cos(np.outer(fine,np.arange(1,B)))
+    cur=c0.copy()
+    for it in range(steps):
+        I1,I2=integrals(cur);lam=I2/I1
+        grad=(4*cur+np.r_[0,cur[:-1]]+np.r_[cur[1:],0])/3;grad[0]-=2*cur[0]/3
+        grad-=lam*np.r_[.5,np.ones(B-1)]
+        model.setObjective(grad@c,GRB.MAXIMIZE)
+        for refine in range(12):
+            model.optimize()
+            if model.SolCount==0:break
+            candidate=c.X.copy();symbol=candidate[0]+2*Fine@candidate[1:]
+            bad=np.flatnonzero((symbol[1:-1]<symbol[:-2])&(symbol[1:-1]<symbol[2:])&(symbol[1:-1]<-1e-8))+1
+            if not len(bad):break
+            for j in bad:model.addConstr(c[0]+2*Fine[j]@c[1:]>=0)
+        if model.SolCount==0:break
+        nxt=c.X.copy();nI1,nI2=integrals(nxt)
+        if nI2/nI1<=lam+1e-10:break
+        cur=nxt
+    symbol=cur[0]+2*Fine@cur[1:]
+    # A numerical diagonal repair guarantees only a sampled/floating bound here.
+    repair=max(0.,-float(symbol.min()))+1e-8
+    repaired=cur.copy();repaired[0]+=repair;repaired/=repaired[0]
+    I1,I2=integrals(cur);rI1,rI2=integrals(repaired)
+    return dict(J=I2/I1,J_repaired_numeric=rI2/rI1,min_symbol_fine=float(symbol.min()),
+                repair=repair,iterations=it,c=cur.tolist())
+
+def run():
+    rows=[];rng=np.random.default_rng(2026101908)
+    for B in (40,80,160):
+        grid=(np.arange(B)+.5)/B
+        starts=[('half_sine',np.sin(np.pi*grid)),('random',rng.random(B)+.1)]
+        for name,g0 in starts:
+            t=time.time();g,it,J=optimize_autocorr(B,g0)
+            row=dict(class_name='autocorrelation',B=B,start=name,J=J,iterations=it,seconds=time.time()-t,g=g.tolist())
+            rows.append(row);print(json.dumps({k:v for k,v in row.items() if k!='g'}),flush=True)
+            t=time.time();rec=general(B,autocorr(g))
+            row=dict(class_name='general_pwl',B=B,start=name,seconds=time.time()-t,**rec)
+            rows.append(row);print(json.dumps({k:v for k,v in row.items() if k!='c'}),flush=True)
+            OUT.joinpath('profile_numeric.json').write_text(json.dumps(rows,indent=2))
+    print('DONE',flush=True)
+
+if __name__=='__main__':
+    if len(sys.argv)>1 and sys.argv[1]=='auto':
+        rows=[]
+        for B in (160,400,800):
+            grid=(np.arange(B)+.5)/B
+            g,it,J=optimize_autocorr(B,np.sin(np.pi*grid))
+            row=dict(B=B,start='half_sine',J=J,iterations=it,g=g.tolist())
+            rows.append(row);print(json.dumps({k:v for k,v in row.items() if k!='g'}),flush=True)
+        OUT.joinpath('autocorrelation_refined.json').write_text(json.dumps(rows,indent=2))
+    else:run()
diff --git a/.research/agents/tdense8_scratch/verify.py b/.research/agents/tdense8_scratch/verify.py
new file mode 100644
index 0000000000000000000000000000000000000000..34dbdd07df223ddee9b9065c321955b8626ccfa9
--- /dev/null
+++ b/.research/agents/tdense8_scratch/verify.py
@@ -0,0 +1,70 @@
+"""Independent exact checks. Run on dirichlet, never locally."""
+import os
+os.environ['SYMPY_GROUND_TYPES']='flint'
+import json, sys, random, platform
+from fractions import Fraction as F
+from pathlib import Path
+import sympy as s
+OUT=Path('.research/agents/tdense8_scratch')
+
+def sturm_positive(expr,x,lo,hi):
+    P=s.Poly(expr,x,domain=s.QQ)
+    roots=int(P.count_roots(lo,hi))
+    vals=[P.eval(lo),P.eval((lo+hi)/2),P.eval(hi)]
