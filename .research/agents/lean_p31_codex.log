      apply mul_le_mul_of_nonneg_right _ (heatKernel_pos ht x).le
      exact (abs_sub _ _).trans (by rw [abs_of_nonneg (by positivity), abs_of_nonneg (by positivity)])
    _ = ((x ''^ 2 * gaussian (1 / (4 * t)) x) / (4 * t ''^ 2) +
