"""Round 17 first falsification tests. Run only through dirun.sh, <=4 cores."""
import json
import math
from pathlib import Path
import sys
import time

import numpy as np
from scipy.linalg import eigvalsh

sys.path.insert(0, 'src')
from chowla import min_estimate_fft, certify_lower_bound

ROOT = Path('.research/agents/tdense17_scratch')


def spline_prob(L):
    a = np.arange(1, 2 * L, dtype=np.int64)
    Q = L * (2 * L * L + 1) // 3
    r = np.empty_like(a)
    lo = a <= L
    b = a[lo]
    r[lo] = Q - L * b * b + (b * b * b - b) // 2
    b = 2 * L - a[~lo]
    r[~lo] = (b * b * b - b) // 6
    return a, r / Q, Q


def main():
    records = []
    for m in (16, 64, 256, 1024):
        n = 2 * m
        s = 1 / (2 * np.sin((2 * np.arange(1, m) - 1) * np.pi / (4 * m - 2)))
        w = np.r_[-s, [0., 0.], s]
        if m <= 64:
            A = np.arange(m + 1, 3 * m + 1)
            H = (np.abs(A[:, None] - A[None, :]) > m).astype(float)
            assert np.max(np.abs(eigvalsh(H) - np.sort(w))) < 1e-9
        rec = dict(test='shifted_interval', m=m, n=n, bulk_gamma1=float(np.sum(w[np.abs(w) <= math.sqrt(n)] ** 2) / n ** 2),
                   neg_energy=float(np.sum(s*s) / n**2), edge=float(s.max()/math.sqrt(n)))
        records.append(rec)
        print(json.dumps(rec), flush=True)
    for L, power in ((512, 2/3), (4096, 2/3), (32768, 2/3), (262144, 2/3),
                     (4096, 5/6), (262144, 5/6)):
        a, p, Q = spline_prob(L)
        k = round(L ** power)
        for seed in (17, 117):
            rng = np.random.default_rng(seed)
            keep = rng.random(len(a)) < p
            keep[:k] = True
            A = a[keep].tolist()
            est = min_estimate_fft(A, oversample=16, polish=16)
            rec = dict(test='forced_spline', L=L, power=power, seed=seed, n=len(A), X=max(A), forced_prefix=k,
                       omega_lower=k+1, M_est=-est.fmin, omega_over_K_est=(k+1)/(-2*est.fmin),
                       forcing_l1=float(np.sum(1-p[:k])), unforced_expected_n=float(p.sum()),
                       expected_n=float(p.sum()+np.sum(1-p[:k])), Q=Q)
            if L == 4096 and seed == 17:
                cert = certify_lower_bound(A, oversample=16, prec=100)
                rec['certified_M_upper'] = -cert.lower_bound
                rec['certified_omega_over_K_lower'] = (k+1)/(-2*cert.lower_bound)
                rec['cert_grid'] = cert.L
            suffix = '_p5_6' if power > 0.8 else ''
            np.savez_compressed(ROOT / f'spline_L{L}_s{seed}{suffix}.npz', A=np.array(A, dtype=np.int64))
            records.append(rec)
            print(json.dumps(rec), flush=True)
    (ROOT / 'probe.json').write_text(json.dumps(records, indent=2) + '\n')


if __name__ == '__main__':
    main()
"""Reproduction of Bu et al. (arXiv:2610.17160v1) two-sided Singer construction.

S ⊂ Z Sidon, |S| = k:  A(S) = {3|s_i - s_j| : i<j} ∪ {|3(s_i+s_j)+1| : i<j},  |A| = k(k-1),
f_A(x) = rho(x)^2 - k/2 - g(x)/2,  rho = sum cos((3 s_j + 1/2) x),  g = sum cos((6 s_j + 1) x).
S: random tent-weighted thinning of a shifted Singer set (D - c), with a block P of r odd-offset elements nearest
the centre deleted ("parity block"); |S| = k enforced by rejection.
"""
from __future__ import annotations
import math
import numpy as np
from singer import singer


def bu_set_S(q, k, r=None, seed=0, max_tries=100000, D=None, v=None, shift=0):
    if D is None:
        D, v = singer(q)
    D = sorted((d + shift) % v for d in D)
    c = (v - 1) // 2
    L = c + 1
    w = {d: 1 - abs(d - c) / L for d in D}
    if r is None:
        r = math.ceil(3 * math.sqrt(q))
    odd = sorted([d for d in D if (d - c) % 2 != 0], key=lambda d: abs(d - c))
    P = set(odd[:r])
    rest = [d for d in D if d not in P]
    M = sum(w[d] for d in rest)
    theta = k / M
    if theta > 1:
        raise ValueError("k too large for this q")
    rng = np.random.default_rng(seed)
    p = np.array([theta * w[d] for d in rest])
    for _ in range(max_tries):
        xi = rng.random(len(rest)) < p
        if xi.sum() == k:
            S = sorted(d - c for d, keep in zip(rest, xi) if keep)
            return S, dict(q=q, v=v, c=c, r=r, theta=theta, seed=seed, shift=shift)
    raise RuntimeError("rejection sampling failed")


def A_of_S(S):
    k = len(S)
    diffs = {3 * abs(S[i] - S[j]) for i in range(k) for j in range(i + 1, k)}
    sums = {abs(3 * (S[i] + S[j]) + 1) for i in range(k) for j in range(i + 1, k)}
    A = diffs | sums
    if len(A) != k * (k - 1) or len(diffs) + len(sums) != len(A) or 0 in A:
        raise ValueError("A(S) not a genuine set of size k(k-1): S not Sidon?")
    return sorted(A)


def identity_check(S, xs):
    A = A_of_S(S)
    S = np.asarray(S, float)
    Af = np.asarray(A, float)
    out = []
    for x in xs:
        lhs = np.cos(Af * x).sum()
        rho = np.cos((3 * S + 0.5) * x).sum()
        g = np.cos((6 * S + 1) * x).sum()
        out.append(lhs - (rho * rho - len(S) / 2 - g / 2))
    return max(abs(e) for e in out)
"""Fast Singer perfect difference sets D ⊂ Z/v, v = q^2+q+1, |D| = q+1 (q prime).

GF(q^3) = GF(q)[x]/(x^3 - a2 x^2 - a1 x - a0) with x primitive.  D = {i in [0,v) : coefficient of x^2 in x^i is 0}
(x^i lies in the 2-dim subspace span{1, x}); this set is invariant under GF(q)^* scaling, i.e. well defined mod v.
"""
from __future__ import annotations


def _factor(n):
    f, p = set(), 2
    while p * p <= n:
        while n % p == 0:
            f.add(p); n //= p
        p += 1
    if n > 1:
        f.add(n)
    return f


def _mul(u, w, poly, q):
    a2, a1, a0 = poly  # x^3 = a2 x^2 + a1 x + a0
    c = [0] * 5
    for i in range(3):
        if u[i]:
            for j in range(3):
                c[i + j] += u[i] * w[j]
    for k in (4, 3):
        t = c[k] % q
        if t:
            c[k - 1] += a2 * t; c[k - 2] += a1 * t; c[k - 3] += a0 * t
        c[k] = 0
    return (c[0] % q, c[1] % q, c[2] % q)


def _pow(u, e, poly, q):
    r = (1, 0, 0)
    while e:
        if e & 1:
            r = _mul(r, u, poly, q)
        u = _mul(u, u, poly, q)
        e >>= 1
    return r


def singer(q: int):
    order = q ** 3 - 1
    primes = _factor(order)
    X = (0, 1, 0)
    for a0 in range(1, q):
        for a1 in range(q):
            for a2 in range(q):
                poly = (a2, a1, a0)
                # x primitive <=> x^(order/p) != 1 for all p | order, and x^order == 1
                if _pow(X, order, poly, q) != (1, 0, 0):
                    continue
                if any(_pow(X, order // p, poly, q) == (1, 0, 0) for p in primes):
                    continue
                v = q * q + q + 1
                D, cur = [], (1, 0, 0)
                for i in range(v):
                    if cur[2] == 0:
                        D.append(i)
                    cur = _mul(cur, X, poly, q)
                assert len(D) == q + 1, (q, len(D))
                return D, v
    raise RuntimeError("no primitive polynomial")


def is_perfect_difference_set(D, v):
    seen = set()
    for a in D:
        for b in D:
            if a != b:
                r = (a - b) % v
                if r in seen:
                    return False
                seen.add(r)
    return len(seen) == v - 1
