        have hcard : (A.card : ℝ) ≤ 2000 := by exact_mod_cast (by omega : A.card ≤ 2000)
        nlinarith [sq_nonneg (M - 1 / 2)]
      · have he : A = ∅ := Finset.not_nonempty_iff_eq_empty.mp hne
