+    for S in (1,4,16,64):
+        Y=32768; m=np.arange(1,Y+1)
+        primes=[q for q in range(2,400) if all(q%d for d in range(2,math.isqrt(q)+1))][:S]
+        xs=2*np.pi*np.sqrt(primes)
