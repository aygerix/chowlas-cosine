+                                weights=(weights[:,None]*w).ravel()
+                            vals.append(float(np.dot(weights,abs(dy(freqs,X)))))
+                        qcounts.append(max(vals))
+                m=np.arange(1,X+1); z=np.zeros(X,complex)
