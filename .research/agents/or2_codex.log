"""Core evaluators and certifiers for Chowla's cosine problem.

Convention (fixed throughout the project):
    f_A(x) = sum_{a in A} cos(a x),  x in R,  period 2*pi.
Internally we often use t = x / (2*pi) in [0, 1) and g(t) = f_A(2*pi*t);
min_x f_A = min_t g, so nothing changes.

Three independent evaluators:
  (E1) min_estimate_fft      : float64 numpy FFT on a fine grid + Newton polish.
                               UNCERTIFIED estimate of min f_A and argmin.
  (E2) certify_lower_bound   : rigorous.  Ball-arithmetic DFT (FLINT/arb acb.dft)
                               gives enclosures of g, g', g'', g''' on a grid of
                               spacing h = 1/L; a 4th-order Taylor remainder with
                               |g''''| <= (2 pi)^4 sum a^4 bounds g between grid
                               points.  Returns a certified lower bound for min g.
  (E3) sturm_certify         : exact.  sum_a T_a(y) + B >= 0 on [-1,1] via PARI
                               polsturm on an integer polynomial (small max(A) only).
"""
from __future__ import annotations

import math
import re
import subprocess
from dataclasses import dataclass

import numpy as np


# ---------------------------------------------------------------------------
# Input handling
# ---------------------------------------------------------------------------

def parse_set(s: str) -> list[int]:
    """Parse an Epoch-format string; raise on any violation of the spec."""
    toks = [t for t in re.split(r"[\s,]+", s.strip()) if t]
    out = []
    for t in toks:
        if not re.fullmatch(r"[0-9]+", t):
            raise ValueError(f"not a plain positive decimal integer: {t!r}")
        v = int(t)
        if v <= 0:
            raise ValueError(f"non-positive frequency {v}")
        out.append(v)
    if len(set(out)) != len(out):
        raise ValueError("repeated frequency")
    return out


def validate(A) -> list[int]:
    A = [int(a) for a in A]
    if not A:
        raise ValueError("empty set")
    if min(A) <= 0:
        raise ValueError("non-positive frequency")
    if len(set(A)) != len(A):
        raise ValueError("repeated frequency")
    return sorted(A)


# ---------------------------------------------------------------------------
# (E1) float evaluator
# ---------------------------------------------------------------------------

def f_direct(A, x):
    """Direct float evaluation of f_A at array x (radians)."""
    A = np.asarray(A, dtype=np.float64)
    x = np.atleast_1d(np.asarray(x, dtype=np.float64))
    out = np.zeros_like(x)
    for chunk in np.array_split(A, max(1, len(A) // 256)):
        out += np.cos(np.outer(x, chunk)).sum(axis=1)
    return out


def grid_values_fft(A, L):
    """g(j/L), j=0..L-1, via real FFT (float, uncertified)."""
    c = np.zeros(L)
    for a in A:
        c[a % L] += 1.0
    return np.fft.fft(c).real  # sum_a cos(2 pi a j / L)


def _newton_polish(A, x0, iters=30):
    Af = np.asarray(A, dtype=np.float64)
    x = float(x0)
    for _ in range(iters):
        s = np.sin(Af * x); c = np.cos(Af * x)
        d1 = -(Af * s).sum(); d2 = -(Af * Af * c).sum()
        if d2 <= 0:
            break
        step = d1 / d2
        x -= step
        if abs(step) < 1e-15:
            break
    return x, float(np.cos(Af * x).sum())


@dataclass
class MinEstimate:
    fmin: float        # estimated min f_A
    xmin: float        # estimated argmin in [0, pi]
    N: int
    R: float           # -fmin / sqrt(N)


def min_estimate_fft(A, oversample=16, polish=8):
    """UNCERTIFIED: grid min via FFT then Newton-polish the best few local minima."""
    A = validate(A)
    L = 1 << max(10, math.ceil(math.log2(oversample * max(A) + 1)))
    g = grid_values_fft(A, L)
    half = g[: L // 2 + 1]
    idx = np.argsort(half)[: max(polish, 1)]
    best = (math.inf, 0.0)
    for j in idx:
        x, v = _newton_polish(A, 2 * math.pi * j / L)
        v_grid = half[j]
        if v_grid < v:
            v, x = v_grid, 2 * math.pi * j / L
        if v < best[0]:
            best = (v, x)
    x = best[1] % (2 * math.pi)
    if x > math.pi:
        x = 2 * math.pi - x
    return MinEstimate(best[0], x, len(A), -best[0] / math.sqrt(len(A)))


# ---------------------------------------------------------------------------
# (E2) rigorous certifier with ball arithmetic
# ---------------------------------------------------------------------------

@dataclass
class Certificate:
    lower_bound: float     # certified: g(t) >= lower_bound for all real t
    L: int                 # grid size
    grid_min_upper: float  # an actual value g(t_j) (upper bound for min g), enclosure mid
    remainder: float       # Taylor remainder budget used per cell
    worst_cell: int
    method: str = "arb-dft + 4th-order Taylor"


def _ball_dft(coeff_dict, L, prec):
    """Rigorous DFT: returns (mid_re, rad_re, mid_im, rad_im) numpy arrays of
    sum_k c_k exp(-2 pi i k j / L)."""
    import flint
    old = flint.ctx.prec
    flint.ctx.prec = prec
    try:
        v = [flint.acb(0)] * L
        for k, c in coeff_dict.items():
            v[k] = v[k] + flint.acb(c)
        w = flint.acb.dft(v)
# Research-review and continuation protocol

A research review is not a worker status digest. It is a decision about the **entire attempt to solve the stated problem**.

## Trigger

Perform after two structurally different attempts, a substantive new obstruction, duplicated work, repeated zero-novelty searches, or just before finishing an extended research task.

## Compare options

For each candidate route, ask:

1. **Target relevance:** If the next lemma succeeds, exactly what part of the original theorem changes?
2. **Mechanism:** What mathematical property could make it true?
3. **Falsifiability:** What's a decisive calculation, specialization, counterexample, or intermediate proof?
4. **Uniqueness:** Is this a genuinely different approach from previous failures?
5. **Cost:** Is the best next move a 5-minute symbolic derivation, a bounded exact search, reading a named theorem, or an independent verifier?

Choose a route explicitly; do not continue by inertia. Do not infer probabilities from intuition and present them as estimates.

## Failure-to-discovery example (generic arithmetic geometry)

Bad: "The doubling law does not preserve integral points. Therefore I cannot derive more integral points; no advance."

Better:

- Compute denominator formulas for x(2P) and x(P±Q) on the exact Weierstrass model.
- Derive necessary valuation inequalities for integrality of the image; include primes dividing the discriminant and denominators.
- Test whether any nontrivial family satisfies these inequalities. Try to falsify the naive integrality lemma with explicit P,Q.
- If false, determine whether a restricted class (specified torsion, valuations, reduction type) admits a valid lemma; otherwise discard this mechanism and pursue another (e.g. inverse parametrization or independent local support arguments).
- Record the obstruction and the new exact condition or counterexample. Don't claim an integral group closure theorem.

## Team coordination

Do not create a parade of parallel agents that all "investigate the problem". Give each agent a distinct conjectured lemma, a source/derivation check, a falsification test, and an output file. Review returned artifacts (equations, code, citations). Terminate work that produces no decision-relevant information. Periodically decide *globally* whether the present program is worth continuing.

## Exit decisions

- **CONTINUE** if a concrete next lemma/test has plausible information value within the remaining budget.
- **PIVOT** if the obstruction invalidates the current mechanism and a distinct mechanism has an identifiable test.
- **STOP** if the user-imposed budget/permission has ended, the goal is resolved, or after serious attempts the available next tasks lack credible information value. Explain exactly why. Don't claim exhaustive impossibility from limited exploration.
- A review can be honest even with no new theorem; it should still contain a reproducible counterexample, new exact reduction, bounded computation, eliminated conditional assumption, or a clear explanation of why existing directions were tested and discarded.

## Optional ledger helper

Run `python3 <skill-folder>/scripts/research_log.py --help` for `init`, `attempt`, `review`, `status`, and `audit` commands. The audit detects missing attempt/review records, but cannot determine whether the mathematical derivations or reported tests are genuine. Use it to catch omissions, not to reward checklist completion.

