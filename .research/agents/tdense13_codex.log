+++ b/.research/agents/tdense13_scratch/audit.py
@@ -0,0 +1,140 @@
+"""Independent certificates, exact-enclosure exhaustive trade-offs, profile diagnostics and hashes."""
+from pathlib import Path
+from fractions import Fraction as Q
+from itertools import combinations
+import json, math, hashlib, platform, ast
+import numpy as np
+from flint import arb,ctx
+ctx.prec=220
+ROOT=Path(__file__).resolve().parent
+
+def exact_curve(q):
+    h=(q-1)//2;m=(q-1)//4;scale=1<<100
+    bounds={}
+    for a in range(1,h+1):
+        z=2*(2*arb.pi()*a/q).cos()*scale
+        lo=z.lower().floor().unique_fmpz();hi=z.upper().ceil().unique_fmpz()
+        assert lo is not None and hi is not None
+        bounds[a]=(int(lo),int(hi))
+    def mask(P):return sum(1<<(a-1) for a in P)
+    def image(P,g):return tuple(sorted(min((g*a)%q,q-(g*a)%q) for a in P))
+    def eigen(P,g):
+        Qs=image(P,g)
+        return (sum(bounds[a][0] for a in Qs),sum(bounds[a][1] for a in Qs))
+    seen=set();orbits=[];cases=0
+    for P in combinations(range(1,h+1),m):
+        cases+=1
+        if mask(P) in seen:continue
+        seen.update(mask(image(P,g)) for g in range(1,h+1))
+        eig=[eigen(P,g) for g in range(1,h+1)]
+        k=(-min(x[1] for x in eig),-min(x[0] for x in eig))
+        peak=(max(x[0] for x in eig),max(x[1] for x in eig))
+        gg=max(range(1,h+1),key=lambda g:sum(eig[g-1]))
+        orbits.append((k,peak,image(P,gg)))
+    orbits.sort(key=lambda x:sum(x[0]));steps=[];prev=None;lastk=None
+    for k,peak,P in orbits:
+        if lastk is not None:assert lastk[1]<k[0],('unresolved threshold order',q)
+        lastk=k
+        if prev is None or peak[0]>prev[1]:
+            steps.append(dict(K_integer_enclosure=list(k),Lambda_integer_enclosure=list(peak),
+                              K_mid=sum(k)/(2*scale),Lambda_mid=sum(peak)/(2*scale),pairs=list(P)))
+            prev=peak
+        else:assert peak[1]<prev[0],('unresolved peak comparison',q)
+    assert len(seen)==cases
+    return dict(q=q,candidates=cases,orbits=len(orbits),denominator=scale,steps=steps,
+        status='PROVED exhaustive enumeration with integer enclosures of Arb cosine coefficients; exact threshold values defined by stored pairs')
+
+def cyclic():
+    import cyclic_probe
+    out=[]
+    for row in json.loads((ROOT/'cyclic_tradeoffs.json').read_text()):
+        if not row.get('pairs'):continue
+        q=row['q'];P=row['pairs'];cert=cyclic_probe.balls(q,P)
+        assert cert['K_interval'][1]<row['kappa']
+        assert abs(cert['Lambda_interval'][0]-row['objective'])<1e-8
+        b=np.zeros(q,dtype=np.int64);b[P]=1;b[[-a for a in P]]=1
+        assert int(b.sum())==(q-1)//2 and b[0]==0 and np.array_equal(b,b[np.arange(q)*-1%q])
+        row['certificate']=cert;out.append(dict(q=q,factor=row['factor'],certificate=cert))
+    rows=json.loads((ROOT/'cyclic_tradeoffs.json').read_text())
+    for r,a in zip(rows,out):r['certificate']=a['certificate']
+    (ROOT/'cyclic_tradeoffs.json').write_text(json.dumps(rows,indent=2))
+    return out
+
+def binary():
+    from binary_probe import profile
+    out=[]
+    for line in (ROOT/'binary_results.jsonl').read_text().splitlines():
+        row=json.loads(line);X=row['X'];family=row['family']
+        A=np.load(ROOT/(family+'_X'+str(X)+'.npz'))['A'];n=len(A)
+        assert n==row['n'] and len(np.unique(A))==n and A.min()>=1 and A.max()<=X
+        p,w=profile(X);bits=np.zeros(X);bits[A-1]=1;B=row['block']
+        maxdisc=max(abs(bits[:i].sum()-p[:i].sum()) for i in range(B,X+1,B))
+        assert maxdisc<=.5000001
+        num=row['phase_num'];den=row['phase_den']
+        # Group equal residues, then use an independent cosine-recurrence evaluation.
+        v=arb(0);x=2*arb.pi()*num/den
+        for a in A:v+=(int(a)*x).cos()
+        saved=arb(row['point_ball']);assert v.overlaps(saved)
+        low=-float(v.upper())/math.sqrt(n);assert low>.6
+        phase=num/den
+        main=float(np.dot(p,np.cos(2*np.pi*np.arange(1,X+1)*phase)))
+        # A fixed block comb is a concrete diagnostic for rational atoms.
+        comb=[]
+        for j in (1,2):
+            counts=np.bincount(A%B,minlength=B);val=arb(0)
+            for c,count in enumerate(counts):val+=int(count)*(2*arb.pi()*j*c/B).cos()
+            comb.append(dict(numerator=j,denominator=B,ball=str(val),value_over_X=float(val.mid())/X))
+        err=bits-p
+        second=float(np.dot(err,err)/X);expected=float(np.dot(p,1-p)/X)
+        third=float(np.mean(err**3));third_expected=float(np.mean(p*(1-p)*(1-2*p)))
+        diagnostic=dict(family=family,X=X,n=n,actual_max=int(A.max()),point_ball_220=str(v),
+             R_point_lower_float=float(np.nextafter(low,-np.inf)),profile_prefix_discrepancy=maxdisc,
+             smooth_value_at_dip=main,residual_value_at_dip=float(v.mid())-main,
+             second_binary=second,second_profile=expected,third_binary=third,third_profile=third_expected,
+             q=row.get('q'),distance_to_q_root=(abs(phase*row['q']-round(phase*row['q'])) if 'q' in row else None),
+             block_comb=comb)
+        out.append(diagnostic)
+    return out
+
+def moments():
+    # Nonnegative shifted power moments are automatic, while the R12 fake's cubic is irrational.
+    import sympy as s
+    q,m,u=s.symbols('q m u');a=q-1
+    T=a*(u-1);E=a*(u*u-2*u+q+1)
+    cubic=-2*T**3/m**2+3*T*E/m-3*u*E+3*T*u*u-a*u**3
+    rem=s.rem(s.expand(cubic),u**3-q,u)
+    assert s.factor(rem.coeff(u,2))==3*a*(m-a)*(m-2*a)/m**2
+    tests=[]
+    for prime in (int(s.nextprime(x)) for x in (1000000,8000000,64000000)):
+        rr=arb(prime);uu=(rr.log()/3).exp();tt=(prime-1)*(uu-1)
+        ee=rr*rr+rr*uu*(uu-2)-(uu-1)**2
+        mm=4*math.ceil(float((tt*tt/(4*ee)).mid()))
+        assert mm<prime-1
+        tests.append(dict(q=prime,support_count=mm,cubic_u2_coefficient=str(3*Q(prime-1)*(mm-prime+1)*(mm-2*(prime-1))/mm**2)))
+    vandermonde=[]
+    for r in range(3,11):
+        xs=[s.Rational(2)+s.Rational(j+1,r+1) for j in range(r)]
+        jac=s.Matrix([[2*k*x**(k-1) for x in xs] for k in range(1,r+1)])
+        det=s.factor(jac.det());expected=2**r*s.factorial(r)
+        for i in range(r):
+            for j in range(i+1,r):expected*=xs[j]-xs[i]
+        assert det==expected and det!=0
+        vandermonde.append(dict(order=r,points=[str(x) for x in xs],determinant=str(det)))
+    return dict(first_failed_integrality_order=3,u2_coefficient=str(s.factor(rem.coeff(u,2))),tests=tests,
+                finite_order_repair_jacobians=vandermonde)
+
+def main():
+    result=dict(python=platform.python_version(),arb_bits=ctx.prec)
+    for key,fn in [('exact_curves',lambda:[exact_curve(q) for q in (17,37)]),
+                   ('cyclic_certificates',cyclic),('binary_diagnostics',binary),('moments',moments)]:
+        result[key]=fn()
+        (ROOT/'audit_results.json').write_text(json.dumps(result,indent=2))
+    for r in result['exact_curves']:print('EXACT_CURVE',json.dumps(r),flush=True)
+    for r in result['binary_diagnostics']:print('DIAGNOSTIC',json.dumps(r),flush=True)
+    print('MOMENTS',json.dumps(result['moments']),flush=True)
+    for p in ROOT.glob('*.py'):ast.parse(p.read_text())
+    manifest={p.name:hashlib.sha256(p.read_bytes()).hexdigest() for p in ROOT.iterdir()
+              if p.is_file() and p.name!='manifest.json' and p.suffix not in ('.so','.log')}
+    (ROOT/'manifest.json').write_text(json.dumps(manifest,indent=2))
+
+if __name__=='__main__':main()
diff --git a/.research/agents/tdense13_scratch/barrier_check.py b/.research/agents/tdense13_scratch/barrier_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..bdf791521a4848f1e838275b88a043936a3179a3
--- /dev/null
+++ b/.research/agents/tdense13_scratch/barrier_check.py
@@ -0,0 +1,80 @@
+"""Exact support geometry plus 180-bit Arb checks of the partial-convolution construction."""
+from pathlib import Path
+from fractions import Fraction as Q
+import json, math
+from flint import arb,ctx
+import sympy as sp
+ctx.prec=180
+ROOT=Path(__file__).resolve().parent
+
+def barrier(q,J):
+    # q is an integer cube in these rational checks. The paper proof covers every sufficiently large odd prime.
+    u=round(q**(1/3));assert u**3==q
+    H=4*u*u;C=q*u*(u-2);ell=u
+    residual=[None]+[Q(C-2*(u-1)*H if d==1 else C-H*H if d==2 else C) for d in range(1,J+1)]
+    assert all(v>0 for v in residual[1:])
+    special={0:(0,1),1:(1,1),q-1:(1,1)}
+    # Symbolic labels: 0=h0, 1=H, 1+d=dedicated-pair amplitude, J+2/J+3=repair levels.
+    levels=[arb(u-1),arb(H)]+[(arb(v.numerator)/v.denominator/(2*ell)).sqrt() for v in residual[1:]]
+    t=4*J+10
+    for d in range(1,J+1):
+        for _ in range(ell):
+            for a in (t,t+d,q-t,q-t-d):
+                assert a not in special;special[a]=(d+1,1)
+            t+=3*J+3
+    T=arb(q*(u-1))-levels[0]-2*levels[1]
+    E=arb(q*q+q*u*(u-2))-levels[0]**2-2*levels[1]**2
+    for d in range(1,J+1):
+        T-=4*ell*levels[d+1];E-=arb(2*residual[d].numerator)/residual[d].denominator
+    assert T.lower()>0 and E.lower()>0
+    ratio=T*T/E;m=4*math.ceil(float((3*ratio/8).mid()))
+    assert (arb(m)-ratio).lower()>0 and (2*ratio-m).lower()>0
+    mean=T/m;var=E/m-mean*mean
+    assert var.lower()>0 and (mean*mean-var).lower()>0
+    levels += [mean+var.sqrt(),mean-var.sqrt()]
+    assert (levels[1]-levels[-2]).lower()>0
+    for idx in range(m//2):
+        t+=2*J+2
+        label=J+2 if idx<m//4 else J+3
+        for a in (t,q-t):assert a not in special;special[a]=(label,1)
+    assert t+3*J<q//2
+    correlations=[]
+    for d in range(1,J+1):
+        counts={}
+        for a,(la,_) in special.items():
+            b=(a+d)%q
+            if b in special:
+                lb=special[b][0];key=tuple(sorted((la,lb)))
+                counts[key]=counts.get(key,0)+1
+        expected={(d+1,d+1):2*ell}
+        if d==1:expected[(0,1)]=2
+        if d==2:expected[(1,1)]=1
+        assert counts==expected,(d,counts,expected)
+        value=sum((mult*levels[a]*levels[b] for (a,b),mult in counts.items()),arb(0))
+        assert (value-C).contains(0)
+        correlations.append(dict(gamma=d,exact_monomial_counts={str(k):v for k,v in counts.items()},
+                                 residual_ball=str(value-C)))
+    mass=levels[0]+2*levels[1]+sum((4*ell*levels[d+1] for d in range(1,J+1)),arb(0))+m*mean
+    energy=levels[0]**2+2*levels[1]**2+sum((4*ell*levels[d+1]**2 for d in range(1,J+1)),arb(0))+m*(mean*mean+var)
+    assert (mass-q*(u-1)).contains(0)
+    assert (energy-(q*q+q*u*(u-2))).contains(0)
+    return dict(q=q,prime=False,J=J,u=u,repair_sites=m,support_sites=len(special),last_positive=t,
+                K_sign=u,Lambda_sign=H-u,mass_residual=str(mass-q*(u-1)),
+                energy_residual=str(energy-(q*q+q*u*(u-2))),correlations=correlations,
+                status='Exact support-count check and Arb arithmetic; infinite-prime claim proved in report')
+
+def fake_cubic():
+    # Work in Q[u]/(u^3-q); m is the even support count of R12-S.
+    u,q,m=sp.symbols('u q m')
+    T=(q-1)*(u-1)
+    E=q*q+q*u*(u-2)-(u-1)**2
+    H=T/m;v=E/m-H*H
+    moment=sp.expand(m*((H-u)**3+3*(H-u)*v)+(q-1-m)*(-u)**3)
+    rem=sp.rem(moment,u**3-q,u)
+    return dict(sign_third_moment=str(sp.factor(rem)),coefficients={str(k):str(sp.factor(rem.coeff(u,k))) for k in range(3)},
+                note='Nonzero u or u^2 coefficient implies irrationality for prime q.')
+
+if __name__=='__main__':
+    result=dict(barrier=[barrier(u**3,J) for u,J in ((200,3),(400,5),(800,8))],fake_cubic=fake_cubic())
+    (ROOT/'barrier_checks.json').write_text(json.dumps(result,indent=2))
+    print(json.dumps(result,indent=2),flush=True)
diff --git a/.research/agents/tdense13_scratch/binary_probe.py b/.research/agents/tdense13_scratch/binary_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..6893baee74ec6aec3cb49acf6c24d833fd651704
--- /dev/null
+++ b/.research/agents/tdense13_scratch/binary_probe.py
@@ -0,0 +1,117 @@
+"""Profile-preserving binary laws. FFT estimates, refined dips, Arb point certificates."""
+from pathlib import Path
+import ctypes,json,math,subprocess,sys,gc,platform
+import numpy as np
+from scipy.optimize import minimize_scalar
+from sympy import nextprime
+import gurobipy as gp
+from gurobipy import GRB
+from flint import arb,ctx
+ctx.prec=180
+ROOT=Path(__file__).resolve().parent
+
+def profile(X):
+    rows=[json.loads(l) for l in open('examples/e82/e82.jsonl')]
+    row=max((r for r in rows if r['N']==320),key=lambda r:r['D'])
+    g=np.array(row['g']);w0=np.r_[np.correlate(g,g,'full')[319:]/(g@g),0]
+    w=np.interp(np.arange(1,X+1)/X,np.arange(321)/320,w0)
+    return (1-np.sqrt(np.maximum(0,1-w*w)))/2,w
+
+def prime1(x):
+    q=int(nextprime(max(4,int(x)-1)))
+    while q%4!=1:q=int(nextprime(q))
+    return q
+
+def counted(p,scores,B=256):
+    out=np.zeros(len(p),dtype=np.uint8);carry=0.
+    for lo in range(0,len(p),B):
+        hi=min(lo+B,len(p));target=float(p[lo:hi].sum())+carry
+        cnt=int(round(target));carry=target-cnt
+        take=np.argsort(-scores[lo:hi],kind='stable')[:cnt]+lo;out[take]=1
+    return out
+
+def minimum(bits):
+    X=len(bits);A=np.flatnonzero(bits).astype(np.int64)+1
+    L=1<<(16*(X+1)-1).bit_length();coef=np.zeros(X+1);coef[1:]=bits
+    vals=np.fft.rfft(coef,n=L).real
+    js=np.argpartition(vals,min(16,len(vals)-1))[:16]
+    j=int(vals.argmin());best=float(vals[j]);phase=j/L
+    del vals;gc.collect()
+    def f(t):return float(np.cos(2*np.pi*A*t).sum())
+    for jj in js:
+        sol=minimize_scalar(f,bounds=(max(0,(jj-1)/L),min(.5,(jj+1)/L)),method='bounded',
+                            options={'xatol':1e-16,'maxiter':40})
+        if sol.fun<best:best=float(sol.fun);phase=float(sol.x)
+    # Evaluate an exact rational phase, so the point is unambiguous and independently reproducible.
+    den=1<<60;num=int(round(phase*den));v=arb(0)
+    for a in A:v+=(2*arb.pi()*int((int(a)*num)%den)/den).cos()
+    assert v.upper()<0
+    return dict(X=X,n=len(A),actual_max=int(A[-1]),M_estimate=-best,R_estimate=-best/math.sqrt(len(A)),
+                M_over_sqrtX=-best/math.sqrt(X),phase_num=num,phase_den=den,FFT_length=L,
+                point_ball=str(v),M_point_interval=[float(np.nextafter(-float(v.upper()),-np.inf)),
+                                                    float(np.nextafter(-float(v.lower()),np.inf))],
+                certificate_status='Arb point dip; global minimum NUMERICAL',arb_bits=ctx.prec),A
+
+def save(family,bits,extra):
+    row,A=minimum(bits);row.update(family=family,**extra)
+    np.savez_compressed(ROOT/(family+'_X'+str(len(bits))+'.npz'),A=A)
+    with open(ROOT/'binary_results.jsonl','a') as fh:fh.write(json.dumps(row)+'\n')
+    print(json.dumps(row),flush=True)
+    if row['R_estimate']<.56:
+        raise RuntimeError('Promising R<0.56: require all-x Arb certification before continuing.')
+    return row
+
+def diffusion(p,w,X):
+    # Initial adverse frequencies are the worst residual dips of a deterministic counted random seed.
+    rng=np.random.default_rng(1913+X);b=counted(p,rng.random(X))
+    L=1<<(4*(X+1)-1).bit_length();c=np.zeros(X+1);c[1:]=b-p
+    vals=np.fft.rfft(c,n=L).real;idx=np.argpartition(vals,48)[:48]
+    angles=np.r_[2*np.pi*idx/L,2*np.pi*rng.random(16)].astype(np.float64)
+    so=ROOT/'diffuse.so'
+    if not so.exists():subprocess.run(['cc','-O3','-shared','-fPIC',str(ROOT/'diffuse.c'),'-o',str(so),'-lm'],check=True)
+    lib=ctypes.CDLL(str(so));fn=lib.diffuse
+    ptr=ctypes.POINTER(ctypes.c_double)
+    fn.argtypes=[ctypes.c_int,ctypes.c_int,ctypes.c_int,ptr,ptr,ptr,ctypes.POINTER(ctypes.c_ubyte)]
+    out=np.zeros(X,dtype=np.uint8)
+    fn(X,len(angles),256,p.ctypes.data_as(ptr),w.ctypes.data_as(ptr),angles.ctypes.data_as(ptr),
+       out.ctypes.data_as(ctypes.POINTER(ctypes.c_ubyte)))
+    return out
+
+def milp(X):
+    p,w=profile(X);B=16;target=counted(p,np.cos(np.arange(X)));cuts=np.arange(16*X+1)/(32*X)
+    b0=target
+    for it in range(3):
+        model=gp.Model();model.Params.OutputFlag=0;model.Params.Threads=4;model.Params.TimeLimit=10
+        model.Params.Seed=1913
+        b=model.addMVar(X,vtype=GRB.BINARY);M=model.addVar(lb=0)
+        b.Start=b0
+        for lo in range(0,X,B):model.addConstr(b[lo:lo+B].sum()==int(target[lo:lo+B].sum()))
+        for cs in np.array_split(cuts,16):
+            C=np.cos(2*np.pi*np.outer(cs,np.arange(1,X+1)))
+            model.addConstr(C@b+M>=0)
+        model.setObjective(M);model.optimize()
+        if not model.SolCount:break
+        b0=(b.X>.5).astype(np.uint8)
+        row,A=minimum(b0);cuts=np.r_[cuts,row['phase_num']/row['phase_den']]
+    return save('gurobi_round',b0,dict(block=B,solver=gp.gurobi.version(),solver_status=int(model.Status),
+                    solver_bound=float(model.ObjBound),grid_objective=float(model.ObjVal),iterations=3))
+
+def main():
+    (ROOT/'binary_results.jsonl').write_text('')
+    for X in (4096,65536,1048576):
+        p,w=profile(X);k=np.arange(1,X+1)
+        for theta in (.5,2/3,1.):
+            q=prime1(X**theta);chi=np.zeros(q);r=np.arange(1,(q+1)//2,dtype=np.int64)
+            chi[(r*r)%q]=1
+            rng=np.random.default_rng(191300+q);tie=rng.random((q+1)//2)
+            scores=chi[k%q]+tie[np.minimum(k%q,(-k)%q)]*.1
+            save('paley_'+str(theta),counted(p,scores),dict(q=q,theta=theta,block=256,seed=191300+q))
+        for theta in (.5,1.):
+            q=prime1(X**theta)
+            # Near-interval local order, dilated by 3; exact block counts enforce the E82 profile.
+            scores=-np.minimum((3*k)%q,(-3*k)%q).astype(float)
+            save('nearinterval_'+str(theta),counted(p,scores),dict(q=q,theta=theta,dilation=3,block=256))
+        save('spectral_diffusion',diffusion(p,w,X),dict(modes=64,block=256,seed=1913+X))
+    for X in (128,256):milp(X)
+
+if __name__=='__main__':main()
diff --git a/.research/agents/tdense13_scratch/cyclic_probe.py b/.research/agents/tdense13_scratch/cyclic_probe.py
new file mode 100644
index 0000000000000000000000000000000000000000..77f787dd2ead3ee8443f7f3a81ee448bb8232c3a
--- /dev/null
+++ b/.research/agents/tdense13_scratch/cyclic_probe.py
@@ -0,0 +1,89 @@
+"""Round 13 cyclic trade-offs and profile rounding. Run only via dirun -c 4."""
+from pathlib import Path
+import json, math, re, platform, time
+import numpy as np
+import gurobipy as gp
+from gurobipy import GRB
+from flint import arb, ctx
+ctx.prec=180
+ROOT=Path(__file__).resolve().parent
+
+def balls(q, pairs):
+    values=[]
+    for g in range(1,(q+1)//2):
+        v=arb(0)
+        for a in pairs:v+=2*(2*arb.pi()*((g*a)%q)/q).cos()
+        values.append(v)
+    lo=min(float(v.lower()) for v in values);hi=min(float(v.upper()) for v in values)
+    llo=max(float(v.lower()) for v in values);lhi=max(float(v.upper()) for v in values)
+    imin=min(range(len(values)),key=lambda i:float(values[i].mid()))
+    imax=max(range(len(values)),key=lambda i:float(values[i].mid()))
+    return dict(K_interval=[float(np.nextafter(-hi,-np.inf)),float(np.nextafter(-lo,np.inf))],
+                Lambda_interval=[float(np.nextafter(llo,-np.inf)),float(np.nextafter(lhi,np.inf))],
+                K_ball=str(-values[imin]),Lambda_ball=str(values[imax]),arb_bits=ctx.prec)
+
+def tradeoffs():
+    known={}
+    for fn in ('e41_small.txt','e41_mid.txt'):
+        for line in (Path('examples/zp_half')/fn).read_text().splitlines():
+            mm=re.search(r'p=(\d+).*minM=([\d.]+).*P=([\d ]+)',line)
+            if mm:known[int(mm[1])]=(float(mm[2]),[int(x) for x in mm[3].split()])
+    out=[]
+    for q in (17,37,61,89,101,109):
+        h=(q-1)//2;m=(q-1)//4
+        C=2*np.cos(2*np.pi*np.outer(np.arange(1,h+1),np.arange(1,h+1))/q)
+        if q in known:kmin,seed=known[q];kmin_status='E41 double-precision enumeration, quoted'
+        else:
+            model=gp.Model();model.Params.OutputFlag=0;model.Params.Threads=4;model.Params.TimeLimit=8
+            model.Params.Seed=1913
+            b=model.addMVar(h,vtype=GRB.BINARY);kk=model.addVar(lb=0)
+            model.addConstr(b.sum()==m);model.addConstr(C@b+kk>=0)
+            model.setObjective(kk);model.optimize()
+            seed=(np.flatnonzero(b.X>.5)+1).tolist();kmin=float(kk.X)
+            kmin_status=f'Gurobi status {model.Status}, bound {model.ObjBound}'
+        seedarr=np.zeros(q);seedarr[seed]=1;seedarr[[-x for x in seed]]=1
+        F=np.fft.fft(seedarr).real;g=int(np.argmax(F[1:])+1)
+        seed=sorted(set(min((g*a)%q,q-(g*a)%q) for a in seed))
+        kbase=balls(q,seed)['K_interval'][1]
+        for factor in (1,1.025,1.075,1.15,1.35,1.7):
+            kap=kbase*factor+2e-8
+            model=gp.Model();model.Params.OutputFlag=0;model.Params.Threads=4
+            model.Params.TimeLimit=5 if q<=61 else 8
+            model.Params.MIPGap=0;model.Params.FeasibilityTol=1e-9;model.Params.IntFeasTol=1e-9
+            model.Params.Seed=1913
+            b=model.addMVar(h,vtype=GRB.BINARY,name='pair')
+            b.Start=np.isin(np.arange(1,h+1),seed).astype(float)
+            model.addConstr(b.sum()==m);model.addConstr(C@b>=-kap)
+            model.setObjective(C[0]@b,GRB.MAXIMIZE);model.optimize()
+            row=dict(q=q,kappa=kap,factor=factor,K_min_input=kbase,K_min_status=kmin_status,
+                     status=int(model.Status),runtime=model.Runtime,bound=model.ObjBound,
+                     solver=gp.gurobi.version(),solutions=model.SolCount)
+            if model.SolCount:
+                pairs=(np.flatnonzero(b.X>.5)+1).tolist()
+                row.update(pairs=pairs,objective=model.ObjVal,certificate=balls(q,pairs))
+            out.append(row)
+            (ROOT/'cyclic_tradeoffs.json').write_text(json.dumps(out,indent=2))
+            print(json.dumps({k:v for k,v in row.items() if k!='pairs'}),flush=True)
+    return out
+
+def profiles():
+    rows=[]
+    for q in (257,1021,4093,16381,65537):
+        rng=np.random.default_rng(1913000+q);h=(q-1)//2;m=(q-1)//4
+        a=np.arange(1,h+1);p=.5+.2*np.cos(2*np.pi*a/q)
+        bits=rng.random(h)<p
+        if bits.sum()>m:bits[rng.choice(np.flatnonzero(bits),int(bits.sum()-m),replace=False)]=False
+        elif bits.sum()<m:bits[rng.choice(np.flatnonzero(~bits),int(m-bits.sum()),replace=False)]=True
+        pairs=(np.flatnonzero(bits)+1).tolist();b=np.zeros(q);b[pairs]=1;b[[-a for a in pairs]]=1
+        F=np.fft.fft(b).real
+        row=dict(q=q,epsilon=.2,seed=1913000+q,n=int(b.sum()),K=float(-F[1:].min()),
+                 Lambda=float(F[1:].max()),lambda1=float(F[1]),pairs=pairs)
+        if q<=1021:row['certificate']=balls(q,pairs)
+        rows.append(row)
+        (ROOT/'cyclic_profiles.json').write_text(json.dumps(rows,indent=2))
+        print('PROFILE',json.dumps({k:v for k,v in row.items() if k!='pairs'}),flush=True)
+    return rows
+
+if __name__=='__main__':
+    print(platform.python_version(),np.__version__,gp.gurobi.version(),flush=True)
+    profiles();tradeoffs()
