"""Gurobi adversarial design of symmetric nested schedules, VM only."""
from pathlib import Path
import json, time, math
import numpy as np
import gurobipy as gp
from gurobipy import GRB

ROOT=Path(__file__).resolve().parent
def solve(n,B,count):
    reps=np.arange(1,(n+1)//2);times=(np.arange(B)+.5)/B
    xis=np.unique(np.r_[np.linspace(0,60,121),np.linspace(.1,4,20)])
    model=gp.Model('round12_schedule');model.Params.Threads=4;model.Params.TimeLimit=55
    model.Params.Seed=1912;model.Params.OutputFlag=0
    a=model.addVars(len(reps),B,vtype=GRB.BINARY,name='assign')
    mu=model.addVar(lb=0,name='mu')
    for c in range(len(reps)):model.addConstr(gp.quicksum(a[c,j] for j in range(B))<=1)
    for j in range(B):model.addConstr(gp.quicksum(a[c,j] for c in range(len(reps)))==count)
    for s in range((n+1)//2):
        cos=2*np.cos(2*np.pi*s*reps/n)/n
        for xi in xis:
            v=times*np.sinc(xi*times/np.pi)
            model.addConstr(gp.quicksum(float(cos[c]*v[j])*a[c,j] for c in range(len(reps)) for j in range(B))+mu>=0)
    model.setObjective(mu,GRB.MINIMIZE);model.optimize()
    result=dict(N=n,B=B,count=count,status=int(model.Status),runtime=model.Runtime,
        bound=model.ObjBound,solutions=model.SolCount,solver=gp.gurobi.version())
    if model.SolCount:
        u=np.zeros(n)
        for c,r in enumerate(reps):
            for j in range(B):
                if a[c,j].X>.5:u[r]=u[-r]=times[j]
        from roughness_probe import analyze
        result.update(objective=model.ObjVal,probe=analyze(n,'gurobi_nested',u))
    (ROOT/f'milp_N{n}.json').write_text(json.dumps(result,indent=2))
    print(json.dumps(result|{'probe':{k:v for k,v in result.get('probe',{}).items() if k!='u'}}),flush=True)

if __name__=='__main__':
    solve(29,7,1)
    solve(61,5,3)
"""E82 — the reach of the CP-cone (second-order) macroscopic class.

Lead's reduction (NOTEBOOK cont. 12): the limiting residual energy profile e is (1/4 x) a mixture of |w|^2, w PD with
supp w in [-1,1] (Gabor-window identity applied to h = g + m >= 0), and p = (1 - sqrt(1 - 4e))/2 (a <= 1/2). By
convexity of phi(x) = (1 - sqrt(1-x))/2 a single generator is extremal, so the second-order reach is 1/D with
    D = sup { int_0^1 phi(w(t)^2) dt :  w = G * G~ (autocorrelation), G >= 0 on [0,1], int G^2 = 1 }.
Weighted Fejer-packet escapes realise every such w (round-9 Task 3 with packet shape s, s^ = w), so 1/D is also the
EXACT limit of arguments using positivity + the two binary moment profiles. Triangle (G = 1): D >= (1 - pi/4)/2,
1/D <= 9.3196. Round-9 two-profile class (relaxation): 1/D >= 7.2674.

NUMERICAL: L-BFGS-B over step functions G (N cells), w = exact PWL interpolation of the discrete autocorrelation,
objective by 16-point Gauss-Legendre per cell. Starts: constant, half-sine, random, centre-peaked.
Output: examples/e82/e82.jsonl.  Usage: python src/e82_cp_reach.py N1 N2 ...
Mode E82_MODE=lam with E82_LAM=4a(1-a): sup int phi(lam w^2), the reach under a front cap p(0) <= a (cont. 16.1).
"""
import json
import os
import sys

import numpy as np
from scipy.optimize import minimize

GX, GW = np.polynomial.legendre.leggauss(16)
GX = (GX + 1) / 2
GW = GW / 2


def phi(x):
    return (1 - np.sqrt(np.clip(1 - x, 0, None))) / 2


def dphi(x):
    return 0.25 / np.sqrt(np.clip(1 - x, 1e-300, None))


MODE = os.environ.get("E82_MODE", "D")  # D: int phi(w^2); N2: int w^2; ratio: int phi(w^2) / int w^2


def objective(g, N):
    if MODE == "D":
        return objective_f(g, N, phi, dphi)
    if MODE == "N2":
        return objective_f(g, N, lambda x: x, lambda x: np.ones_like(x))
    if MODE == "lam":  # front cap a* <= 1/2: p = phi(lam w^2), lam = 4a*(1 - a*)  (NOTEBOOK cont. 16.1)
        lam = float(os.environ["E82_LAM"])
        return objective_f(g, N, lambda x: phi(lam * x), lambda x: lam * dphi(lam * x))
    F1, G1 = objective_f(g, N, phi, dphi)
    F2, G2 = objective_f(g, N, lambda x: x, lambda x: np.ones_like(x))
    return F1 / F2, (G1 * F2 - F1 * G2) / F2 ** 2


def objective_f(g, N, phi, dphi):
    S = g @ g
    c = np.correlate(g, g, mode="full")[N - 1:] / S  # c_0..c_{N-1}
    c = np.append(c, 0.0)  # c_N = 0
    a, b = c[:-1, None], c[1:, None]
    w = a + (b - a) * GX[None, :]  # N cells x 16
    w2 = w * w
    F = (phi(w2) * GW[None, :]).sum() / N
    dw = 2 * w * dphi(w2) * GW[None, :] / N  # dF/dw at nodes
    dc = np.zeros(N + 1)
    dc[:-1] += (dw * (1 - GX[None, :])).sum(1)
    dc[1:] += (dw * GX[None, :]).sum(1)
    dc[0] = 0.0  # c_0 == 1 identically
    # c_k = sum_j g_j g_{j+k} / S ; dc_k/dg_j = (g_{j+k} + g_{j-k})/S - 2 c_k g_j / S
    dcN = dc[:N]
    cc = c[:N]
    grad = np.zeros(N)
    for k in range(1, N):
        if dcN[k] == 0:
            continue
        grad[:N - k] += dcN[k] * g[k:]
        grad[k:] += dcN[k] * g[:N - k]
    grad = grad / S - 2 * (dcN @ cc) * g / S
    return F, grad


R = 4 / (3 * np.sqrt(3))


def window_check(g, N):
    """Sanity: the D-optimiser must satisfy every P31 window (they are consequences of positivity)."""
    c = np.append(np.correlate(g, g, mode="full")[N - 1:] / (g @ g), 0.0)
    t = np.linspace(0, 1, 20001)
    w = np.interp(t, np.arange(N + 1) / N, c)
    e, p = w * w / 4, phi(w * w)
    out = {}
    for name, v in (("e", e), ("p", p)):
        tot = np.trapezoid(v, t)
        worst = 1e9
        for th in np.concatenate([np.geomspace(1e-3, 1, 200), np.linspace(1, 20, 100)]):
            m = t <= th
            rhs = R * (1 + th) * np.trapezoid(((1 - t[m] / th) ** 2) * v[m], t[m])
            worst = min(worst, (rhs - (2 * th / 3) * tot) / tot)
        out["min_rel_slack_" + name] = worst
    return out


def run(N, start, seed, fh):
    rng = np.random.default_rng(seed)
    x = (np.arange(N) + 0.5) / N
    if start == "const":
        g0 = np.ones(N)
    elif start == "halfsine":
        g0 = np.sin(np.pi * x)
    elif start == "peaked":
        g0 = np.exp(-((x - 0.5) / 0.2) ** 2)
    else:
        g0 = rng.random(N) + 0.1
    res = minimize(lambda g: tuple(-v for v in objective(g, N)), g0, jac=True, method="L-BFGS-B",
                   bounds=[(0, None)] * N, options={"maxiter": 20000, "maxfun": 40000, "ftol": 1e-15, "gtol": 1e-12})
    g = res.x / np.sqrt(res.x @ res.x / N)
    D, _ = objective(g, N)
    c = np.correlate(g, g, mode="full")[N - 1:] / (g @ g)
    row = {"mode": MODE, "N": N, "start": start, "seed": seed, "D": D, "C": 1 / D, "nit": int(res.nit), "msg": str(res.message),
           "int_w2_0_1": float(((np.append(c, 0)[:-1] ** 2 + np.append(c, 0)[1:] ** 2) / 2).sum() / N),
           **window_check(g, N), "g": np.round(g, 6).tolist()}
    fh.write(json.dumps(row) + "\n")
    fh.flush()
    print(json.dumps({k: v for k, v in row.items() if k != "g"}), flush=True)


def main():
    Ns = [int(a) for a in sys.argv[1:]] or [40, 80, 160]
    os.makedirs("examples/e82", exist_ok=True)
    out = "examples/e82/e82.jsonl" if MODE == "D" else f"examples/e82/e82_{MODE}.jsonl"
    if MODE == "lam":
        out = f"examples/e82/e82_lam{os.environ['E82_LAM']}.jsonl"
    # sanity: triangle value
    N = 400
    print("triangle check", objective(np.ones(N), N)[0], (1 - np.pi / 4) / 2, flush=True)
    with open(out, "w") as fh:
        for N in Ns:
            starts = (("const", 0), ("halfsine", 0), ("peaked", 0), ("random", 1), ("random", 2)) if N <= 80 else \
                (("halfsine", 0), ("random", 1))
            for start, seed in starts:
                run(N, start, seed, fh)


if __name__ == "__main__":
    main()
"""E23: dense regime with a FIXED positive-definite profile — how good can the 0/1 rounding be?

Dense heuristic (E16): R = c_E sqrt((1-ρ)/2) with ρ = ∫w²/∫w; beating 1/2 needs c_E < 1/sqrt(2(1-ρ)).  Here the profile w
on [0,1] is fixed (p.d. after even extension), A ⊂ [1, X] starts as a sigma-delta rounding of w(n/X), and LNS moves with
CONTIGUOUS windows only (counts per window preserved, so the profile is kept at the window scale) minimise M(A).
Reports R and c_E := (M - main(x*)) / sigma_E with sigma_E^2 = Σ (1_A - w)^2 / 2 and main(x*) = Σ w_n cos(n x*)
(the smooth part at the minimiser).  Minima: FFT + Newton (box_minlam.true_min), UNCERTIFIED.
Usage: python src/profile_rounding.py X profile steps seed [win]      profile in {tri, gauss, fejer2}
"""
import sys, math, json, time
import numpy as np
sys.path.insert(0, 'src')
from box_minlam import true_min
from lns_milp import window_solve


def profile(name, t):
    if name == 'tri':                       # autocorrelation of a box: ŵ = sinc² >= 0, ρ = 2/3
        return np.clip(1 - t, 0, 1)
    if name == 'gauss':                     # Gaussian, truncated at t = 1 (w(1) ≈ 0.017): ρ ≈ 0.707
        return np.exp(-t ** 2 / (2 * 0.35 ** 2))
    if name == 'fejer2':                    # autocorrelation of a triangle (cubic B-spline shape), ρ ≈ 0.72
        s = 2 * t
        return np.where(s <= 1, 1 - 1.5 * s ** 2 + 0.75 * s ** 3, np.where(s <= 2, 0.25 * (2 - s) ** 3, 0.0))
    raise ValueError(name)


def sigma_delta(w):
    A, acc = [], 0.0
    for n, wn in enumerate(w, start=1):
        acc += wn
        if acc >= 0.5:
            A.append(n); acc -= 1.0
    return A


def report(A, w, X):
    (fm, xm), v, G = true_min(A)
    n = np.arange(1, X + 1); ind = np.zeros(X); ind[np.array(A) - 1] = 1
    main = float((w * np.cos(n * xm)).sum()); sig = math.sqrt(((ind - w) ** 2).sum() / 2)
    rho = float((w ** 2).sum() / w.sum())
    return dict(M=-fm, R=-fm / math.sqrt(len(A)), x=xm, main=main, cE=(-fm + main) / sig, rho=rho,
                need_cE=1 / math.sqrt(2 * (1 - rho)), N=len(A))


if __name__ == "__main__":
    X = int(sys.argv[1]); name = sys.argv[2]; steps = int(sys.argv[3]); seed = int(sys.argv[4])
    win = int(sys.argv[5]) if len(sys.argv) > 5 else 24
    w = profile(name, np.arange(1, X + 1) / X)
    A = sigma_delta(w)
    print("start", json.dumps(report(A, w, X)), flush=True)
    rng = np.random.default_rng(seed)
    cuts = set((np.pi * np.arange(4 * X + 1) / (4 * X)).tolist())
    (fm, xm), v, G = true_min(A); cur = -fm; t0 = time.time()
    for st in range(steps):
        s = int(rng.integers(1, max(2, X - win + 2))); W = list(range(s, min(X, s + win - 1) + 1))
        r = window_solve(A, W, X, cuts, tl=10.0)
        if r is not None and r[0] < cur - 1e-9:
            cur, A = r
            print(f"step {st}: M={cur:.4f} R={cur / math.sqrt(len(A)):.4f} t={time.time() - t0:.0f}s", flush=True)
    out = report(A, w, X); out.update(X=X, profile=name, seed=seed, A=A)
    print(json.dumps(out), flush=True)
# Research-review and continuation protocol

A research review is not a worker status digest. It is a decision about the **entire attempt to solve the stated problem**.

## Trigger

Perform after two structurally different attempts, a substantive new obstruction, duplicated work, repeated zero-novelty searches, or just before finishing an extended research task.

## Compare options

For each candidate route, ask:

1. **Target relevance:** If the next lemma succeeds, exactly what part of the original theorem changes?
2. **Mechanism:** What mathematical property could make it true?
3. **Falsifiability:** What's a decisive calculation, specialization, counterexample, or intermediate proof?
4. **Uniqueness:** Is this a genuinely different approach from previous failures?
5. **Cost:** Is the best next move a 5-minute symbolic derivation, a bounded exact search, reading a named theorem, or an independent verifier?

Choose a route explicitly; do not continue by inertia. Do not infer probabilities from intuition and present them as estimates.

## Failure-to-discovery example (generic arithmetic geometry)

Bad: "The doubling law does not preserve integral points. Therefore I cannot derive more integral points; no advance."

Better:

- Compute denominator formulas for x(2P) and x(P±Q) on the exact Weierstrass model.
- Derive necessary valuation inequalities for integrality of the image; include primes dividing the discriminant and denominators.
- Test whether any nontrivial family satisfies these inequalities. Try to falsify the naive integrality lemma with explicit P,Q.
- If false, determine whether a restricted class (specified torsion, valuations, reduction type) admits a valid lemma; otherwise discard this mechanism and pursue another (e.g. inverse parametrization or independent local support arguments).
- Record the obstruction and the new exact condition or counterexample. Don't claim an integral group closure theorem.

## Team coordination

Do not create a parade of parallel agents that all "investigate the problem". Give each agent a distinct conjectured lemma, a source/derivation check, a falsification test, and an output file. Review returned artifacts (equations, code, citations). Terminate work that produces no decision-relevant information. Periodically decide *globally* whether the present program is worth continuing.

## Exit decisions

- **CONTINUE** if a concrete next lemma/test has plausible information value within the remaining budget.
- **PIVOT** if the obstruction invalidates the current mechanism and a distinct mechanism has an identifiable test.
- **STOP** if the user-imposed budget/permission has ended, the goal is resolved, or after serious attempts the available next tasks lack credible information value. Explain exactly why. Don't claim exhaustive impossibility from limited exploration.
- A review can be honest even with no new theorem; it should still contain a reproducible counterexample, new exact reduction, bounded computation, eliminated conditional assumption, or a clear explanation of why existing directions were tested and discarded.

## Optional ledger helper

Run `python3 <skill-folder>/scripts/research_log.py --help` for `init`, `attempt`, `review`, `status`, and `audit` commands. The audit detects missing attempt/review records, but cannot determine whether the mathematical derivations or reported tests are genuine. Use it to catch omissions, not to reward checklist completion.

