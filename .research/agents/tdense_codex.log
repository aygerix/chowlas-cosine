+"""Exact polynomial certificate for fixed-multiplier profile obstruction.
+Run on VM through dirun.sh. No numerical optimization.
+"""
+import json
+from pathlib import Path
+import sympy as s
+
+t,z,u = s.symbols("t z u", real=True)
+p = (1-t)**4/2
+rows = []
+for name,e in [("variance",p*(1-p)),("square",p*p)]:
+    e = s.expand(e)
+    E = s.integrate(e,(t,0,1))
+    S = s.expand(z*s.integrate(e.subs(t,z*u)*(1-u)**2,(u,0,1)))
+    D = s.Poly(s.expand((1+z)*S/z-E),z)
+    n = D.degree()
+    bern = [s.factor(sum(D.nth(k)*s.binomial(i,k)/s.binomial(n,k)
+                        for k in range(i+1))) for i in range(n+1)]
+    assert all(b>=0 for b in bern), bern
+    mu1 = s.integrate(t*e,(t,0,1))/E
+    mu2 = s.integrate(t*t*e,(t,0,1))/E
+    assert mu1<=s.Rational(1,4)
+    rows.append({"name":name,"e":str(e),"E":str(E),"S":str(S),
+                 "D":str(D.as_expr()),"bernstein_degree":n,
+                 "bernstein_coefficients":list(map(str,bern)),
+                 "mu1":str(mu1),"mu2":str(mu2)})
+result = {"status":"EXACT polynomial certificate PASS", "profiles":rows}
+Path(".research/agents/tdense_scratch/barrier.json").write_text(json.dumps(result,indent=2))
+print(json.dumps(result),flush=True)
