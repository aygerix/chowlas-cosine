+    ds = (32, 16, 8, 4, 2, 1) if fine else (8, 4, 2, 1)
+    Hs = sorted({max(1, X//d) for d in ds})
+    p28 = []
+    for H in Hs:
+        sup = np.zeros(G)
+        for m in range(H, X+H, max(1, H//(4 if fine else 2))):
