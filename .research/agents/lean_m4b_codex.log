  let m := (n, 0)
  use Finset.Iic m, 2 ^ n * ∫ x : D, (1 + ‖x‖) ^ (- (n : ℝ)) ∂μ
  refine ⟨by positivity, fun f ↦ (norm_integral_le_integral_norm f).trans ?_⟩
  have h' : ∀ x, ‖f x‖ ≤ (1 + ‖x‖) ^ (-(n : ℝ)) *
      (2 ^ n * ((Finset.Iic m).sup (fun m' => SchwartzMap.seminorm 𝕜 m'.1 m'.2) f)) := by
    intro x
    rw [rpow_neg (by positivity), ← div_eq_inv_mul, le_div_iff₀' (by positivity), rpow_natCast]
    simpa using one_add_le_sup_seminorm_apply (m := m) (k := n) (n := 0) le_rfl le_rfl f x
  apply (integral_mono (by simpa using f.integrable_pow_mul μ 0) _ h').trans
  · unfold schwartzSeminormFamily
    rw [integral_mul_const, ← mul_assoc, mul_comm (2 ^ n)]
  apply h.mul_const

variable (𝕜) in
@[simp]
lemma integralCLM_apply (f : 𝓢(D, V)) : integralCLM 𝕜 μ f = ∫ x, f x ∂μ := by rfl

end Integration

section BoundedContinuousFunction
    28	/-- Equality of the distributions of two Lp functions implies actual
    29	a.e. equality, even if their exponents differ. -/
    30	theorem lp_ae_eq_of_tempered_eq {p q : ℝ≥0∞} [hp : Fact (1 ≤ p)] [hq : Fact (1 ≤ q)]
    31	    (f : Lp (α := ℝ) ℂ p volume) (g : Lp (α := ℝ) ℂ q volume)
    32	    (h : (f : TemperedDistribution ℝ ℂ) = (g : TemperedDistribution ℝ ℂ)) :
    33	    (f : ℝ → ℂ) =ᵐ[volume] g := by
    34	  apply ae_eq_of_integral_contDiff_smul_eq (Lp.memLp f |>.locallyIntegrable hp.out)
    35	    (Lp.memLp g |>.locallyIntegrable hq.out)
    36	  intro ψ hψc hψs
    37	  have hφs : HasCompactSupport (Complex.ofRealCLM ∘ ψ) := hψs.comp_left rfl
    38	  have hφc : ContDiff ℝ ∞ (Complex.ofRealCLM ∘ ψ) := by fun_prop
    39	  let φ : 𝓢(ℝ, ℂ) := hφs.toSchwartzMap hφc
    40	  have H := congrArg (fun T : TemperedDistribution ℝ ℂ => T φ) h
    41	  simpa only [Lp.toTemperedDistribution_apply, φ, HasCompactSupport.toSchwartzMap_coe,
    42	    Function.comp_apply, Complex.ofRealCLM_apply, Complex.real_smul] using H
    43	
    44	/-- The classical Fourier transform of an L1 function is bounded and
    45	therefore gives an L∞ representative. -/
    46	theorem memLp_top_fourier_of_integrable {f : ℝ → ℂ} (hf : Integrable f) :
    47	    MemLp (𝓕 f) ∞ volume := by
    48	  have hm : AEStronglyMeasurable (𝓕 f) volume := by
    49	    have H := VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar
    50	      (L := innerₗ ℝ) continuous_inner hf
    51	    exact H.aestronglyMeasurable
    52	  apply memLp_top_of_bound hm (∫ x : ℝ, ‖f x‖)
    53	  apply Filter.Eventually.of_forall
    54	  intro x
    55	  exact VectorFourier.norm_fourierIntegral_le_integral_norm Real.fourierChar volume (innerₗ ℝ) f x
    56	
    57	/-- Classical Fourier transformation and distributional transformation
    58	agree on L1 functions, with no Schwartz assumption. -/
    59	theorem fourier_lp_one_tempered {f : ℝ → ℂ} (hf : Integrable f) :
    60	    (𝓕 (((memLp_one_iff_integrable.mpr hf).toLp f) : TemperedDistribution ℝ ℂ)) =
    61	      (((memLp_top_fourier_of_integrable hf).toLp (𝓕 f)) : TemperedDistribution ℝ ℂ) := by
    62	  ext φ
    63	  simp only [TemperedDistribution.fourier_apply, Lp.toTemperedDistribution_apply]
    64	  have hf1 := (memLp_one_iff_integrable.mpr hf).coeFn_toLp
    65	  have hfF := (memLp_top_fourier_of_integrable hf).coeFn_toLp
    66	  have hleft : (∫ x : ℝ, (𝓕 φ) x • ((memLp_one_iff_integrable.mpr hf).toLp f) x) =
    67	      ∫ x : ℝ, (𝓕 φ) x * f x := by
    68	    apply integral_congr_ae
    69	    filter_upwards [hf1] with x hx
    70	    simp only [hx, smul_eq_mul]
    71	  have hright : (∫ x : ℝ, φ x • ((memLp_top_fourier_of_integrable hf).toLp (𝓕 f)) x) =
    72	      ∫ x : ℝ, φ x * (𝓕 f) x := by
    73	    apply integral_congr_ae
    74	    filter_upwards [hfF] with x hx
    75	    simp only [hx, smul_eq_mul]
    76	  rw [hleft, hright]
    77	  simpa only [Real.fourier_eq, SchwartzMap.fourier_coe, smul_eq_mul,
    78	    LinearMap.flip_def, real_inner_comm] using
    79	    VectorFourier.integral_fourierIntegral_smul_eq_flip (L := innerₗ ℝ)
    80	      Real.continuous_fourierChar continuous_inner φ.integrable hf
    81	
    82	end ChowlaCosine.P31

