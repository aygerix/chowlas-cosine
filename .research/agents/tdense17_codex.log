+           if abs((a*math.sqrt(2)+.5)%1-.5)<.28
+           and abs((a*math.sqrt(3)+.5)%1-.5)<.28]
+        sets.append((f'many_Bohr_{pieces}_gap1000',A))
+    recs=[]
+    for name,A in sets:
+        rec=metrics(A,fine=False);rec['name']=name
