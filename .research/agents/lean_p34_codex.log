/-! # From the elementary coefficient bound to analytic Nikolskii

Finite Fourier orthogonality is exact, including repeated pair frequencies.
-/

open Real MeasureTheory
open scoped BigOperators

namespace ChowlaCosine.P31

@[fun_prop] theorem continuous_circleCharacter (k : ℤ) : Continuous (circleCharacter k) := by
  unfold circleCharacter
  fun_prop

theorem circleCharacter_add (k m : ℤ) (x : ℝ) :
    circleCharacter (k + m) x = circleCharacter k x * circleCharacter m x := by
  unfold circleCharacter
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem circleCharacter_star (k : ℤ) (x : ℝ) :
    star (circleCharacter k x) = circleCharacter (-k) x := by
  simp [circleCharacter, Complex.star_def, ← Complex.exp_conj]

theorem circleMean_re_mul_character (c : ℂ) (k : ℤ) :
    circleMean (fun x => (c * circleCharacter k x).re) = if k = 0 then c.re else 0 := by
  by_cases hk : k = 0
  · subst k
    simp [circleCharacter]
  · rw [if_neg hk]
    have hre : ∀ x : ℝ, (circleCharacter k x).re = Real.cos ((k : ℝ) * x) := by
      intro x
      unfold circleCharacter
      have harg : (k : ℂ) * (x : ℂ) * Complex.I = (((k : ℝ) * x : ℝ) : ℂ) * Complex.I := by
        push_cast
        ring
      rw [harg, Complex.exp_ofReal_mul_I_re]
    have him : ∀ x : ℝ, (circleCharacter k x).im = Real.sin ((k : ℝ) * x) := by
      intro x
      unfold circleCharacter
      have harg : (k : ℂ) * (x : ℂ) * Complex.I = (((k : ℝ) * x : ℝ) : ℂ) * Complex.I := by
        push_cast
        ring
      rw [harg, Complex.exp_ofReal_mul_I_im]
    unfold circleMean
    simp only [Complex.mul_re, hre, him]
    rw [intervalIntegral.integral_sub (by apply Continuous.intervalIntegrable; fun_prop)
      (by apply Continuous.intervalIntegrable; fun_prop), intervalIntegral.integral_const_mul,
      intervalIntegral.integral_const_mul, integral_cos_int_mul hk, integral_sin_int_mul]
    ring

/-- Parseval with arbitrary finite, possibly repeated, integer frequencies. -/
theorem circleMean_norm_sq_sum {ι : Type*} [Fintype ι] (u : ι → ℂ) (k : ι → ℤ) :
    circleMean (fun x => ‖∑ j : ι, u j * circleCharacter (k j) x‖ ^ 2) =
      ∑ i : ι, ∑ j : ι, if k i = k j then (u i * star (u j)).re else 0 := by
  classical
  have hpoint : ∀ x : ℝ, ‖∑ j : ι, u j * circleCharacter (k j) x‖ ^ 2 =
      ∑ i : ι, ∑ j : ι, ((u i * star (u j)) * circleCharacter (k i - k j) x).re := by
    intro x
    have hnorm : ∀ z : ℂ, ‖z‖ ^ 2 = (z * star z).re := by
      intro z
      rw [Complex.star_def, Complex.mul_conj, Complex.ofReal_re, Complex.normSq_eq_norm_sq]
    rw [hnorm, star_sum, Finset.sum_mul_sum]
    simp only [Complex.re_sum]
    apply Finset.sum_congr rfl
    intro i hi
    apply Finset.sum_congr rfl
    intro j hj
    congr 1
    rw [star_mul, circleCharacter_star, sub_eq_add_neg, circleCharacter_add]
    ring
  simp_rw [hpoint]
  rw [circleMean_sum Finset.univ _ (by intro i hi; fun_prop)]
  apply Finset.sum_congr rfl
  intro i hi
  rw [circleMean_sum Finset.univ _ (by intro j hj; fun_prop)]
  apply Finset.sum_congr rfl
  intro j hj
  rw [circleMean_re_mul_character]
  simp only [sub_eq_zero]

/-- Exact normalized second moment of an analytic coefficient vector. -/
theorem circleMean_analytic_sq (L : ℕ) (u : Fin (L + 1) → ℂ) :
    circleMean (fun x => ‖analyticValue u x‖ ^ 2) = ∑ j : Fin (L + 1), ‖u j‖ ^ 2 := by
  have heq : analyticValue u = fun x =>
      ∑ j : Fin (L + 1), u j * circleCharacter (j.val : ℤ) x := by
    funext x
    simp [analyticValue, circleCharacter]
  rw [heq, circleMean_norm_sq_sum]
  apply Finset.sum_congr rfl
  intro i hi
  have hiff : ∀ j : Fin (L + 1), ((i.val : ℤ) = (j.val : ℤ)) ↔ i = j := by
    intro j
    constructor
    · intro h
      apply Fin.ext
      exact_mod_cast h
    · rintro rfl
      rfl
  simp_rw [hiff]
  simp only [Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
  rw [Complex.star_def, Complex.mul_conj, Complex.ofReal_re, Complex.normSq_eq_norm_sq]

/-- The real four-index sum in the pair-frequency ordering is exactly
the ordered-pair energy used by P31-E. -/
theorem real_additive_quad_eq_energy (N : ℕ) (v : Fin N → ℝ) :
    (∑ p : Fin N × Fin N, ∑ q : Fin N × Fin N,
      if p.1.val + p.2.val = q.1.val + q.2.val then
        (v p.1 * v p.2) * (v q.1 * v q.2) else 0) = discreteEnergy N v := by
  unfold discreteEnergy
  simp only [Fintype.sum_prod_type]
  apply Finset.sum_congr rfl
  intro a ha
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro c hc
  apply Finset.sum_congr rfl
  intro b hb
  apply Finset.sum_congr rfl
  intro d hd
  split_ifs <;> ring

/-- The fourth circle moment is bounded by the real nonnegative coefficient energy. -/
theorem circleMean_analytic_four_le_energy (L : ℕ) (u : Fin (L + 1) → ℂ) :
    circleMean (fun x => ‖analyticValue u x‖ ^ 4) ≤
      discreteEnergy (L + 1) (fun j => ‖u j‖) := by
  have hsq : ∀ x : ℝ, analyticValue u x ^ 2 =
      ∑ p : Fin (L + 1) × Fin (L + 1), (u p.1 * u p.2) *
        circleCharacter ((p.1.val : ℤ) + p.2.val) x := by
    intro x
    rw [sq, analyticValue, Finset.sum_mul_sum, Fintype.sum_prod_type]
    apply Finset.sum_congr rfl
    intro i hi
    apply Finset.sum_congr rfl
    intro j hj
    rw [circleCharacter_add]
    simp only [circleCharacter, Int.cast_natCast]
    ring
  have hnorm : (fun x => ‖analyticValue u x‖ ^ 4) =
      (fun x => ‖∑ p : Fin (L + 1) × Fin (L + 1), (u p.1 * u p.2) *
        circleCharacter ((p.1.val : ℤ) + p.2.val) x‖ ^ 2) := by
    funext x
    rw [← hsq x, norm_pow, ← pow_mul]
  rw [hnorm, circleMean_norm_sq_sum, ← real_additive_quad_eq_energy]
  apply Finset.sum_le_sum
  intro p hp
  apply Finset.sum_le_sum
  intro q hq
  have heq : (((p.1.val : ℤ) + p.2.val = (q.1.val : ℤ) + q.2.val)) ↔
      p.1.val + p.2.val = q.1.val + q.2.val := by omega
  simp only [heq]
  split_ifs
  · have h := Complex.re_le_norm ((u p.1 * u p.2) * star (u q.1 * u q.2))
    simpa only [norm_mul, norm_star] using h
  · exact le_rfl

/-- The energy scales quartically. -/
theorem discreteEnergy_scale (N : ℕ) (v : Fin N → ℝ) (c : ℝ) :
    discreteEnergy N (fun j => c * v j) = c ^ 4 * discreteEnergy N v := by
  unfold discreteEnergy
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro p hp
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro q hq
  split_ifs <;> ring

/-- Homogeneous P31-E: no normalization hypothesis is needed. -/
theorem elementary_discreteEnergy_bound_homogeneous (N : ℕ) (v : Fin N → ℝ)
    (hv0 : ∀ j, 0 ≤ v j) :
    discreteEnergy N v ≤ ((811 / 1000 : ℝ) * N + 71 / 300) *
      (∑ j : Fin N, v j ^ 2) ^ 2 := by
  let t := ∑ j : Fin N, v j ^ 2
  have ht : 0 ≤ t := Finset.sum_nonneg (fun j hj => sq_nonneg _)
  by_cases ht0 : t = 0
  · have hvzero : ∀ j, v j = 0 := by
      intro j
      have hle := Finset.single_le_sum (fun k hk => sq_nonneg (v k)) (Finset.mem_univ j)
      change v j ^ 2 ≤ t at hle
      rw [ht0] at hle
      nlinarith [sq_nonneg (v j)]
    simp [discreteEnergy, hvzero]
  · have htp : 0 < t := lt_of_le_of_ne ht (Ne.symm ht0)
    have hs : Real.sqrt t ≠ 0 := (Real.sqrt_pos.mpr htp).ne'
    have hsq : (Real.sqrt t) ^ 2 = t := Real.sq_sqrt ht
    let w : Fin N → ℝ := fun j => (Real.sqrt t)⁻¹ * v j
    have hw0 : ∀ j, 0 ≤ w j := fun j => mul_nonneg (inv_nonneg.mpr (Real.sqrt_nonneg _)) (hv0 j)
    have hw : (∑ j : Fin N, w j ^ 2) = 1 := by
      simp only [w, mul_pow, ← Finset.mul_sum, inv_pow, hsq]
      exact inv_mul_cancel₀ ht0
    have h := elementary_discreteEnergy_bound N w hw0 hw
    rw [discreteEnergy_scale] at h
    have hinv : (Real.sqrt t)⁻¹ ^ 4 = (t ^ 2)⁻¹ := by
      rw [show (4 : ℕ) = 2 * 2 by rfl, pow_mul, inv_pow, hsq, inv_pow]
    rw [hinv] at h
    have hmul := mul_le_mul_of_nonneg_left h (sq_nonneg t)
    have hfinal : discreteEnergy N v ≤ t ^ 2 * ((811 / 1000 : ℝ) * N + 71 / 300) := by
      simpa only [← mul_assoc, mul_inv_cancel₀ (pow_ne_zero 2 ht0), one_mul] using hmul
    simpa only [t, mul_comm] using hfinal

/-- The elementary analytic Nikolskii constant, discharging T3's only
analytic inequality hypothesis without Beckner. -/
theorem elementary_analyticNikolskii (L : ℕ) :
    AnalyticNikolskii L ((811 / 1000 : ℝ) * (L + 1) + 71 / 300) := by
  intro u
  have h := (circleMean_analytic_four_le_energy L u).trans
    (elementary_discreteEnergy_bound_homogeneous (L + 1) (fun j => ‖u j‖) (fun j => norm_nonneg _))
  rw [circleMean_analytic_sq]
  simpa only [Nat.cast_add, Nat.cast_one] using h

end ChowlaCosine.P31
import ChowlaCosine.Basic

/-!
# Mean zero and Parseval for `f_A`

For a finite `A ⊆ ℕ` with all elements positive:

* `∫_0^{2π} f_A(x) dx = 0`;
* `∫_0^{2π} f_A(x)² dx = π |A|`, i.e. the normalized mean square
  `(1/2π) ∫_0^{2π} f_A² = |A| / 2`.

Distinctness of the frequencies is automatic (`A` is a `Finset`); positivity is required
(for `A = {0}` both identities fail).
-/

open Real

namespace ChowlaCosine

theorem intervalIntegrable_cos_mul (c : ℝ) (a b : ℝ) :
    IntervalIntegrable (fun x => Real.cos (c * x)) MeasureTheory.volume a b :=
  (by fun_prop : Continuous fun x => Real.cos (c * x)).intervalIntegrable _ _

/-- `∫_0^{2π} cos (a x) dx = 0` for a positive natural `a`. -/
theorem integral_cos_nat_mul {a : ℕ} (ha : 0 < a) :
    ∫ x in (0 : ℝ)..2 * π, Real.cos ((a : ℝ) * x) = 0 := by
  have h := integral_cos_int_mul (k := (a : ℤ)) (by exact_mod_cast ha.ne')
  simpa using h

/-- `∫_0^{2π} cos (a x) cos (b x) dx = π [a = b]` for positive naturals `a, b`. -/
theorem integral_cos_mul_cos_nat {a b : ℕ} (ha : 0 < a) (hb : 0 < b) :
    ∫ x in (0 : ℝ)..2 * π, Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x) =
      if a = b then π else 0 := by
  have h := integral_cos_mul_cos (a : ℤ) (b : ℤ) 0 0
  have hab : (a : ℤ) + b ≠ 0 := by omega
  rw [if_neg hab, add_zero] at h
  by_cases h' : a = b
  · have : (a : ℤ) - b = 0 := by omega
    rw [if_pos this] at h
    rw [if_pos h']
    simpa using h
  · have : (a : ℤ) - b ≠ 0 := by omega
    rw [if_neg this] at h
    rw [if_neg h']
    simpa using h

/-- **Mean zero.** `∫_0^{2π} f_A = 0` when every element of `A` is positive. -/
theorem integral_cosSum (A : Finset ℕ) (hA : ∀ a ∈ A, 0 < a) :
    ∫ x in (0 : ℝ)..2 * π, cosSum A x = 0 := by
  unfold cosSum
  rw [intervalIntegral.integral_finsetSum (fun (a : ℕ) _ => intervalIntegrable_cos_mul _ _ _)]
  exact Finset.sum_eq_zero (fun a ha => integral_cos_nat_mul (hA a ha))

/-- **Parseval.** `∫_0^{2π} f_A² = π |A|` when every element of `A` is positive. -/
theorem integral_cosSum_sq (A : Finset ℕ) (hA : ∀ a ∈ A, 0 < a) :
    ∫ x in (0 : ℝ)..2 * π, (cosSum A x) ^ 2 = π * A.card := by
  have hsq : ∀ x, (cosSum A x) ^ 2 =
      ∑ a ∈ A, ∑ b ∈ A, Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x) := by
    intro x
    rw [cosSum, sq, Finset.sum_mul_sum]
  simp_rw [hsq]
  have hint : ∀ a b : ℕ, IntervalIntegrable
      (fun x => Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x)) MeasureTheory.volume 0 (2 * π) :=
    fun a b => (by fun_prop : Continuous fun x =>
      Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x)).intervalIntegrable _ _
  rw [intervalIntegral.integral_finsetSum (fun (a : ℕ) _ =>
    (by fun_prop : Continuous fun x => ∑ b ∈ A,
      Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x)).intervalIntegrable _ _)]
  calc ∑ a ∈ A, ∫ x in (0 : ℝ)..2 * π, ∑ b ∈ A, Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x)
      = ∑ a ∈ A, ∑ b ∈ A, (if a = b then π else 0) := by
        refine Finset.sum_congr rfl (fun a ha => ?_)
        rw [intervalIntegral.integral_finsetSum (fun b _ => hint a b)]
        exact Finset.sum_congr rfl (fun b hb => integral_cos_mul_cos_nat (hA a ha) (hA b hb))
    _ = ∑ a ∈ A, π := by
        refine Finset.sum_congr rfl (fun a ha => ?_)
        simp [ha]
    _ = π * A.card := by
        rw [Finset.sum_const, nsmul_eq_mul, mul_comm]

/-- Normalized form of Parseval: `(1/2π) ∫_0^{2π} f_A² = |A| / 2`. -/
theorem normalized_mean_sq (A : Finset ℕ) (hA : ∀ a ∈ A, 0 < a) :
    (1 / (2 * π)) * ∫ x in (0 : ℝ)..2 * π, (cosSum A x) ^ 2 = (A.card : ℝ) / 2 := by
  rw [integral_cosSum_sq A hA]
  have := Real.pi_pos.ne'
  field_simp

end ChowlaCosine
import ChowlaCosine.Basic

/-!
# Averaging over the `q`-th roots of unity

For a finite `A ⊆ ℕ`, a positive natural `q` and every real `x`,

  `(1/q) ∑_{j<q} f_A(x + 2πj/q) = f_{A_q}(x)`,   `A_q = {a ∈ A : q ∣ a}`,

because `∑_{j<q} cos (a (x + 2πj/q)) = q cos (a x)` if `q ∣ a` and `= 0` otherwise
(a geometric sum of `q`-th roots of unity).

Consequences, for a uniform lower bound `-M ≤ f_A(x)` (all real `x`):
* restriction to multiples: `-M ≤ f_{A_q}(x)` for all real `x` (any `q : ℕ`, including `0`);
* for `q ≥ 2`: `|A| - q |A_q| ≤ (q - 1) M`; in particular `|A| ≤ (q - 1) M` when no element
  of `A` is divisible by `q`.

No positivity hypothesis on `A` is needed for any of these statements.
-/

open Real

namespace ChowlaCosine

/-- `∑_{j<q} cos (a (x + 2πj/q)) = q cos (a x)` if `q ∣ a`, and `0` otherwise (`q > 0`). -/
theorem sum_range_cos_shift (a q : ℕ) (hq : 0 < q) (x : ℝ) :
    ∑ j ∈ Finset.range q, Real.cos ((a : ℝ) * (x + 2 * π * j / q)) =
      if q ∣ a then (q : ℝ) * Real.cos ((a : ℝ) * x) else 0 := by
  have hq' : (q : ℝ) ≠ 0 := by exact_mod_cast hq.ne'
  split_ifs with hdiv
  · obtain ⟨k, rfl⟩ := hdiv
    have hterm : ∀ j ∈ Finset.range q, Real.cos (((q * k : ℕ) : ℝ) * (x + 2 * π * j / q)) =
        Real.cos (((q * k : ℕ) : ℝ) * x) := by
      intro j _
      have : ((q * k : ℕ) : ℝ) * (x + 2 * π * j / q) =
          ((q * k : ℕ) : ℝ) * x + ((k * j : ℕ) : ℝ) * (2 * π) := by
        push_cast
        field_simp
      rw [this, Real.cos_add_nat_mul_two_pi]
    rw [Finset.sum_congr rfl hterm, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  · set ζ : ℂ := Complex.exp (((2 * π * a / q : ℝ) : ℂ) * Complex.I) with hζ_def
    have hζq : ζ ^ q = 1 := by
      rw [hζ_def, ← Complex.exp_nat_mul]
      have : (q : ℂ) * (((2 * π * a / q : ℝ) : ℂ) * Complex.I) =
          (a : ℂ) * (2 * π * Complex.I) := by
        have hqc : (q : ℂ) ≠ 0 := by exact_mod_cast hq.ne'
        push_cast
        field_simp
      rw [this, Complex.exp_nat_mul_two_pi_mul_I]
    have hζ1 : ζ ≠ 1 := by
      intro h
      rw [hζ_def, Complex.exp_eq_one_iff] at h
      obtain ⟨n, hn⟩ := h
      have h2 := congrArg Complex.im hn
      simp only [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re,
        Complex.I_im, Complex.intCast_re, Complex.intCast_im, Complex.mul_re, mul_one, mul_zero,
        sub_zero, add_zero, zero_mul, Complex.re_ofNat, Complex.im_ofNat] at h2
      have h3 : (a : ℝ) = (n : ℝ) * q := by
        field_simp at h2
        nlinarith [Real.pi_pos]
      have h4 : (a : ℤ) = n * q := by exact_mod_cast h3
      apply hdiv
      have : (q : ℤ) ∣ (a : ℤ) := ⟨n, by rw [h4]; ring⟩
      exact_mod_cast this
    have hgeom : ∑ j ∈ Finset.range q, ζ ^ j = 0 := by
      rw [geom_sum_eq hζ1, hζq, sub_self, zero_div]
    have hterm : ∀ j ∈ Finset.range q, Real.cos ((a : ℝ) * (x + 2 * π * j / q)) =
        (Complex.exp ((((a : ℝ) * x : ℝ) : ℂ) * Complex.I) * ζ ^ j).re := by
      intro j _
      rw [hζ_def, ← Complex.exp_nat_mul, ← Complex.exp_add,
        ← Complex.exp_ofReal_mul_I_re ((a : ℝ) * (x + 2 * π * j / q))]
      congr 3
      push_cast
      ring
    rw [Finset.sum_congr rfl hterm, ← Complex.re_sum, ← Finset.mul_sum, hgeom, mul_zero,
      Complex.zero_re]

/-- `∑_{j<q} f_A(x + 2πj/q) = q f_{A_q}(x)` for `q > 0`, `A_q = {a ∈ A : q ∣ a}`. -/
theorem sum_cosSum_shift (A : Finset ℕ) (q : ℕ) (hq : 0 < q) (x : ℝ) :
    ∑ j ∈ Finset.range q, cosSum A (x + 2 * π * j / q) =
      q * cosSum (A.filter (fun a => q ∣ a)) x := by
  simp only [cosSum]
  rw [Finset.sum_comm, Finset.sum_congr rfl (fun a _ => sum_range_cos_shift a q hq x),
    Finset.sum_filter, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun a _ => ?_)
  split_ifs <;> simp

/-- **Averaging identity.** For `A : Finset ℕ`, `0 < q` and every real `x`,
`(1/q) ∑_{j<q} f_A(x + 2πj/q) = f_{A ∩ qℕ}(x)`. -/
theorem averaging_identity (A : Finset ℕ) (q : ℕ) (hq : 0 < q) (x : ℝ) :
    (1 / (q : ℝ)) * ∑ j ∈ Finset.range q, cosSum A (x + 2 * π * j / q) =
      cosSum (A.filter (fun a => q ∣ a)) x := by
  rw [sum_cosSum_shift A q hq x]
  have : (q : ℝ) ≠ 0 := by exact_mod_cast hq.ne'
  field_simp

/-- **Restriction to multiples.** If `-M ≤ f_A(x)` for every real `x`, then
`-M ≤ f_{A ∩ qℕ}(x)` for every real `x`, for every `q : ℕ` (for `q = 0` the restricted set is
`A ∩ {0}`). -/
theorem cosSum_filter_dvd_ge (A : Finset ℕ) (q : ℕ) (M : ℝ)
    (hM : ∀ x : ℝ, -M ≤ cosSum A x) :
    ∀ x : ℝ, -M ≤ cosSum (A.filter (fun a => q ∣ a)) x := by
  have key : ∀ q' : ℕ, 0 < q' → ∀ x : ℝ, -M ≤ cosSum (A.filter (fun a => q' ∣ a)) x := by
    intro q' hq' x
    rw [← averaging_identity A q' hq' x]
    have hsum : ∑ _j ∈ Finset.range q', (-M) ≤
        ∑ j ∈ Finset.range q', cosSum A (x + 2 * π * j / q') :=
      Finset.sum_le_sum (fun j _ => hM _)
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul] at hsum
    have hq'r : (0 : ℝ) < q' := by exact_mod_cast hq'
    rw [div_mul_eq_mul_div, one_mul, le_div_iff₀ hq'r]
    linarith
  rcases Nat.eq_zero_or_pos q with h0 | hq
  · subst h0
    have hfil : A.filter (fun a => 0 ∣ a) = A.filter (fun a => (A.sup id + 1) ∣ a) := by
      apply Finset.filter_congr
      intro a ha
      have hle : a ≤ A.sup id := Finset.le_sup (f := id) ha
      constructor
      · intro h
        rw [zero_dvd_iff] at h
        rw [h]
        exact dvd_zero _
      · intro h
        rw [zero_dvd_iff]
        exact Nat.eq_zero_of_dvd_of_lt h (by omega)
    rw [hfil]
    exact key _ (by omega)
  · exact key q hq

/-- `f_B(0) = |B|`. -/
theorem cosSum_zero (B : Finset ℕ) : cosSum B 0 = B.card := by
  simp [cosSum]

/-- **Mixed bound.** If `2 ≤ q` and `-M ≤ f_A(x)` for every real `x`, then
`|A| - q · #{a ∈ A : q ∣ a} ≤ (q - 1) M`. -/
theorem card_sub_le_of_cosSum_ge (A : Finset ℕ) (q : ℕ) (hq : 2 ≤ q) (M : ℝ)
    (hM : ∀ x : ℝ, -M ≤ cosSum A x) :
    (A.card : ℝ) - q * (A.filter (fun a => q ∣ a)).card ≤ ((q : ℝ) - 1) * M := by
  have h := sum_cosSum_shift A q (by omega) 0
  rw [cosSum_zero] at h
  obtain ⟨n, rfl⟩ : ∃ n, q = n + 1 := ⟨q - 1, by omega⟩
  rw [Finset.sum_range_succ'] at h
  simp only [Nat.cast_zero, mul_zero, zero_div, add_zero, cosSum_zero] at h
  have hlow : ∀ g : ℕ → ℝ, (n : ℝ) * (-M) ≤ ∑ i ∈ Finset.range n, cosSum A (g i) := by
    intro g
    have := Finset.sum_le_sum (fun i (_ : i ∈ Finset.range n) => hM (g i))
    simpa using this
  have hl := hlow (fun i => 0 + 2 * π * ((i + 1 : ℕ) : ℝ) / ((n + 1 : ℕ) : ℝ))
  beta_reduce at hl
  push_cast at h hl ⊢
  linarith

/-- **Mixed bound, division form.** If `2 ≤ q` and `-M ≤ f_A(x)` for every real `x`, then
`M ≥ (|A| - q · #{a ∈ A : q ∣ a}) / (q - 1)`. -/
theorem le_of_cosSum_ge_mixed (A : Finset ℕ) (q : ℕ) (hq : 2 ≤ q) (M : ℝ)
    (hM : ∀ x : ℝ, -M ≤ cosSum A x) :
    ((A.card : ℝ) - q * (A.filter (fun a => q ∣ a)).card) / ((q : ℝ) - 1) ≤ M := by
  have h := card_sub_le_of_cosSum_ge A q hq M hM
  have hq1 : (0 : ℝ) < (q : ℝ) - 1 := by
    have : (2 : ℝ) ≤ q := by exact_mod_cast hq
    linarith
  rw [div_le_iff₀ hq1]
  linarith

/-- **No multiples.** If `2 ≤ q`, no element of `A` is divisible by `q`, and `-M ≤ f_A(x)` for
every real `x`, then `|A| ≤ (q - 1) M`. (Positivity of `A` is not needed: `q ∣ 0`.) -/
theorem card_le_of_no_multiples (A : Finset ℕ) (q : ℕ) (hq : 2 ≤ q)
    (hnd : ∀ a ∈ A, ¬ q ∣ a) (M : ℝ) (hM : ∀ x : ℝ, -M ≤ cosSum A x) :
    (A.card : ℝ) ≤ ((q : ℝ) - 1) * M := by
  have h := card_sub_le_of_cosSum_ge A q hq M hM
  have h0 : A.filter (fun a => q ∣ a) = ∅ := Finset.filter_eq_empty_iff.mpr hnd
  rw [h0, Finset.card_empty, Nat.cast_zero, mul_zero, sub_zero] at h
  exact h

/-- The no-multiples bound with the (redundant) positivity hypothesis, exactly as requested. -/
theorem card_le_of_no_multiples' (A : Finset ℕ) (q : ℕ) (hq : 2 ≤ q)
    (_hA : ∀ a ∈ A, 0 < a) (hnd : ∀ a ∈ A, ¬ q ∣ a) (M : ℝ)
    (hM : ∀ x : ℝ, -M ≤ cosSum A x) :
    (A.card : ℝ) ≤ ((q : ℝ) - 1) * M :=
  card_le_of_no_multiples A q hq hnd M hM

end ChowlaCosine

