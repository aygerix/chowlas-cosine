                if v.lower()>Mlo.upper(): Mlo=arb(v.lower())
            ml=Q(str(float(Mlo.lower())-1e-12)).limit_denominator(10**14)
            assert arb(ml.numerator)/ml.denominator < Mlo
            for P in models:
                beta=[Q(ai)-pi for ai,pi in zip(a,P)]
                pref=[]; z=Q(0)
                for v in beta: z+=v; pref.append(z)
