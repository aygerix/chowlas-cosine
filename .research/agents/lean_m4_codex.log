  have hsum : (∑ i, c i) = 2 := by simpa using weightedFrame_sum_weights c u hu hframe b
  simp only [heatKernel, mul_one]
  simp_rw [div_rpow (gaussian_pos _ _).le (sqrt_nonneg _)]
