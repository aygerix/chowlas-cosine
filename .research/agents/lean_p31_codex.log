      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (heatKernel_time_slope_bound ht _) (norm_nonneg _))
  have hdiff : ∀ᵐ y : ℝ, ∀ s ∈ (Set.univ : Set ℝ), HasDerivAt (fun s => F s y) (F' s y) s := by
