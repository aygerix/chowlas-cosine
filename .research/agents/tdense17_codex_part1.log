+"""Last independent parameter/identity checks; VM only."""
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+from scipy.linalg import eigvalsh
+
+ROOT=Path('.research/agents/tdense17_scratch')
+
+
+def main():
+    out=[]
+    rng=np.random.default_rng(1717)
+    for r in (32,128,512):
+        B=np.triu(rng.random((r,r))<0.5,1)
+        B=(B+B.T).astype(float)
+        w=eigvalsh(B)
+        s=r*r; n=r*s
+        out.append(dict(r=r,twin_size=s,n=n,alpha=float(np.sum(w*w)/r**2),
+            normalized_C4=float(np.sum(w**4)/r**4),
+            residual_square=float((np.sum(w*w)-w[-1]**2)/r**2),
+            beta1=float(np.sum(w[np.abs(w)<=math.sqrt(n)/s]**2)/r**2)))
+    candidates=json.load(open(ROOT/'cliques.json'))
+    verification=json.load(open(ROOT/'verification.json'))
+    probes=json.load(open(ROOT/'probe.json'))
+    large=json.load(open(ROOT/'large_spectra.json'))
+    q61=next(d for d in json.load(open(ROOT/'zoo.json'))['records'] if d['name']=='singer_bu_61')
+    first=large[0]['depth96']
+    comparison={k:dict(dense=q61[k],stochastic=first[k]) for k in ('beta1','beta2','psd_distance','r_eff','bd_over_sqrtn')}
+    assertions=[]
+    for t in (4,5,8,16,32):
+        L=t**6;k=t**5
+        Q=L*(2*L*L+1)//3
+        # Exact forcing cost from the closed cubic autocorrelation on 1<=a<=k<=L.
+        sum_a=k*(k+1)//2
+        sum_a2=k*(k+1)*(2*k+1)//6
+        sum_a3=sum_a**2
+        Dnum=L*sum_a2-(sum_a3-sum_a)//2
+        assert 2*Dnum<=3*t**3*Q
+        G=16*L*L
+        R=(128*L*L-1).bit_length()
+        u=math.isqrt(L*R)
+        if u*u<L*R:u+=1
+        assert 2*G*4<=2**R
+        assert u*u>=L*R
+        assert 3*t**3*32<=2*L
+        assertions.append(dict(t=t,L=L,k=k,r=R,u=u,B_upper=u+2*t**3+1,
+                               guaranteed_ratio=(k+1)/(2*(u+2*t**3+1))))
+    result=dict(blowup_cgw=out,dense_vs_stochastic_q61=comparison,
+                exact_parameter_checks=assertions)
+    (ROOT/'final_audit.json').write_text(json.dumps(result,indent=2)+'\n')
+    print(json.dumps(result),flush=True)
+    lines=['## Large near-extremal spectral audit','',
+        'NUMERICAL STOCHASTIC estimates: 10 Rademacher probes, seed 20261019, 24 explicitly computed positive outliers, fully reorthogonalized Lanczos of depths 48 and 96 on their orthogonal complement. Standard errors are sampling estimates, not certified enclosures; the depth comparison assesses quadrature sensitivity. The bottom eigenvalue is separately computed by FFT-Lanczos. These rows do not prove any spectral inequality.','',
+        '| q | n | B1 depth96 | standard error | B1 depth48 | B2 | Dpsd | BD/sqrt n | eff rank | bottom/sqrt n |',
+        '|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|']
+    for d in large:
+        x=d['depth96']; y=d['depth48']
+        lines.append(f"| {d['q']} | {d['n']} | {x['beta1']:.7g} | {x['beta1_standard_error']:.3g} | {y['beta1']:.7g} | {x['beta2']:.7g} | {x['psd_distance']:.7g} | {x['bd_over_sqrtn']:.7g} | {x['r_eff']:.7g} | {d['bottom_over_sqrtn']:.7g} |")
+    lines += ['', 'NUMERICAL STOCHASTIC moment and trace audit, same probes. Values and raw standard errors for cutoff means, variances, positive/negative square masses and traces are in large_spectra.json.','',
+        '| q | alpha | tr3/n³ | tr4/n⁴ | residual4/n³ | traceP/n^(3/2) | cutoff mean | cutoff variance |',
+        '|---|---:|---:|---:|---:|---:|---:|---:|']
+    for d in large:
+        x=d['depth96']
+        lines.append(f"| {d['q']} | {d['alpha']:.7g} | {x['tr3_n3']:.7g} | {x['tr4_n4']:.7g} | {x['residual4_n3']:.7g} | {x['traceP_n32']:.7g} | {x['mu_cut']:.7g} | {x['variance_cut']:.7g} |")
+    (ROOT/'large_tables.md').write_text('\n'.join(lines)+'\n')
+
+
+if __name__=='__main__':main()
diff --git a/.research/agents/tdense17_scratch/large_spectra.py b/.research/agents/tdense17_scratch/large_spectra.py
new file mode 100644
index 0000000000000000000000000000000000000000..e50ecc43648e73126e0f5a065db039306b027d86
--- /dev/null
+++ b/.research/agents/tdense17_scratch/large_spectra.py
@@ -0,0 +1,108 @@
+"""Stochastic spectral audit of all E99 Singer-Bu sizes. VM only; NOT certificates."""
+import json
+import math
+from pathlib import Path
+import sys
+import time
+
+import numpy as np
+from scipy.linalg import eigh_tridiagonal
+from scipy.sparse.linalg import LinearOperator,eigsh
+
+sys.path.insert(0,'src')
+from bu import A_of_S
+
+ROOT=Path('.research/agents/tdense17_scratch')
+
+
+def run(key, stored, probes=10, depth=96, deflation=24):
+    start=time.time()
+    A=np.array(A_of_S(stored['S']),dtype=np.int64)
+    n=len(A); X=int(A.max())
+    L=1<<(2*X+2).bit_length()
+    coeff=np.zeros(L); coeff[A]=1.; coeff[(-A)%L]=1.
+    kernel=np.fft.rfft(coeff)
+    def mv(v):
+        buf=np.zeros(L); buf[A]=np.ravel(v)
+        return np.fft.irfft(np.fft.rfft(buf)*kernel,L)[A]
+    op=LinearOperator((n,n),matvec=mv,dtype=float)
+    top,U=eigsh(op,k=deflation,which='LA',tol=1e-9,ncv=3*deflation+10,
+                 v0=np.random.default_rng(17).normal(size=n))
+    order=np.argsort(top)[::-1]; top=top[order]; U=U[:,order]
+    bottom=float(eigsh(op,k=1,which='SA',tol=1e-9,
+                       v0=np.random.default_rng(18).normal(size=n))[0][0])
+    degree=mv(np.ones(n))
+    assert np.max(np.abs(degree-np.rint(degree)))<1e-5
+    tr2=int(np.rint(degree).sum())
+    tau=math.sqrt(n)
+    def funcs(w):
+        low=w<=tau
+        return np.array([np.sum(w*w*(np.abs(w)<=tau)),
+                         np.sum(w*w*(np.abs(w)<=2*tau)),
+                         np.sum(w*w*(w<0)), np.sum(w*(w>0)),
+                         np.sum(w*w*(w>0)), np.sum(low),
+                         np.sum(w*low),np.sum(w*w*low),
+                         np.sum(w**3),np.sum(w**4)])
+    topfun=funcs(top)
+    samples={48:[],depth:[]}
+    rng=np.random.default_rng(20261019)
+    for probe in range(probes):
+        z=rng.choice([-1.,1.],size=n)
+        z-=U@(U.T@z)
+        weight=float(z@z)
+        q=z/math.sqrt(weight); previous=np.zeros(n); beta=0.
+        basis=np.empty((n,depth)); diag=[]; off=[]
+        for j in range(depth):
+            basis[:,j]=q
+            w=mv(q)-beta*previous
+            alpha=float(q@w); w-=alpha*q
+            # Full reorthogonalization and projection away from known positive outliers.
+            w-=U@(U.T@w)
+            for _ in range(2): w-=basis[:,:j+1]@(basis[:,:j+1].T@w)
+            diag.append(alpha)
+            beta=float(np.linalg.norm(w))
+            if j+1 in samples:
+                nodes,V=eigh_tridiagonal(np.array(diag),np.array(off))
+                quadweight=weight*V[0,:]**2
+                low=nodes<=tau
+                fun=np.array([np.sum(quadweight*nodes**2*(np.abs(nodes)<=tau)),
+                              np.sum(quadweight*nodes**2*(np.abs(nodes)<=2*tau)),
+                              np.sum(quadweight*nodes**2*(nodes<0)),
+                              np.sum(quadweight*nodes*(nodes>0)),
+                              np.sum(quadweight*nodes**2*(nodes>0)),
+                              np.sum(quadweight*low),np.sum(quadweight*nodes*low),
+                              np.sum(quadweight*nodes**2*low),
+                              np.sum(quadweight*nodes**3),np.sum(quadweight*nodes**4)])
+                samples[j+1].append(fun+topfun)
+            if j+1<depth:
+                off.append(beta); previous=q; q=w/beta
+    out=dict(q=int(key),n=n,X=X,probes=probes,depth=depth,deflation=deflation,
+             seed=20261019,tr2=tr2,alpha=tr2/n**2,
+             bottom_over_sqrtn=-bottom/tau, top_eigenvalues=top.tolist(),
+             R_cert_quoted=stored['R_cert'])
+    for dep,ss in samples.items():
+        ss=np.array(ss); mean=ss.mean(axis=0); se=ss.std(axis=0,ddof=1)/math.sqrt(probes)
+        b1,b2,neg2,trP,trP2,count,first,second,t3,t4=mean
+        mu=first/count; var=second/count-mu**2
+        out['depth'+str(dep)]=dict(beta1=b1/n**2,beta2=b2/n**2,
+            beta1_standard_error=se[0]/n**2,beta2_standard_error=se[1]/n**2,
+            psd_distance=math.sqrt(neg2)/n,r_eff=trP**2/trP2,
+            traceP_n32=trP/n**1.5,mu_cut=mu,variance_cut=var,
+            bd_over_sqrtn=(var/(tau+abs(mu))+abs(mu))/tau,
+            tr3_n3=t3/n**3,tr4_n4=t4/n**4,
+            residual4_n3=(t4-top[0]**4)/n**3,
+            raw_estimates=mean.tolist(),raw_standard_errors=se.tolist())
+    out['seconds']=time.time()-start
+    print(json.dumps({k:v for k,v in out.items() if k!='top_eigenvalues'}),flush=True)
+    return out
+
+
+def main():
+    sb=json.load(open('examples/singer_bu/certified.json'))
+    out=[]
+    for key in ('61','101','151','199'):
+        out.append(run(key,sb[key]))
+        (ROOT/'large_spectra.json').write_text(json.dumps(out,indent=2)+'\n')
+
+
+if __name__=='__main__':main()
