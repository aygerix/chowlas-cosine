+                R=float(abs(cs).sum()); W=float(np.vdot(cs,cs).real)
+                w=abs(cs)/(R or 1); qcounts=[]; tors=[]
+                for d in range(1,5): tors.append(float(np.dot(w,np.abs(dy(d*xs,X)))))
+                if len(chosen)<=64:
+                    for d in (2,3):
+                        vals=[]
+                        for j in range(d+1):
+                            if 2*j==d:continue
+                            freqs=np.array([0.]); weights=np.array([1.])
+                            for ell in range(d):
