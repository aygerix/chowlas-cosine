  simp only [ENNReal.mul_rpow_of_nonneg _ _ ha1.le, ← ENNReal.rpow_mul, eb, ec] at H2pow
  have H := H1.trans (mul_le_mul_left'"' H2pow ((∫⁻ x, f x ∂μ) "'^ a))
  simpa only [mul_assoc] using H

end ChowlaCosine.Beckner
