+            else:R=W=0.;qcounts=[];tors=[];u=[]
+            # Exclude macro neighborhoods for the claim "Bu has no tall spikes".
+            dist=np.minimum(np.arange(G),G-np.arange(G))*2*np.pi/G
+            macro=dist<=max(32/X,X**(-.5))
