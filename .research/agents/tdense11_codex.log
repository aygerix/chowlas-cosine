+       cubic_target=float(np.mean(e*(1-2*p))),fourth_target=float(np.mean(e*(1-3*e))),
+       defect=float(np.mean(a*a*(a-1)**2)),nearest_energy=float(np.mean((a-(a>=.5))**2)),fft=fft(a))
