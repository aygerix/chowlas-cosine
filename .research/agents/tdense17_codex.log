"""Round 17 first falsification tests. Run only through dirun.sh, <=4 cores."""
import json
import math
from pathlib import Path
import sys
import time

import numpy as np
from scipy.linalg import eigvalsh

sys.path.insert(0, 'src')
from chowla import min_estimate_fft, certify_lower_bound

ROOT = Path('.research/agents/tdense17_scratch')


def spline_prob(L):
    a = np.arange(1, 2 * L, dtype=np.int64)
    Q = L * (2 * L * L + 1) // 3
    r = np.empty_like(a)
    lo = a <= L
    b = a[lo]
    r[lo] = Q - L * b * b + (b * b * b - b) // 2
    b = 2 * L - a[~lo]
    r[~lo] = (b * b * b - b) // 6
    return a, r / Q, Q


def main():
    records = []
    for m in (16, 64, 256, 1024):
        n = 2 * m
        s = 1 / (2 * np.sin((2 * np.arange(1, m) - 1) * np.pi / (4 * m - 2)))
        w = np.r_[-s, [0., 0.], s]
        if m <= 64:
            A = np.arange(m + 1, 3 * m + 1)
            H = (np.abs(A[:, None] - A[None, :]) > m).astype(float)
            assert np.max(np.abs(eigvalsh(H) - np.sort(w))) < 1e-9
        rec = dict(test='shifted_interval', m=m, n=n, bulk_gamma1=float(np.sum(w[np.abs(w) <= math.sqrt(n)] ** 2) / n ** 2),
                   neg_energy=float(np.sum(s*s) / n**2), edge=float(s.max()/math.sqrt(n)))
        records.append(rec)
        print(json.dumps(rec), flush=True)
    for L, power in ((512, 2/3), (4096, 2/3), (32768, 2/3), (262144, 2/3),
                     (4096, 5/6), (262144, 5/6)):
        a, p, Q = spline_prob(L)
        k = round(L ** power)
        for seed in (17, 117):
            rng = np.random.default_rng(seed)
            keep = rng.random(len(a)) < p
            keep[:k] = True
            A = a[keep].tolist()
            est = min_estimate_fft(A, oversample=16, polish=16)
            rec = dict(test='forced_spline', L=L, power=power, seed=seed, n=len(A), X=max(A), forced_prefix=k,
                       omega_lower=k+1, M_est=-est.fmin, omega_over_K_est=(k+1)/(-2*est.fmin),
                       forcing_l1=float(np.sum(1-p[:k])), unforced_expected_n=float(p.sum()),
                       expected_n=float(p.sum()+np.sum(1-p[:k])), Q=Q)
            if L == 4096 and seed == 17:
                cert = certify_lower_bound(A, oversample=16, prec=100)
                rec['certified_M_upper'] = -cert.lower_bound
                rec['certified_omega_over_K_lower'] = (k+1)/(-2*cert.lower_bound)
                rec['cert_grid'] = cert.L
            suffix = '_p5_6' if power > 0.8 else ''
            np.savez_compressed(ROOT / f'spline_L{L}_s{seed}{suffix}.npz', A=np.array(A, dtype=np.int64))
            records.append(rec)
            print(json.dumps(rec), flush=True)
    (ROOT / 'probe.json').write_text(json.dumps(records, indent=2) + '\n')


if __name__ == '__main__':
    main()
"""Adversarial spectra and clique lower bounds; VM only, four cores maximum."""
import json
import math
from pathlib import Path
import sys
import time

import numpy as np
import scipy
from scipy.linalg import eigvalsh

sys.path.insert(0, 'src')
from chowla import min_estimate_fft
from bu import A_of_S

ROOT = Path('.research/agents/tdense17_scratch')


def metrics(name, A, **meta):
    A = np.array(sorted(set(map(int, A))), dtype=np.int64)
    assert len(A) and A.min() > 0
    n = len(A)
    D = np.abs(A[:, None] - A[None, :])
    mask = np.zeros(int(A.max()) + 1, dtype=bool)
    mask[A] = True
    H = mask[D].astype(np.float64)
    w = eigvalsh(H, check_finite=False, driver='evr')
    d = H.sum(axis=0)
    H2 = H @ H
    t2 = int(np.sum(d))
    t3 = int(np.sum(H2 * H))
    t4 = int(np.sum(H2 * H2))
    # Two independent exact integer expressions for moments (matrix sizes modest).
    assert t2 == int(np.sum(H*H))
    assert abs(np.sum(w*w) - t2) < 1e-5 * max(1, t2)
    assert abs(np.sum(w**3) - t3) < 1e-7 * max(1, t3)
    assert abs(np.sum(w**4) - t4) < 1e-7 * max(1, t4)
    tau = math.sqrt(n)
    low = w[w <= tau]
    mu = float(low.mean())
    var = float(low.var())
    bd = var/(tau+abs(mu)) + abs(mu)
    neg2 = float(np.sum(w[w < 0]**2))
    pos = w[w > 1e-9]
    r_eff = float(pos.sum()**2 / np.sum(pos*pos)) if len(pos) else 0.
    M = -min_estimate_fft(A.tolist(), oversample=16, polish=16).fmin
    # Star extension, including sum-free adversaries.
    H0 = np.zeros((n+1, n+1))
    H0[1:, 1:] = H
    H0[0, 1:] = 1
    H0[1:, 0] = 1
    w0 = eigvalsh(H0, check_finite=False, driver='evr')
    rec = dict(name=name, n=n, X=int(A.max()), R_est=M/math.sqrt(n), K_est=2*M,
               alpha=t2/n**2, tr2=t2, tr3=t3, tr4=t4,
               tr3_n3=t3/n**3, tr4_n4=t4/n**4,
               cgw_defect=(t4-float(w[-1])**4)/n**4,
               residual4_n3=(t4-float(w[-1])**4)/n**3,
               min_over_sqrtn=float(-w[0]/tau), star_min_over_sqrtn=float(-w0[0]/tau),
               beta1=float(np.sum(w[np.abs(w)<=tau]**2)/n**2),
               beta2=float(np.sum(w[np.abs(w)<=2*tau]**2)/n**2),
               psd_distance=float(math.sqrt(neg2)/n), r_eff=r_eff,
               mu_cut=mu, variance_cut=var, bd_over_sqrtn=bd/tau,
               traceP_n32=float(pos.sum()/n**1.5),
               neg_energy_over_nK2=neg2/(n*(2*M)**2), **meta)
    print(json.dumps(rec), flush=True)
    return rec


def quadric(p, repeats, taper, seed):
    d = next(d for d in range(2,p) if pow(d,(p-1)//2,p)==p-1)
    # Balanced rank-4 GAP, base >2*coordinate radius prevents additive carry.
    h = repeats*p//2
    B = 4*h+3
    coords = np.indices((2*h+1,)*4).reshape(4,-1).T-h
    q = (coords[:,0]*coords[:,1]+coords[:,2]**2-d*coords[:,3]**2)%p
    keep = q != 0
    if taper:
        # Product triangular taper; independent symmetric-pair rounding in Z.
        probs = np.prod(1-np.abs(coords)/(h+1),axis=1)
    v = coords @ np.array([1,B,B*B,B**3],dtype=np.int64)
    keep &= v > 0
    if taper:
        keep &= np.random.default_rng(seed).random(len(v)) < probs
    A = v[keep].tolist()
    return A, dict(p=p, repeats=repeats, taper=taper, seed=seed, base=B, coord_radius=h)


def clique_search(A, seed, known=None, starts=24):
    A = np.array(sorted(set(map(int,A))),dtype=np.int64)
    S = np.r_[-A[::-1], A]
    n = len(S)
    lookup = np.zeros(2*int(A.max())+1,dtype=bool)
    lookup[A] = True
    cache = {}
    def row(v):
        v = int(v)
        if v not in cache:
            x = lookup[np.abs(S-S[v])]
            cache[v] = int.from_bytes(np.packbits(x, bitorder='little').tobytes(),'little')
        return cache[v]
    rng = np.random.default_rng(seed)
    best = []
    full = (1 << n)-1
    initial = [[]]
    if known:
        index = {int(x):i for i,x in enumerate(S)}
        for c in known:
            cc = [index[int(x)] for x in c if x and int(x) in index]
            if cc: initial.append(cc)
    for trial in range(starts + len(initial)):
        C = list(initial[trial]) if trial < len(initial) else [int(rng.integers(n))]
        candidates = full
        for v in C: candidates &= row(v)
        while candidates:
            count = candidates.bit_count()
            # Uniformly choose one candidate by its rank. Python integer operations avoid dense graphs.
            rank = int(rng.integers(count))
            bits = candidates
            for _ in range(rank): bits &= bits-1
            bit = bits & -bits
            v = bit.bit_length()-1
            C.append(v)
            candidates &= row(v)
        if len(C) > len(best): best = C
    C = [int(S[i]) for i in best]
    aset = set(A.tolist())
    assert all(abs(a-b) in aset for i,a in enumerate(C) for b in C[i+1:])
    # Add 0, which is adjacent to every vertex of Cay[S]. Report both conventions.
    return dict(clique_in_S=C, omega_S_lower=len(C), omega_global_lower=len(C)+1,
                includes_zero_extension=True, cached_rows=len(cache))


def main():
    records = []
    sm = json.load(open('examples/smallN_best.json'))
    for n in ('36','50','64','80','100'):
        if n in sm: records.append(metrics('smallN_'+n, sm[n]['A']))
    sb = json.load(open('examples/singer_bu/certified.json'))
    records.append(metrics('singer_bu_61', A_of_S(sb['61']['S'])))
    for n in (128,512):
        records.append(metrics('AP_'+str(n), range(1,n+1)))
        records.append(metrics('shifted_interval_'+str(n), range(n//2+1,3*n//2+1)))
        records.append(metrics('sumfree_odd_'+str(n), range(1,2*n,2)))
    for rank in (2,3):
        aa = np.arange(1,4097)
        theta = np.sqrt(np.array([2,3,5])[:rank])
        phases = (aa[:,None]*theta[None,:]+0.5)%1-0.5
        A = aa[np.all(np.abs(phases)<0.28,axis=1)]
        records.append(metrics('bohr_rank'+str(rank), A, rank=rank, width=0.28, cap=4096))
    for pieces in (8,32):
        # Widely separated short APs: differences between high blocks do not lie in high blocks.
        A = [10000*j+a for j in range(1,pieces+1) for a in range(1,17)]
        records.append(metrics('many_AP_'+str(pieces), A, pieces=pieces, length=16))
        A = [10000*j+a for j in range(1,pieces+1) for a in range(1,33)
             if abs((a*math.sqrt(2)+0.5)%1-0.5)<0.28
             and abs((a*math.sqrt(3)+0.5)%1-0.5)<0.28]
        records.append(metrics('many_Bohr_'+str(pieces), A, pieces=pieces))
    for p,reps,taper in ((3,1,False),(3,3,False),(3,3,True),(5,1,False),(5,1,True)):
        A,meta=quadric(p,reps,taper,seed=17)
        records.append(metrics('quadric_'+str(p)+'_'+str(reps)+'_'+str(taper), A, **meta))
    rng=np.random.default_rng(20261019)
    for alpha in (0.05,0.25,0.5):
        A=np.flatnonzero(rng.random(2048)<alpha)+1
        records.append(metrics('random_'+str(alpha), A, seed=20261019, input_density=alpha))
    A=np.load(ROOT/'spline_L512_s17.npz')['A']
    records.append(metrics('forced_spline_512',A,L=512,seed=17))
    (ROOT/'zoo.json').write_text(json.dumps(dict(numpy=np.__version__, scipy=scipy.__version__, records=records),indent=2)+'\n')
    cliques=[]
    for key in ('36','50','64','80','100'):
        if key not in sm: continue
        A=sm[key]['A']; est=min_estimate_fft(A)
        c=clique_search(A,17,starts=80)
        c.update(name='smallN_'+key, K_est=-2*est.fmin,
                 omega_global_over_K_est=c['omega_global_lower']/(-2*est.fmin))
        cliques.append(c); print(json.dumps(c),flush=True)
    for key in ('61','101','151','199'):
        D=sb[key]['S']; A=A_of_S(D); est=min_estimate_fft(A)
        known=[[3*(x-b) for x in D] for b in (D[0],D[len(D)//2],D[-1])]
        c=clique_search(A,17,known=known,starts=16)
        c.update(name='singer_bu_'+key, K_est=-2*est.fmin,
                 omega_global_over_K_est=c['omega_global_lower']/(-2*est.fmin))
        cliques.append(c); print(json.dumps({k:v for k,v in c.items() if k!='clique_in_S'}),flush=True)
    (ROOT/'cliques.json').write_text(json.dumps(cliques,indent=2)+'\n')


if __name__=='__main__': main()
"""Independent finite audits, exact profile checks, tables. VM only."""
import itertools
import json
import math
from pathlib import Path
import sys

import flint
import numpy as np
from scipy.linalg import eigvalsh

sys.path.insert(0,'src')
sys.path.insert(0,'.research/agents/tdense17_scratch')
from chowla import min_estimate_fft
from probe import spline_prob

ROOT=Path('.research/agents/tdense17_scratch')


def main():
    exact=0
    for L in range(2,40):
        a,p,Q=spline_prob(L)
        g={j:L-abs(j) for j in range(-L+1,L)}
        for v,pp in zip(a,p):
            r=sum(z*g.get(j+int(v),0) for j,z in g.items())
            if v<=L:
                formula=Q-L*int(v)**2+(int(v)**3-int(v))//2
            else:
                d=2*L-int(v); formula=(d**3-d)//6
            assert r==formula
            assert 0<=r<=Q
            assert 2*(Q-r)<=2*L*int(v)**2
            exact+=1
    # Independent, elementary all-circle certificate: Arb grid + global second derivative.
    A=np.load(ROOT/'spline_L4096_s17_p5_6.npz')['A'].tolist()
    flint.ctx.prec=140
    G=1<<18
    B=80
    vals=[flint.acb(0)]*G
    for a in A: vals[a]=flint.acb(1)
    F=flint.acb.dft(vals)
    S2=sum(a*a for a in A)
    remainder=flint.arb(S2)*flint.arb(22)**2/(2*49*G*G)
    # At a global minimizer f'=0; Taylor to its nearest grid point incurs <=remainder.
    passed=all(z.real+B-remainder>0 for z in F)
    assert passed
    est=min_estimate_fft(A,oversample=32,polish=32)
    xx=flint.arb(str(est.xmin))
    point=sum((xx*a).cos() for a in A)
    certificate=dict(M_upper_integer=B, clique_size=1025,
                     rigorous_ratio_lower='1025/160 = 6.40625',
                     grid=G, precision_bits=140, sum_a2=S2,
                     remainder=str(remainder), point_value=str(point), passed=passed,
                     method='Arb DFT; nearest global minimum, f-prime=0, global sum(a^2) Taylor bound; pi<22/7')
    print(json.dumps(certificate),flush=True)
    # Cross-check exact additive counts by explicit closed walks for all nonempty A in [1,7].
    moment_cases=0
    for bits in range(1,1<<7):
        aa=[j+1 for j in range(7) if bits>>j&1]
        aset=set(aa)
        H=np.array([[int(abs(x-y) in aset) for y in aa] for x in aa],dtype=np.int64)
        t2=sum(abs(x-y) in aset for x in aa for y in aa)
        t3=sum(abs(x-y) in aset and abs(y-z) in aset and abs(z-x) in aset
               for x in aa for y in aa for z in aa)
        common={(x,z):sum(abs(x-y) in aset and abs(z-y) in aset for y in aa)
                for x in aa for z in aa}
        t4=sum(v*v for v in common.values())
        assert t2==int(np.trace(H@H))
        assert t3==int(np.trace(H@H@H))
        assert t4==int(np.trace(H@H@H@H))
        w=eigvalsh(H.astype(float))
        for tau in (0.1,1.,math.sqrt(len(aa)),10.):
            low=w[w<=tau]
            mu=float(low.mean()); var=float(low.var())
            assert -w[0]+1e-8 >= var/(tau+abs(mu))+abs(mu)
        moment_cases+=1
    # Translates of the explicit obstruction, including overlaps and a distant translate.
    uniform=[]
    for m in (24,96,192):
        aa=np.arange(m+1,3*m+1)
        for t in (0,1,m,2*m,10*m):
            W=np.union1d(aa,aa+t)
            H=((np.abs(W[:,None]-W[None,:])>m)&(np.abs(W[:,None]-W[None,:])<=3*m)).astype(float)
            w=eigvalsh(H)
            rec=dict(m=m,t=t,vertices=len(W),
                     beta1=float(np.sum(w[np.abs(w)<=math.sqrt(2*m)]**2)/(2*m)**2),
                     psd_distance_per_vertex=float(np.linalg.norm(w[w<0])/len(W)))
            uniform.append(rec)
    (ROOT/'verification.json').write_text(json.dumps(dict(exact_profile_checks=exact,
        exact_moment_sets=moment_cases, independent_certificate=certificate,
        translated_intervals=uniform, flint_version=flint.__version__),indent=2)+'\n')
    # Tables are generated on the VM; local work only inserts the returned markdown.
    zoo=json.load(open(ROOT/'zoo.json'))['records']
    lines=['## Adversarial tables','',
           'NUMERICAL unless a separate exact or interval certificate is explicitly stated. Density alpha is tr(H²)/n² (including the diagonal normalization). B1 and B2 are the spectral energies inside sqrt(n) and 2sqrt(n), divided by n². Dpsd is the Frobenius distance to the PSD cone divided by n. BD is the truncated Bhatia–Davis bound at tau=sqrt(n), divided by sqrt(n).','',
           '| family | n | R est | alpha | B1 | B2 | Dpsd | −min eig / sqrt n | star | BD |',
           '|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|']
    for d in zoo:
        keys=['R_est','alpha','beta1','beta2','psd_distance','min_over_sqrtn','star_min_over_sqrtn','bd_over_sqrtn']
        lines.append('| '+d['name']+' | '+str(d['n'])+' | '+' | '.join(f'{d[k]:.5g}' for k in keys)+' |')
    lines += ['', 'NUMERICAL moment and rank audit. T3=tr(H³)/n³, T4=tr(H⁴)/n⁴, C4res=(tr(H⁴)−lambda_max^4)/n³. The effective rank is (tr P)²/tr(P²); traceP is tr(P)/n^(3/2). Qneg is sum_negative lambda² divided by n K_est². Raw integer counts and cutoff mean/variance for every row are in zoo.json.', '',
              '| family | T3 | T4 | C4res | eff rank | traceP | Qneg |',
              '|---|---:|---:|---:|---:|---:|---:|']
    for d in zoo:
        keys=['tr3_n3','tr4_n4','residual4_n3','r_eff','traceP_n32','neg_energy_over_nK2']
        lines.append('| '+d['name']+' | '+' | '.join(f'{d[k]:.5g}' for k in keys)+' |')
    lines += ['', 'NUMERICAL clique lower bounds. Clique membership and all pair differences are checked exactly. These are heuristic lower bounds for the clique number, not maximum-clique certificates. The column +0 extends the clique by the common neighbor 0; K_est is an uncertified minimum estimate.','',
              '| family | clique in S | with 0 | K est | (with 0)/K est |',
              '|---|---:|---:|---:|---:|']
    for d in json.load(open(ROOT/'cliques.json')):
        lines.append(f"| {d['name']} | {d['omega_S_lower']} | {d['omega_global_lower']} | {d['K_est']:.7g} | {d['omega_global_over_K_est']:.7g} |")
    lines += ['', 'NUMERICAL and separately certified profile examples. All listed ratios use a known clique; global clique maxima were not computed.','',
              '| L | forced prefix | seed | n | clique | M est | clique/K est | certified ratio lower |',
              '|---|---:|---:|---:|---:|---:|---:|---:|']
    for d in json.load(open(ROOT/'probe.json')):
        if d['test']!='forced_spline': continue
        bound=d.get('certified_omega_over_K_lower')
        lines.append(f"| {d['L']} | {d['forced_prefix']} | {d['seed']} | {d['n']} | {d['omega_lower']} | {d['M_est']:.8g} | {d['omega_over_K_est']:.8g} | {bound if bound is not None else '—'} |")
    (ROOT/'tables.md').write_text('\n'.join(lines)+'\n')
    print(json.dumps(dict(exact_profile_checks=exact,exact_moment_sets=moment_cases,
                         translated_interval_cases=len(uniform),tables='tables.md')),flush=True)


