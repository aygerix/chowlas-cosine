r"""E116: lifting a Jedwab–Li two-valued set from Z_n² to Z² (hence Z) with a JOINTLY optimised Boolean taper
(advisor's experiment, cont. 31). Lead.

Object. D = D_{a,j} ⊂ Z_n², n = p^a, an exact LS_r(n) PDS (r = p^{a−1}): D̂ ∈ {n − r, −r} off 0, ratio_G = |D|/r².
Lift. P_L = {z ∈ [−L, L]² : z mod n ∈ D} (symmetric, 0 ∉ P_L). A weight w on P_L gives the 2D cosine polynomial
    F_w(ξ) = Σ_{z ∈ P_L} w_z cos(2π z·ξ),   ξ ∈ T²,   K'(w) = −min_{T²} F_w.
A Boolean w = 1_T (T ⊂ P_L symmetric) maps to the integer set S = {z₁ + V z₂ : z ∈ T} (V > 4L), whose 1D cosine sum is
F_T restricted to the line ξ = (t, Vt); so K'_1D <= K'_2D and ratio_1D = |S|/K'_1D² >= |T|/K'_2D².
(Chowla on Z² is equivalent to Chowla on Z by this Freiman map.) R_1D = K'/√(2|T|) (ratio 2 ⟺ R = 1/2).
Measured quantities (advisor):
  (i)   ratio_G (exact on Z_n²);
  (ii)  fractional lift w = Λ(z₁/L)Λ(z₂/L) (PD taper, F_w >= −r exactly when L = n by Poisson): K'_frac, Σw², Σw²/K'²;
  (iii) Boolean: hard box (one representative per class), Bernoulli rounding of the taper, and a jointly optimised T
        (Gurobi MILP: max |T| s.t. F_T >= −Kthr at cut points; lazy cuts at incumbents' true minimisers).
All minima are NUMERICAL (FFT grid + local refinement), not interval-certified.
Usage:
  python src/e116_jl_taper.py measure p a j L [seeds]
  python src/e116_jl_taper.py milp p a j L Kthr timelimit [threads] [full]    (full: all of [−L,L]² as control)
"""
import sys, json, time, math
import numpy as np
from scipy.optimize import minimize

sys.path.insert(0, "src")
from e114_cp_group import jl_set


def lift(D, n, L, full=False):
    pts = []
    for z1 in range(-L, L + 1):
        for z2 in range(-L, L + 1):
            if (z1, z2) == (0, 0):
                continue
            if full or ((z1 % n, z2 % n) in D):
                pts.append((z1, z2))
    pairs = [z for z in pts if (z[0] > 0 or (z[0] == 0 and z[1] > 0))]  # one of each ±z
    return np.array(pairs, dtype=np.int64)


def grid_values(pairs, w, G):
    """F_w on the G×G grid, w per pair (each pair contributes 2w cos)."""
    A = np.zeros((G, G))
    np.add.at(A, (pairs[:, 0] % G, pairs[:, 1] % G), w)
    np.add.at(A, ((-pairs[:, 0]) % G, (-pairs[:, 1]) % G), w)
    return np.fft.fft2(A).real  # Σ w cos(2π z·(i,j)/G) summed over ±z


def Fval(pairs, w, xi):
    ph = 2 * np.pi * (pairs @ xi)
    return 2 * np.dot(w, np.cos(ph)), -2 * 2 * np.pi * (w * np.sin(ph)) @ pairs


def true_min(pairs, w, L, G=None, nstart=12):
    if G is None:
        G = 1 << int(math.ceil(math.log2(16 * (2 * L + 1))))
    V = grid_values(pairs, w, G)
    flat = np.argsort(V, axis=None)[: 4 * nstart]
    best = (V.flat[flat[0]], np.array(np.unravel_index(flat[0], V.shape)) / G)
    seen = []
    for idx in flat:
        x0 = np.array(np.unravel_index(idx, V.shape), dtype=float) / G
        if any(np.max(np.abs(((x0 - s + 0.5) % 1) - 0.5)) < 2.0 / G for s in seen):
            continue
        seen.append(x0)
        r = minimize(lambda x: Fval(pairs, w, x), x0, jac=True, method="BFGS", options={"gtol": 1e-10})
        if r.fun < best[0]:
            best = (r.fun, r.x % 1)
        if len(seen) >= nstart:
            break
    return float(best[0]), best[1], V, G


def finite_K(D, n):
    A = np.zeros((n, n))
    for (x, y) in D:
        A[x, y] = 1
    F = np.fft.fft2(A).real
    F[0, 0] = np.inf
    return float(-F.min())


def measure(p, a, j, L, seeds=5):
    D, n = jl_set(p, a, j)
    r = finite_K(D, n)
    out = {"p": p, "a": a, "j": j, "n": n, "L": L, "D": len(D), "K_G": r, "ratio_G": len(D) / r ** 2}
    pairs = lift(D, n, L)
    lam = (1 - np.abs(pairs[:, 0]) / L).clip(0) * (1 - np.abs(pairs[:, 1]) / L).clip(0)
    # (ii) fractional PD taper
    Kf = -true_min(pairs, lam, L)[0]
    s2 = 2 * float((lam ** 2).sum())
    out.update({"lift_points": 2 * len(pairs), "K_frac": Kf, "sumw2_frac": s2, "ratio_frac": s2 / Kf ** 2,
                "sumw_frac": 2 * float(lam.sum())})
    # (iii-a) hard box: centred representative of each class
    h = n // 2
    box = ((np.abs(pairs[:, 0]) <= h) & (np.abs(pairs[:, 1]) <= h)).astype(float)
    Kb = -true_min(pairs, box, L)[0]
    out.update({"box_size": 2 * int(box.sum()), "K_box": Kb, "ratio_box": 2 * box.sum() / Kb ** 2})
    # (iii-b) Bernoulli rounding of the taper
    rs = []
    for s in range(seeds):
        rng = np.random.default_rng(s)
        b = (rng.random(len(pairs)) < lam).astype(float)
        Kr = -true_min(pairs, b, L)[0]
        rs.append((2 * int(b.sum()), Kr, 2 * b.sum() / Kr ** 2))
    out["bernoulli"] = rs
    return out


def milp(p, a, j, L, Kthr, tl, threads=8, full=False):
    import gurobipy as gp
    from gurobipy import GRB
    D, n = jl_set(p, a, j)
    pairs = lift(D, n, L, full=full)
    P = len(pairs)
    m = gp.Model()
    m.Params.OutputFlag = 0
    m.Params.TimeLimit = tl
    m.Params.Threads = threads
    m.Params.LazyConstraints = 1
    m.Params.IntFeasTol = 1e-9
    m.Params.FeasibilityTol = 1e-8
    x = m.addVars(P, vtype=GRB.BINARY)
    # initial cuts: grid of spacing 1/(2L+1) on the half torus
    g = 2 * L + 1
    cuts = [(i / g, k / g) for i in range(g) for k in range(g) if (i, k) != (0, 0) and (i, k) <= ((-i) % g, (-k) % g)]
    def addcut(xi, lazy=None):
        c = 2 * np.cos(2 * np.pi * (pairs @ np.array(xi)))
        expr = gp.quicksum(float(c[t]) * x[t] for t in range(P))
        if lazy is None:
            m.addConstr(expr >= -Kthr)
        else:
            lazy.cbLazy(expr >= -Kthr)
    for xi in cuts:
        addcut(xi)
    m.setObjective(gp.quicksum(x[t] for t in range(P)), GRB.MAXIMIZE)
    stats = {"lazy": 0, "inc": []}
    t0 = time.time()

    def cb(model, where):
        if where == GRB.Callback.MIPSOL:
            v = np.array(model.cbGetSolution([x[t] for t in range(P)]))
            w = (v > 0.5).astype(float)
            fmin, xi, V, G = true_min(pairs, w, L, nstart=6)
            if fmin < -Kthr - 1e-7:
                addcut(tuple(xi), model)
                stats["lazy"] += 1
                # also the worst grid local minima
                flat = np.argsort(V, axis=None)[:5]
                for idx in flat:
                    if V.flat[idx] < -Kthr - 1e-7:
                        addcut(tuple(np.array(np.unravel_index(idx, V.shape)) / G), model)
                        stats["lazy"] += 1
            else:
                stats["inc"].append((round(time.time() - t0, 1), 2 * int(w.sum()), round(-fmin, 6)))

    m.optimize(cb)
    out = {"p": p, "a": a, "j": j, "n": n, "L": L, "full": full, "Kthr": Kthr, "pairs": P, "status": m.Status,
           "seconds": round(time.time() - t0, 1), "bound_T": 2 * m.ObjBound if m.SolCount or True else None,
           "lazy": stats["lazy"], "incumbents": stats["inc"][-5:]}
    if m.SolCount:
        w = np.array([x[t].X > 0.5 for t in range(P)], dtype=float)
        fmin, xi, _, _ = true_min(pairs, w, L, G=1 << int(math.ceil(math.log2(32 * (2 * L + 1)))), nstart=20)
        T = int(2 * w.sum())
        out.update({"T": T, "K_true": -fmin, "ratio": T / fmin ** 2, "R1D_upper": -fmin / math.sqrt(2 * T),
                    "ratio_bound_at_Kthr": out["bound_T"] / Kthr ** 2,
                    "T_pairs": pairs[w > 0.5].tolist()})
    return out


if __name__ == "__main__":
    cmd = sys.argv[1]
    if cmd == "measure":
        p, a, j, L = (int(t) for t in sys.argv[2:6])
        seeds = int(sys.argv[6]) if len(sys.argv) > 6 else 5
        print(json.dumps(measure(p, a, j, L, seeds)), flush=True)
    elif cmd == "milp":
        p, a, j, L = (int(t) for t in sys.argv[2:6])
        Kthr, tl = float(sys.argv[6]), float(sys.argv[7])
        th = int(sys.argv[8]) if len(sys.argv) > 8 else 8
        full = len(sys.argv) > 9 and sys.argv[9] == "full"
        print(json.dumps(milp(p, a, j, L, Kthr, tl, th, full)), flush=True)
r"""E117 (lead, cont. 31): centroid-lemma inputs for Jedwab–Li sets D ⊂ Z_n².
lambda_odd = top eigenvalue of the concentration operator f ↦ 1_D·P_{N}(f) on ODD real functions on D, where
N = Z_n² ∖ B, B = {χ : D̂(χ) <= −r'} (r' = K_G: the background). φ_B(z) <= lambda_odd for EVERY lift z (each
coordinate of the centroid field is an odd function on D). Also reports φ_B for the canonical (centred) lift and
for lifts read from a jsonl (fd 'reps').
Usage: python src/e117_concentration.py p a j [jsonl idx ...]
"""
import sys, json, math
import numpy as np
sys.path.insert(0, "src")
from e114_cp_group import jl_set

p, a, j = (int(t) for t in sys.argv[1:4])
D, n = jl_set(p, a, j)
Dl = sorted(D)
A = np.zeros((n, n)); 
for (x, y) in Dl: A[x, y] = 1
Dh = np.fft.fft2(A).real
r = -Dh[np.unravel_index(np.argmin(np.where(np.arange(n*n).reshape(n,n)==0, np.inf, Dh)), Dh.shape)]
B = np.isclose(Dh, -r); B[0, 0] = False
N = ~B  # includes 0 and the spikes
chis = np.argwhere(N)
G = np.array(Dl)
# odd basis: one g per ±pair
idx = {g: i for i, g in enumerate(Dl)}
half = [g for g in Dl if g < ((-g[0]) % n, (-g[1]) % n)]
# C[g,g'] = (1/n²) Σ_{χ∈N} cos(2π χ·(g−g')/n); on odd functions (e_g − e_{−g}) the restricted matrix is
# Codd[g,h] = C[g,h] − C[g,−h]  (for g,h in 'half')
Hh = np.array(half)
cN = np.fft.fft2(N.astype(float)).real / n ** 2   # c(h) = (1/n²) Σ_{χ∈N} cos(2π χ·h/n)  (N = −N)
def Cmat(X, Y):
    d = (X[:, None, :] - Y[None, :, :]) % n
    return cN[d[..., 0], d[..., 1]]
Codd = Cmat(Hh, Hh) - Cmat(Hh, (-Hh) % n)
ev = np.linalg.eigvalsh(Codd)
out = {"p": p, "a": a, "j": j, "n": n, "D": len(D), "r": float(r), "N_size": int(N.sum()), "N_frac": float(N.mean()),
       "lambda_odd_top": float(ev[-1]), "lambda_odd_top5": [float(v) for v in ev[-5:]],
       "trace_frac": float(ev.sum() / len(ev))}
def phi(Z):
    # centroid field z (one rep per class) -> fraction of Σ|W|² outside B
    W = np.zeros((n, n, 2))
    for g, z in Z.items():
        ph = 2 * np.pi * (np.arange(n)[:, None] * g[0] + np.arange(n)[None, :] * g[1]) / n
        W += np.sin(ph)[..., None] * np.array(z, dtype=float)[None, None, :]
    tot = (W ** 2).sum(); return float((W[N] ** 2).sum() / tot), float(tot)
cen = {g: (((g[0] + n // 2) % n) - n // 2, ((g[1] + n // 2) % n) - n // 2) for g in Dl}
out["phi_centred"], out["W2_centred"] = phi(cen)
for spec in sys.argv[4:]:
    f, i = spec.rsplit(":", 1)
    d = json.loads(open(f).read().splitlines()[int(i)])
    Z = {}
    for z in d["reps"]:
        g = (z[0] % n, z[1] % n); Z[g] = tuple(z); Z[((-g[0]) % n, (-g[1]) % n)] = (-z[0], -z[1])
    out["phi_" + spec] = phi(Z)
print(json.dumps(out), flush=True)
"""E114: flat completely-positive certificate cost for symmetric D in G = Z_m^2 (lead, cont. 30).
Is the Jedwab–Li non-subgroup LS PDS (CSTAR A9) CP-efficient? Flat CP: cliques B ∋ 0 of Cay(G, D) (B ⊂ D ∪ {0},
B − B ⊂ D ∪ {0}), weights w >= 0, Σ_B w_B m_B(h) = 1_D(h) (h ≠ 0, unordered ±pairs), cost C = Σ_B w_B |B|.
Then Σ w_B |F_B(χ)|² = C + D̂(χ), so K <= C. Column generation: Gurobi LP master + exact Gurobi MILP pricing
(max Σ_{pairs} y − |B| over cliques containing 0). Output: K, ratio |D|/K², clique number, C_flat (UB; LB = LP dual
when the final pricing is optimal), and the block structure. Numerical LP (Gurobi tolerances).
Usage: python src/e114_cp_group.py p a j [tlim]
"""
import sys, json, cmath, math, itertools
import gurobipy as gp

def jl_set(p, a, j):
    m = p ** a; D = set()
    for x in range(m):
        for y in range(1, m):
            k = 0; yy = y
            while yy % p == 0: yy //= p; k += 1
            b = a - k; mb = p ** b; z = (y // p ** k) % mb
            v = ((x % mb) * pow(z, -1, mb)) % mb
            if j * p ** (b - 1) <= v < (j + 1) * p ** (b - 1): D.add((x, y))
    return D, m

def main():
    p, a, j = (int(t) for t in sys.argv[1:4]); tlim = float(sys.argv[4]) if len(sys.argv) > 4 else 600
    D, m = jl_set(p, a, j)
    assert all(((-x) % m, (-y) % m) in D for x, y in D) and (0, 0) not in D
    sub = lambda u, v: ((u[0] - v[0]) % m, (u[1] - v[1]) % m)
    key = lambda h: min(h, ((-h[0]) % m, (-h[1]) % m))
    vals = []
    for u in range(m):
        for v in range(m):
            if (u, v) == (0, 0): continue
            vals.append(sum(math.cos(2 * math.pi * (u * x + v * y) / m) for x, y in D))
    K = -min(vals); lags = sorted({key(h) for h in D}); V = sorted(D)
    # pricing graph on V (0 is forced into B)
    adj = {(s, t) for s in range(len(V)) for t in range(s + 1, len(V)) if sub(V[t], V[s]) in D}
    def m_of(B):
        cnt = {}
        for s in range(len(B)):
            for t in range(s + 1, len(B)):
                h = key(sub(B[t], B[s])); cnt[h] = cnt.get(h, 0) + 1
        return cnt
    cols = [[(0, 0), h] for h in lags]
    pr = gp.Model(); pr.Params.OutputFlag = 0; pr.Params.TimeLimit = tlim
    x = pr.addVars(len(V), vtype=gp.GRB.BINARY)
    z = {}
    for s in range(len(V)):
        for t in range(s + 1, len(V)):
            if (s, t) in adj:
                z[s, t] = pr.addVar(lb=0, ub=1); pr.addConstr(z[s, t] <= x[s]); pr.addConstr(z[s, t] <= x[t])
                pr.addConstr(z[s, t] >= x[s] + x[t] - 1)
            else:
                pr.addConstr(x[s] + x[t] <= 1)
    pr.update()
    # clique number (cliques containing 0): maximise Σ x
    pr.setObjective(gp.quicksum(x[s] for s in range(len(V))), gp.GRB.MAXIMIZE); pr.optimize()
    omega = int(round(pr.ObjVal)) + 1; omega_status = pr.Status
    it = 0
    while True:
        it += 1
        mst = gp.Model(); mst.Params.OutputFlag = 0
        w = [mst.addVar(lb=0) for _ in cols]; mc = [m_of(B) for B in cols]
        cons = {h: mst.addConstr(gp.quicksum(w[i] * mc[i].get(h, 0) for i in range(len(cols))) == 1) for h in lags}
        mst.setObjective(gp.quicksum(w[i] * len(B) for i, B in enumerate(cols)), gp.GRB.MINIMIZE); mst.optimize()
        C = mst.ObjVal; y = {h: cons[h].Pi for h in lags}
        obj = gp.quicksum(y[key(V[s])] * x[s] for s in range(len(V))) - gp.quicksum(x[s] for s in range(len(V)))
        obj += gp.quicksum(y[key(sub(V[t], V[s]))] * z[s, t] for (s, t) in z)
        pr.setObjective(obj, gp.GRB.MAXIMIZE); pr.optimize()
        red = pr.ObjVal - 1   # the element 0 itself costs 1
        status = "opt" if pr.Status == 2 else "timelimit"
        print(json.dumps(dict(it=it, C=C, reduced=red, status=status, ncols=len(cols))), flush=True)
        if red <= 1e-7: break
        B = [(0, 0)] + [V[s] for s in range(len(V)) if x[s].X > 0.5]
        if B in cols: status = "stalled"; break
        cols.append(B)
    used = [(w[i].X, len(B)) for i, B in enumerate(cols) if w[i].X > 1e-9]
    sizes = {}
    for wt, sz in used: sizes[sz] = sizes.get(sz, 0) + wt
    out = dict(p=p, a=a, j=j, m=m, size=len(D), K=K, ratio=len(D) / K ** 2, omega=omega, omega_status=omega_status,
               delsarte=1 + len(D) / K, C_flat=C, eff=C / K, final_pricing=status, weight_by_block_size=sizes)
    print(json.dumps(out), flush=True)
    json.dump(out, open(f"examples/e114/jl_p{p}a{a}j{j}.json", "w"))

if __name__ == "__main__":
    main()
# Discriminating experiments for number theory

Design an experiment to **separate hypotheses**, not to produce a large integer count.

## Before execution

State (a) exact identity or predicate; (b) finite parameter ranges, exclusions and sampling policy; (c) what outcome would refute the candidate lemma; (d) what each possible result *would and would not* imply; (e) expected runtime/memory budget and stop conditions.

## During execution

- Use exact integer/rational arithmetic wherever possible, not floating square tests or approximate divisibility.
- For a square, test integer-square-root equality, not a floating `sqrt` comparison. For prime p, distinguish probable from proved primality when proof status matters.
- For elliptic curves, record model, transformations, denominators, ranks and reduction primes. Don't infer global relations from numerically sampled reductions.
- Separate preliminary heuristics from verified claims. Try counterexample-shaped extremes as well as uniform samples: prime powers, ramified primes, large gcd, maximal valuations, singular discriminants, high conductor, parameter boundary.
- Save a script (Sage/GP/Python), inputs, software version, outputs, and the exact domain excluded. If an independent computation is affordable, compare.

## After execution

A negative bounded search only excludes the enumerated set. Ask: What pattern appeared? What explanation predicts it? What counterexample-shaped case should be tested next? Can a found invariant be turned into a provable lemma? If no new information, kill or transform the experiment; do not expand the same box by another arbitrary factor of ten.

## Minimum artifact

The user should be able to reconstruct the computation from the reported script, explicit bounds and predicate. For hand algebra, record the identity and its derivation sufficiently for an independent reviewer to check it.
# Number theory attack-selection guide

Use this to select **testable new mathematical mechanisms**, not as a list of topics to name-drop. Each approach below must be reduced to a lemma or a concrete experiment in the current problem.

## Diophantine and integral points

- **Local obstructions:** derive congruence classes modulo prime powers (including wild primes and parameters with large valuations), then determine whether the obstruction is sufficient for the global conclusion. Passing every tested modulus is not a Hasse principle.
- **Parametrization/inverse construction:** solve the equations for one parameter to produce a structured infinite family; impose integrality, positivity, coprimality, or square conditions exactly. Check whether multiple constructions coexist at the *same* parameter values, rather than separately.
- **Height and descent:** identify a well-founded height that *strictly decreases* under the proposed map; prove integrality/positivity persists. A decreasing rational height alone does not prove integral descent.
- **Linear forms/Thue/Mordell:** translate to a named equation carefully; verify effective vs ineffective bounds, constants, dependence on parameters, and whether the theorem is uniform across a family.
- **Curve genus:** computing genus or invoking Faltings's finiteness does not give a uniform numerical bound across all parameter triples. Convert finiteness to a task-specific explicit statement only when justified.

## Elliptic curves and arithmetic geometry

- **Model discipline:** record Weierstrass equation, discriminant, bad primes, minimal model, and birational transformations with denominators. Check what happens to integral points under each map.
- **Group structure:** separate E(Q), integral points, torsion subgroup, rank, isogeny class, saturation, and Mordell–Weil lattice. Rational points P±Q need not be integral.
- **Independence/support:** when seeking a local-order implication for almost all good primes, audit quantifiers carefully. A theorem for a fixed point, fixed n, special subsequence, or finite exceptional set does not automatically prove a uniform support implication. Don't assume a relation in a theorem whose purpose is to establish that relation.
- **Reduction arguments:** specify good primes, reduction map, ℓ-primary components, and conditions for lifting global conclusions. A point's order modulo p is not determined by only checking a few small p.
- **Heights and pairings:** write the actual inequality/pairing expression needed; explain whether the constants are effective and uniform in the varying family.
- **Non-regular vs regular loci:** identify equations defining special loci and prove they cover what you claim; don't smuggle special-case dependence into the non-regular case.

## Algebraic and analytic number theory

- **Valuations/ideal factorization:** inspect ramification, units, class group obstruction, S-units, and local-to-global failures. Equality of norms alone rarely yields equality of elements.
- **Sieve/exponential sums:** state the required uniformity, distribution level, exceptional moduli, dependence on parameters, and parity/major-minor arc barriers. A heuristic density argument is not a proof of existence.
- **L-functions/modularity:** distinguish algebraic vs analytic rank and conjectural input. Verify conductor, root number, and exact curve label before transferring published conclusions.

## Choosing a next move from a failed proof

| Failure observed | Mathematical follow-up |
|---|---|
| Congruences don't exclude | Search for high valuation/ramified witnesses; ask if a global obstruction is required; construct locally soluble non-global examples. |
| Brute force finds no solutions | Derive shape of a hypothetical solution; use modular filters then constrained constructive search; explicitly delimit the negative bound. |
| Integrality fails after group operation | Calculate exact denominators; characterize when they vanish or divide; try a different model or invariant, or prove impossibility of the integrality propagation route. |
| Need point dependence to use theorem | Identify exact missing implication; seek reduction-order evidence or a theorem with assumptions that are independently verifiable; try constructing an independent pair that falsifies naive versions. |
| All examples show one mechanism | Check whether mechanism is necessary or merely common; construct a counterexample to necessity; reverse-engineer simultaneous mechanisms on the same parameters. |
| A theorem only gives finiteness | Ask for an effective bound under stronger hypotheses, or a single explicit family satisfying the target; don't claim it settles a uniform counting question. |

## Source discipline

Consult original papers, mathematical databases (e.g. LMFDB), and code where available. Record precise proposition numbers, mathematical hypotheses, and what *exactly* was inferred. A preprint, database entry, and a proof of a global theorem have different epistemic weight.

Suggested complementary reading: K-Dense AI's MIT-licensed `number-theorist` skill at https://github.com/K-Dense-AI/scientific-agents/blob/main/scientific-agents/number-theorist/skills/number-theorist/SKILL.md . It surveys tools and field-specific checks; the present skill adds a research continuation and strategy loop. Verify worked examples and factual claims in any external skill independently.

