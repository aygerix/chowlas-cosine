            else:
                send('textDocument/didChange', {'textDocument':{'uri':uri,'version':version},
                                              'contentChanges':[{'text':text}]})
            previous = text
            print('Submitted version ' + str(version), flush=True)
        time.sleep(1)
finally:
    proc.terminate()
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        proc.kill()
