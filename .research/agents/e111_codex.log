+def run_search(args):
+    summaries = []
+    trace = (OUT/"search_trace.jsonl").open("w")
+    for X in args.X:
+        seed = 20261019+1009*X
+        rng = random.Random(seed)
+        start = time.monotonic()
+        best, evaluated, accepted = None, 0, 0
+        move_counts = Counter()
+        cache = {}
+        for restart in range(args.restarts):
+            A = initial_search_set(X,rng,restart)
+            current = None
