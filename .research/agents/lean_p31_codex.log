import Mathlib

/-!
# Basic definitions for Chowla's cosine problem

Convention (fixed throughout the project): for a finite set `A` of natural numbers,

  `f_A(x) = ∑_{a ∈ A} cos (a * x)`,   `x : ℝ`.

Positivity of the frequencies is *not* built into the definition; it is stated as an
explicit hypothesis `∀ a ∈ A, 0 < a` wherever it is needed.

This file also contains the elementary orthogonality integrals over `[0, 2π]` used by
the mean-zero / Parseval identities and by the intersection lemma.
-/

open Real

namespace ChowlaCosine

/-- `cosSum A x = f_A(x) = ∑_{a ∈ A} cos (a * x)`. -/
noncomputable def cosSum (A : Finset ℕ) (x : ℝ) : ℝ := ∑ a ∈ A, Real.cos ((a : ℝ) * x)

theorem continuous_cosSum (A : Finset ℕ) : Continuous (cosSum A) := by
  unfold cosSum
  fun_prop

/-- `∫_0^{2π} cos (k x) dx = 0` for a nonzero integer `k`. -/
theorem integral_cos_int_mul {k : ℤ} (hk : k ≠ 0) :
    ∫ x in (0 : ℝ)..2 * π, Real.cos ((k : ℝ) * x) = 0 := by
  have hk' : (k : ℝ) ≠ 0 := by exact_mod_cast hk
  rw [intervalIntegral.integral_comp_mul_left (fun x => Real.cos x) hk', integral_cos]
  have h : Real.sin ((k : ℝ) * (2 * π)) = 0 := by
    have := Real.sin_int_mul_pi (2 * k)
    rw [← this]
    congr 1
    push_cast
    ring
  simp [h]

/-- `∫_0^{2π} sin (k x) dx = 0` for every integer `k`. -/
theorem integral_sin_int_mul (k : ℤ) :
    ∫ x in (0 : ℝ)..2 * π, Real.sin ((k : ℝ) * x) = 0 := by
  by_cases hk : k = 0
  · subst hk
    simp
  have hk' : (k : ℝ) ≠ 0 := by exact_mod_cast hk
  rw [intervalIntegral.integral_comp_mul_left (fun x => Real.sin x) hk', integral_sin]
  have h : Real.cos ((k : ℝ) * (2 * π)) = 1 := Real.cos_int_mul_two_pi k
  simp [h]

/-- `∫_0^{2π} cos (k y + φ) dy = 2π cos φ` if `k = 0`, and `0` for every other integer `k`. -/
theorem integral_cos_int_mul_add (k : ℤ) (φ : ℝ) :
    ∫ y in (0 : ℝ)..2 * π, Real.cos ((k : ℝ) * y + φ) =
      if k = 0 then 2 * π * Real.cos φ else 0 := by
  split_ifs with hk
  · subst hk
    simp
  · simp_rw [Real.cos_add]
    rw [intervalIntegral.integral_sub, intervalIntegral.integral_mul_const,
      intervalIntegral.integral_mul_const, integral_cos_int_mul hk, integral_sin_int_mul k]
    · ring
    · exact (by fun_prop : Continuous fun y => Real.cos ((k : ℝ) * y) * Real.cos φ).intervalIntegrable _ _
    · exact (by fun_prop : Continuous fun y => Real.sin ((k : ℝ) * y) * Real.sin φ).intervalIntegrable _ _

/-- Product-to-sum orthogonality over a full period, with integer frequencies and phases. -/
theorem integral_cos_mul_cos (m n : ℤ) (φ ψ : ℝ) :
    ∫ y in (0 : ℝ)..2 * π, Real.cos ((m : ℝ) * y + φ) * Real.cos ((n : ℝ) * y + ψ) =
      (if m - n = 0 then π * Real.cos (φ - ψ) else 0) +
        (if m + n = 0 then π * Real.cos (φ + ψ) else 0) := by
  have hpt : ∀ y : ℝ, Real.cos ((m : ℝ) * y + φ) * Real.cos ((n : ℝ) * y + ψ) =
      (1 / 2 : ℝ) * Real.cos (((m - n : ℤ) : ℝ) * y + (φ - ψ)) +
        (1 / 2 : ℝ) * Real.cos (((m + n : ℤ) : ℝ) * y + (φ + ψ)) := by
    intro y
    have e1 : ((m - n : ℤ) : ℝ) * y + (φ - ψ) = ((m : ℝ) * y + φ) - ((n : ℝ) * y + ψ) := by
      push_cast; ring
    have e2 : ((m + n : ℤ) : ℝ) * y + (φ + ψ) = ((m : ℝ) * y + φ) + ((n : ℝ) * y + ψ) := by
      push_cast; ring
    rw [e1, e2, Real.cos_sub ((m : ℝ) * y + φ) ((n : ℝ) * y + ψ),
      Real.cos_add ((m : ℝ) * y + φ) ((n : ℝ) * y + ψ)]
    ring
  simp_rw [hpt]
  rw [intervalIntegral.integral_add, intervalIntegral.integral_const_mul,
    intervalIntegral.integral_const_mul, integral_cos_int_mul_add, integral_cos_int_mul_add]
  · split_ifs <;> ring
  · exact (by fun_prop : Continuous fun y : ℝ =>
      (1 / 2 : ℝ) * Real.cos (((m - n : ℤ) : ℝ) * y + (φ - ψ))).intervalIntegrable _ _
  · exact (by fun_prop : Continuous fun y : ℝ =>
      (1 / 2 : ℝ) * Real.cos (((m + n : ℤ) : ℝ) * y + (φ + ψ))).intervalIntegrable _ _

end ChowlaCosine
import ChowlaCosine.Basic

/-!
# Mean zero and Parseval for `f_A`

For a finite `A ⊆ ℕ` with all elements positive:

* `∫_0^{2π} f_A(x) dx = 0`;
* `∫_0^{2π} f_A(x)² dx = π |A|`, i.e. the normalized mean square
  `(1/2π) ∫_0^{2π} f_A² = |A| / 2`.

Distinctness of the frequencies is automatic (`A` is a `Finset`); positivity is required
(for `A = {0}` both identities fail).
-/

open Real

namespace ChowlaCosine

theorem intervalIntegrable_cos_mul (c : ℝ) (a b : ℝ) :
    IntervalIntegrable (fun x => Real.cos (c * x)) MeasureTheory.volume a b :=
  (by fun_prop : Continuous fun x => Real.cos (c * x)).intervalIntegrable _ _

/-- `∫_0^{2π} cos (a x) dx = 0` for a positive natural `a`. -/
theorem integral_cos_nat_mul {a : ℕ} (ha : 0 < a) :
    ∫ x in (0 : ℝ)..2 * π, Real.cos ((a : ℝ) * x) = 0 := by
  have h := integral_cos_int_mul (k := (a : ℤ)) (by exact_mod_cast ha.ne')
  simpa using h

/-- `∫_0^{2π} cos (a x) cos (b x) dx = π [a = b]` for positive naturals `a, b`. -/
theorem integral_cos_mul_cos_nat {a b : ℕ} (ha : 0 < a) (hb : 0 < b) :
    ∫ x in (0 : ℝ)..2 * π, Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x) =
      if a = b then π else 0 := by
  have h := integral_cos_mul_cos (a : ℤ) (b : ℤ) 0 0
  have hab : (a : ℤ) + b ≠ 0 := by omega
  rw [if_neg hab, add_zero] at h
  by_cases h' : a = b
  · have : (a : ℤ) - b = 0 := by omega
    rw [if_pos this] at h
    rw [if_pos h']
    simpa using h
  · have : (a : ℤ) - b ≠ 0 := by omega
    rw [if_neg this] at h
    rw [if_neg h']
    simpa using h

/-- **Mean zero.** `∫_0^{2π} f_A = 0` when every element of `A` is positive. -/
theorem integral_cosSum (A : Finset ℕ) (hA : ∀ a ∈ A, 0 < a) :
    ∫ x in (0 : ℝ)..2 * π, cosSum A x = 0 := by
  unfold cosSum
  rw [intervalIntegral.integral_finsetSum (fun (a : ℕ) _ => intervalIntegrable_cos_mul _ _ _)]
  exact Finset.sum_eq_zero (fun a ha => integral_cos_nat_mul (hA a ha))

/-- **Parseval.** `∫_0^{2π} f_A² = π |A|` when every element of `A` is positive. -/
theorem integral_cosSum_sq (A : Finset ℕ) (hA : ∀ a ∈ A, 0 < a) :
    ∫ x in (0 : ℝ)..2 * π, (cosSum A x) ^ 2 = π * A.card := by
  have hsq : ∀ x, (cosSum A x) ^ 2 =
      ∑ a ∈ A, ∑ b ∈ A, Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x) := by
    intro x
    rw [cosSum, sq, Finset.sum_mul_sum]
  simp_rw [hsq]
  have hint : ∀ a b : ℕ, IntervalIntegrable
      (fun x => Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x)) MeasureTheory.volume 0 (2 * π) :=
    fun a b => (by fun_prop : Continuous fun x =>
      Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x)).intervalIntegrable _ _
  rw [intervalIntegral.integral_finsetSum (fun (a : ℕ) _ =>
    (by fun_prop : Continuous fun x => ∑ b ∈ A,
      Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x)).intervalIntegrable _ _)]
  calc ∑ a ∈ A, ∫ x in (0 : ℝ)..2 * π, ∑ b ∈ A, Real.cos ((a : ℝ) * x) * Real.cos ((b : ℝ) * x)
      = ∑ a ∈ A, ∑ b ∈ A, (if a = b then π else 0) := by
        refine Finset.sum_congr rfl (fun a ha => ?_)
        rw [intervalIntegral.integral_finsetSum (fun b _ => hint a b)]
        exact Finset.sum_congr rfl (fun b hb => integral_cos_mul_cos_nat (hA a ha) (hA b hb))
    _ = ∑ a ∈ A, π := by
        refine Finset.sum_congr rfl (fun a ha => ?_)
        simp [ha]
    _ = π * A.card := by
        rw [Finset.sum_const, nsmul_eq_mul, mul_comm]

/-- Normalized form of Parseval: `(1/2π) ∫_0^{2π} f_A² = |A| / 2`. -/
theorem normalized_mean_sq (A : Finset ℕ) (hA : ∀ a ∈ A, 0 < a) :
    (1 / (2 * π)) * ∫ x in (0 : ℝ)..2 * π, (cosSum A x) ^ 2 = (A.card : ℝ) / 2 := by
  rw [integral_cosSum_sq A hA]
  have := Real.pi_pos.ne'
  field_simp

end ChowlaCosine
