      "message": "@ChowlaCosine.Beckner.tendsto_integral_geometricHeatProduct : ∀ {ι : Type u_1} {E : Type u_2} [inst : Fintype ι]\n  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℝ E] (f : ι → ℝ → ℝ) (c : ι → ℝ) (u : ι → E),\n  (∀ (i : ι), Integrable (f i) volume) →\n    (∀ (i : ι) (y : ℝ), 0 ≤ f i y) →\n      (∀ (i : ι), 0 ≤ c i) →\n        (∀ (i : ι), ‖u i‖ = 1) →\n          ChowlaCosine.Beckner.IsWeightedFrame c u →\n            ∀ (R : ℝ),\n              0 ≤ R →\n                (∀ (i : ι) (y : ℝ), f i y ≠ 0 → |y| ≤ R) →\n                  ∀ (b : OrthonormalBasis (Fin 2) ℝ E),\n                    Filter.Tendsto\n                      (fun t =>\n                        ∫ (z : ℝ × ℝ),\n                          ChowlaCosine.Beckner.geometricHeatProduct f c u t\n                            (ChowlaCosine.Beckner.planePoint b z) ∂volume.prod volume)\n                      Filter.atTop (𝓝 (∏ i, (∫ (y : ℝ), f i y) ^ c i))",
