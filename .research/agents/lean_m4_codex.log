/-- The exact probability-normalized Gaussian product determined by a planar frame. -/
theorem frame_heatKernel_product (c : ι → ℝ) (u : ι → E)
    (hu : ∀ i, ‖u i‖ = 1) (hframe : IsWeightedFrame c u)
    (b : OrthonormalBasis (Fin 2) ℝ E) (x : E) :
