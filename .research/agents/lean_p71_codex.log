  push_cast
  nlinarith

/-- **P71.2 (cardinality corollary):** "'`M ≥ 7|A|/6290 + 1/2`. -/
theorem lower_bound_card {L q P : ℕ} (hL : 20 ∣ L) (hL0 : 20 ≤ L)
    (hP : 100 ≤ P) (hq : 4 * L + 1 ≤ q) (M : ℝ)
    (hM : ∀ x : ℝ, -M ≤ cosSum (taper L q P) x) :
