+            "tolerances":{"FeasibilityTol":1e-9,"OptimalityTol":1e-9,"IntFeasTol":1e-9,
+                          "MIPGap":0,"MIPGapAbs":1e-9,"column_reduced_cost":TOL},
+            "args":vars(args), "source_sha256":hashlib.sha256(Path(__file__).read_bytes()).hexdigest()}
